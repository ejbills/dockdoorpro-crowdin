          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Launch on Login adds DockDoor Pro as a login item. Hiding the native Dock changes Dock preferences and restarts the Dock process, so the desktop may flash briefly."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Автозапуск добавляет DockDoor Pro как элемент входа. Скрытие родного дока изменяет настройки Dock и перезапускает процесс Dock, поэтому рабочий стол может кратко мигнуть."
          }
        },
        "sr" : {
          "stringUnit" : {
