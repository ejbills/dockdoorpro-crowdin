        "da" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Windows of these apps are never resized. Use this for apps that force their own window size and would otherwise be resized repeatedly."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Größe von Fenstern dieser Apps wird nie geändert. Verwenden Sie dies für Apps, die ihre eigene Fenstergröße erzwingen und sonst wiederholt in der Größe geändert würden."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Windows of these apps are never resized. Use this for apps that force their own window size and would otherwise be resized repeatedly."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las ventanas de estas apps nunca se redimensionan. Úsalo para apps que imponen su propio tamaño de ventana y que, de lo contrario, se redimensionarían una y otra vez."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Windows of these apps are never resized. Use this for apps that force their own window size and would otherwise be resized repeatedly."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les fenêtres de ces apps ne sont jamais redimensionnées. Utilisez cette option pour les apps qui imposent leur propre taille de fenêtre et seraient sinon redimensionnées en boucle."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Windows of these apps are never resized. Use this for apps that force their own window size and would otherwise be resized repeatedly."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ezeknek az appoknak az ablakai soha nem lesznek átméretezve. Olyan appokhoz használja, amelyek saját ablakméretet kényszerítenek ki, és különben ismételten átméreteződnének."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Windows of these apps are never resized. Use this for apps that force their own window size and would otherwise be resized repeatedly."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これらのアプリのウインドウはサイズ変更されません。独自のウインドウサイズを強制し、そのままでは繰り返しサイズ変更されてしまうアプリに使用してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Windows of these apps are never resized. Use this for apps that force their own window size and would otherwise be resized repeatedly."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Windows of these apps are never resized. Use this for apps that force their own window size and would otherwise be resized repeatedly."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het formaat van vensters van deze apps wordt nooit aangepast. Gebruik dit voor apps die hun eigen venstergrootte afdwingen en anders steeds opnieuw van formaat zouden veranderen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rozmiar okien tych aplikacji nigdy nie jest zmieniany. Użyj tej opcji dla aplikacji, które wymuszają własny rozmiar okna i w przeciwnym razie byłyby wielokrotnie dopasowywane."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As janelas destas apps nunca são redimensionadas. Use isto para apps que impõem o seu próprio tamanho de janela e que, de outra forma, seriam redimensionadas repetidamente."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Windows of these apps are never resized. Use this for apps that force their own window size and would otherwise be resized repeatedly."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Windows of these apps are never resized. Use this for apps that force their own window size and would otherwise be resized repeatedly."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Размер окон этих приложений никогда не изменяется. Используйте это для приложений, которые задают собственный размер окна и иначе изменялись бы снова и снова."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Windows of these apps are never resized. Use this for apps that force their own window size and would otherwise be resized repeatedly."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fönster i de här apparna ändrar aldrig storlek. Använd detta för appar som tvingar fram sin egen fönsterstorlek och annars skulle ändra storlek upprepade gånger."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu uygulamaların pencereleri asla yeniden boyutlandırılmaz. Kendi pencere boyutunu zorlayan ve aksi halde tekrar tekrar yeniden boyutlandırılacak uygulamalar için bunu kullan."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Windows of these apps are never resized. Use this for apps that force their own window size and would otherwise be resized repeatedly."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cửa sổ của các ứng dụng này không bao giờ bị đổi kích thước. Dùng tùy chọn này cho các ứng dụng tự áp đặt kích thước cửa sổ, vốn sẽ bị đổi kích thước liên tục nếu không được loại trừ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这些应用的窗口不会被调整大小。适用于强制设定自身窗口大小的应用，以避免窗口大小被反复调整。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這些應用程式的視窗永遠不會被調整大小。請針對那些會強制設定自身視窗大小，且若不這樣做就會被反覆調整大小的應用程式使用此選項。"
          }
        }
      }
    },
