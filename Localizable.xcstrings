          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bắt đầu với kiểu nổi hoặc thanh tác vụ, sau đó tiếp tục qua phần Giao diện để chỉnh kích cỡ, bộ chỉ báo và nền."
          }
        },
        "zh-Hans" : {
