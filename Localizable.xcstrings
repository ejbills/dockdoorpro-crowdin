            "value" : "Widget stacks appear on either side of your app icons. Up to 3 stacks per side. Each stack can hold multiple widgets, scroll to page between them."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Widget stacks appear on either side of your app icons. Up to 3 stacks per side. Each stack can hold multiple widgets, scroll to page between them."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Виджеты появляются с обеих сторон значков приложений. До 3 стеков на одной стороне. Каждый стек может держать несколько виджетов, прокручивать страницу между ними."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Widget stacks appear on either side of your app icons. Up to 3 stacks per side. Each stack can hold multiple widgets, scroll to page between them."
          }
