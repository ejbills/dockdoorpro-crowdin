    "Card mode shows a background behind running apps. Focused apps are highlighted, while hidden or minimized apps appear dimmed." : {
      "extractionState" : "stale",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Card mode shows a background behind running apps. Focused apps are highlighted, while hidden or minimized apps appear dimmed."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يظهر وضع البطاقة خلفية خلف تشغيل التطبيقات. يتم تسليط الضوء على التطبيقات المركزة في حين تظهر التطبيقات المخفية أو المصغرة بشكل غير ثابت."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Card mode shows a background behind running apps. Focused apps are highlighted, while hidden or minimized apps appear dimmed."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Card mode shows a background behind running apps. Focused apps are highlighted, while hidden or minimized apps appear dimmed."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Card mode shows a background behind running apps. Focused apps are highlighted, while hidden or minimized apps appear dimmed."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kartenmodus zeigt einen Hintergrund hinter laufenden Apps. Fokussierte Apps werden hervorgehoben, während versteckte oder minimierte Apps verdunkelt werden."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Card mode shows a background behind running apps. Focused apps are highlighted, while hidden or minimized apps appear dimmed."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Card mode shows a background behind running apps. Focused apps are highlighted, while hidden or minimized apps appear dimmed."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Card mode shows a background behind running apps. Focused apps are highlighted, while hidden or minimized apps appear dimmed."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le mode Carte affiche un fond derrière les apps actives. \nLes apps au premier plan sont mises en évidence, tandis que les apps masquées ou réduites apparaissent atténuées."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Card mode shows a background behind running apps. Focused apps are highlighted, while hidden or minimized apps appear dimmed."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Kártya mód hátteret jelenít meg a futó alkalmazások mögött. A fókuszban lévő alkalmazások ki vannak emelve, míg a rejtett vagy minimalizált alkalmazások elhalványítva jelennek meg."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Card mode shows a background behind running apps. Focused apps are highlighted, while hidden or minimized apps appear dimmed."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Card mode shows a background behind running apps. Focused apps are highlighted, while hidden or minimized apps appear dimmed."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Card mode shows a background behind running apps. Focused apps are highlighted, while hidden or minimized apps appear dimmed."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Card mode shows a background behind running apps. Focused apps are highlighted, while hidden or minimized apps appear dimmed."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaartmodus toont een achtergrond achter geopende apps. Geopende apps worden gemarkeerd, terwijl verborgen of geminimaliseerde apps gedimd worden weergegeven."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tryb kart pokazuje tło za uruchomionymi aplikacjami. Aktywne aplikacje są wyróżnione, a ukryte lub zminimalizowane są przyciemnione."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Card mode shows a background behind running apps. Focused apps are highlighted, while hidden or minimized apps appear dimmed."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Card mode shows a background behind running apps. Focused apps are highlighted, while hidden or minimized apps appear dimmed."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Card mode shows a background behind running apps. Focused apps are highlighted, while hidden or minimized apps appear dimmed."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Режим карты показывает фон за запущенными приложениями. Фокусированные приложения выделяются, в то время как скрытые или свернутые приложения отображаются затемненными."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Card mode shows a background behind running apps. Focused apps are highlighted, while hidden or minimized apps appear dimmed."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Card mode shows a background behind running apps. Focused apps are highlighted, while hidden or minimized apps appear dimmed."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kart modu, çalışan uygulamaların arkasında bir arka plan gösterir. Odaktaki uygulamalar vurgulanır, gizli veya simge durumuna küçültülmüş uygulamalar ise soluk görünür."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Card mode shows a background behind running apps. Focused apps are highlighted, while hidden or minimized apps appear dimmed."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chế độ thẻ hiển thị một nền phía sau các ứng dụng đang chạy. Ứng dụng đang được chọn sẽ được làm nổi bật, còn các ứng dụng bị ẩn hoặc thu nhỏ sẽ hiển thị mờ hơn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "卡片模式在运行中的应用背后显示背景。当前聚焦的应用会被高亮显示，而隐藏或最小化的应用则显示为变暗状态。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "卡片模式會在執行中的應用程式後方顯示背景。取得焦點的應用程式會被醒目標示，而已隱藏或最小化的應用程式則會以較暗的方式顯示。"
          }
        }
      }
    },
