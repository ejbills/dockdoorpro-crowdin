    "Native Dock keeps app icons central with Trash after apps. Minimal Dock hides widget stacks but keeps hover previews and running-app cleanup." : {
      "comment" : "Dock anatomy preset note",
      "extractionState" : "manual",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Native Dock keeps app icons central with Trash after apps. Minimal Dock hides widget stacks but keeps hover previews and running-app cleanup."
          }
        },
        "ar" : {
