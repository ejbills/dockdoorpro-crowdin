        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appuyez sur votre raccourci Édition du dock pour modifier le dock. Glissez des apps, dossiers, fichiers, URLs ou apps en cours sur le dock pour les épingler au profil actif. En mode édition, maintenez appuyé une icône épinglée pour la réorganiser, puis cliquez sur la coche une fois terminé."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Press your Edit Dock shortcut to edit the dock. Drag apps, folders, files, URLs, or running apps onto the dock to pin them to the active profile. In edit mode, long-press a pinned icon to reorder it, then click the checkmark when finished."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nyomd meg a Dock szerkesztése billentyűparancsot a Dock módosításához. Húzz alkalmazásokat, mappákat, fájlokat, URL-eket vagy futó alkalmazásokat a Dockra, hogy kitűzd őket az aktív profilhoz. Szerkesztési módban nyomd hosszan egy kitűzött ikonra az átrendezéshez, majd a befejezés után kattints a pipára."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Press your Edit Dock shortcut to edit the dock. Drag apps, folders, files, URLs, or running apps onto the dock to pin them to the active profile. In edit mode, long-press a pinned icon to reorder it, then click the checkmark when finished."
          }
        },
