          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kartengröße, Deckkraft, Umriss, Schimmer und App-Farbton hinter den Symbolen laufender Apps."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "new",
