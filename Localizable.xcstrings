        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A panel görgetéskor egy választót jelenít meg a dock fölött. A beágyazott mód közvetlenül a dockban módosítja a profilikont."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "new",
