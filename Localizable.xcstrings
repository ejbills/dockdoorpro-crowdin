    "This display uses its own anchor offset. Reset to follow the global value again." : {
      "comment" : "Per-display anchor offset override description",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "This display uses its own anchor offset. Reset to follow the global value again."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تستخدم هذه الشاشة إزاحة ارتكاز خاصة بها. أعد التعيين لاتباع القيمة العامة مجددًا."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "new",
