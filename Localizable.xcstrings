    "App that receives files sent from the AirDrop zone and menus. Choose another app to use a transfer service such as Blip or LocalSend." : {
      "comment" : "Settings control description",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "App that receives files sent from the AirDrop zone and menus. Choose another app to use a transfer service such as Blip or LocalSend."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "التطبيق الذي يستقبل الملفات المرسلة من منطقة AirDrop والقوائم. اختر تطبيقًا آخر لاستخدام خدمة نقل مثل Blip أو LocalSend."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "App that receives files sent from the AirDrop zone and menus. Choose another app to use a transfer service such as Blip or LocalSend."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "App that receives files sent from the AirDrop zone and menus. Choose another app to use a transfer service such as Blip or LocalSend."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "new",
