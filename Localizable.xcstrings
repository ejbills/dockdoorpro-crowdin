    "This is an edge divider. Items beyond it are pinned to the dock edge; everything between the dividers stays centered. Edges only separate visually in the taskbar dock style." : {
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "This is an edge divider. Items beyond it are pinned to the dock edge; everything between the dividers stays centered. Edges only separate visually in the taskbar dock style."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هذا فاصل حافة. العناصر التي تليه تُثبّت عند حافة Dock؛ وكل ما يقع بين الفاصلين يبقى في المنتصف. لا تنفصل الحواف بصريًا إلا في نمط شريط المهام."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "This is an edge divider. Items beyond it are pinned to the dock edge; everything between the dividers stays centered. Edges only separate visually in the taskbar dock style."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "This is an edge divider. Items beyond it are pinned to the dock edge; everything between the dividers stays centered. Edges only separate visually in the taskbar dock style."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "This is an edge divider. Items beyond it are pinned to the dock edge; everything between the dividers stays centered. Edges only separate visually in the taskbar dock style."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dies ist ein Kantentrenner. Elemente jenseits dieses Trenners werden an der Dock-Kante angeheftet; alles zwischen den Trennern bleibt zentriert. Die Kanten werden nur im Dockstil „Taskleiste“ sichtbar getrennt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "This is an edge divider. Items beyond it are pinned to the dock edge; everything between the dividers stays centered. Edges only separate visually in the taskbar dock style."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este es un divisor de borde. Los ítems más allá de él quedan fijados al borde del Dock; todo lo que está entre los divisores permanece centrado. Los bordes solo se separan visualmente en el estilo de Dock de barra de tareas."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "This is an edge divider. Items beyond it are pinned to the dock edge; everything between the dividers stays centered. Edges only separate visually in the taskbar dock style."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ceci est un séparateur de bord. Les éléments au-delà sont ancrés au bord du Dock ; tout ce qui se trouve entre les séparateurs reste centré. Les bords ne se distinguent visuellement que dans le style barre des tâches."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "This is an edge divider. Items beyond it are pinned to the dock edge; everything between the dividers stays centered. Edges only separate visually in the taskbar dock style."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ez egy szélelválasztó. A rajta túli elemek a Dock széléhez vannak rögzítve; az elválasztók közötti elemek középen maradnak. A szélek csak a Tálca Dock-stílusban különülnek el vizuálisan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "This is an edge divider. Items beyond it are pinned to the dock edge; everything between the dividers stays centered. Edges only separate visually in the taskbar dock style."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これはエッジディバイダです。これより外側の項目はDockの端に固定され、ディバイダの間にある項目は中央に配置されます。エッジが視覚的に分かれるのはタスクバースタイルのDockのみです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "This is an edge divider. Items beyond it are pinned to the dock edge; everything between the dividers stays centered. Edges only separate visually in the taskbar dock style."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "This is an edge divider. Items beyond it are pinned to the dock edge; everything between the dividers stays centered. Edges only separate visually in the taskbar dock style."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dit is een scheidingslijn. Elementen die zich daarachter bevinden, worden aan de rand van het Dock vastgezet; alles tussen de scheidingslijnen blijft gecentreerd. De randen zorgen alleen voor een visuele scheiding in de 'Taakbalk' Dock-stijl."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To separator krawędzi. Elementy za nim są przypięte do krawędzi Docka; wszystko między separatorami pozostaje wyśrodkowane. Krawędzie oddzielają wizualnie tylko w stylu Docka jako paska zadań."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este é um divisor de extremidade. Os itens para lá dele ficam fixos na extremidade da dock; tudo o que está entre os divisores permanece centrado. As extremidades só se separam visualmente no estilo de dock de barra de tarefas."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "This is an edge divider. Items beyond it are pinned to the dock edge; everything between the dividers stays centered. Edges only separate visually in the taskbar dock style."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "This is an edge divider. Items beyond it are pinned to the dock edge; everything between the dividers stays centered. Edges only separate visually in the taskbar dock style."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Это разделитель у края. Элементы за ним закрепляются у края Dock, а элементы между разделителями остаются по центру. Элементы у краев визуально отделяются лишь при использовании Dock в стиле панели задач."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "This is an edge divider. Items beyond it are pinned to the dock edge; everything between the dividers stays centered. Edges only separate visually in the taskbar dock style."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det här är en kantavdelare. Objekt bortom den fästs vid dockans kant; allt mellan avdelarna hålls centrerat. Kanterna separeras bara visuellt i dockstilen Aktivitetsfält."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu bir kenar ayırıcısıdır. Ötesindeki öğeler dock kenarına sabitlenir; ayırıcıların arasındaki her şey ortalanmış kalır. Kenarlar yalnızca görev çubuğu dock stilinde görsel olarak ayrılır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "This is an edge divider. Items beyond it are pinned to the dock edge; everything between the dividers stays centered. Edges only separate visually in the taskbar dock style."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đây là một đường phân chia cạnh. Các mục nằm ngoài đường này sẽ được ghim vào cạnh của dock; mọi thứ nằm giữa các đường phân chia sẽ luôn được căn giữa. Các cạnh chỉ phân tách trực quan đối với kiểu dock thanh tác vụ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这是一个边缘分隔线。分隔线外侧的项目会固定在 Dock 边缘，两个分隔线之间的项目会保持居中。只有在任务栏式 Dock 中，边缘分隔才会以视觉效果显示。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這是邊緣分隔線。位於其外側的項目會固定於 Dock 邊緣；分隔線之間的項目則維持置中。僅在工作列樣式的 Dock 中，邊緣區域才會以視覺方式區隔顯示。"
          }
        }
      }
    },
    "This is not broad file scanning or message reading. Each app is controlled only for the widget or action you chose, and only while that widget is in your dock." : {
      "comment" : "Setup permission preflight reassurance",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "This is not broad file scanning or message reading. Each app is controlled only for the widget or action you chose, and only while that widget is in your dock."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هذا ليس فحصًا شاملًا للملفات أو قراءة للرسائل. يتم التحكم في كل تطبيق فقط من أجل الأداة أو الإجراء الذي اخترته، وفقط ما دامت تلك الأداة في Dock."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "This is not broad file scanning or message reading. Each app is controlled only for the widget or action you chose, and only while that widget is in your dock."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "new",
