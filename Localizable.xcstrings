    "Sit back, lift your chest and relax your shoulders. Keep your feet flat and the top of your screen at eye level." : {
      "comment" : "Posture reminder tip",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Sit back, lift your chest and relax your shoulders. Keep your feet flat and the top of your screen at eye level."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اجلس مستندًا للخلف، وارفع صدرك وأرخِ كتفيك. أبقِ قدميك مسطحتين على الأرض وأعلى الشاشة في مستوى عينيك."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Sit back, lift your chest and relax your shoulders. Keep your feet flat and the top of your screen at eye level."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Sit back, lift your chest and relax your shoulders. Keep your feet flat and the top of your screen at eye level."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Sit back, lift your chest and relax your shoulders. Keep your feet flat and the top of your screen at eye level."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lehnen Sie sich zurück, heben Sie die Brust und entspannen Sie die Schultern. Stellen Sie die Füße flach auf und halten Sie die Oberkante des Bildschirms auf Augenhöhe."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Sit back, lift your chest and relax your shoulders. Keep your feet flat and the top of your screen at eye level."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siéntate bien atrás, levanta el pecho y relaja los hombros. Mantén los pies apoyados en el suelo y la parte superior de la pantalla a la altura de los ojos."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Sit back, lift your chest and relax your shoulders. Keep your feet flat and the top of your screen at eye level."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Asseyez-vous au fond du siège, redressez la poitrine et relâchez les épaules. Gardez les pieds à plat et le haut de l'écran à hauteur des yeux."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Sit back, lift your chest and relax your shoulders. Keep your feet flat and the top of your screen at eye level."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dőljön hátra, emelje meg a mellkasát, és lazítsa el a vállát. Tartsa a talpát a padlón, a képernyő tetejét pedig szemmagasságban."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Sit back, lift your chest and relax your shoulders. Keep your feet flat and the top of your screen at eye level."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "深く腰掛けて胸を張り、肩の力を抜きましょう。足を床にしっかりつけ、画面の上端を目の高さに合わせてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Sit back, lift your chest and relax your shoulders. Keep your feet flat and the top of your screen at eye level."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Sit back, lift your chest and relax your shoulders. Keep your feet flat and the top of your screen at eye level."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leun achterover, til je borst op en ontspan je schouders. Houd je voeten plat op de grond en de bovenkant van je scherm op ooghoogte."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oprzyj plecy, wyprostuj tułów i rozluźnij ramiona. Oprzyj stopy płasko na podłodze, a górną krawędź ekranu ustaw na wysokości oczu."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Encoste-se, levante o peito e relaxe os ombros. Mantenha os pés assentes no chão e o topo do ecrã ao nível dos olhos."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Sit back, lift your chest and relax your shoulders. Keep your feet flat and the top of your screen at eye level."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Sit back, lift your chest and relax your shoulders. Keep your feet flat and the top of your screen at eye level."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Откиньтесь на спинку, расправьте грудь и расслабьте плечи. Ставьте ступни ровно на пол, а верх экрана держите на уровне глаз."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Sit back, lift your chest and relax your shoulders. Keep your feet flat and the top of your screen at eye level."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Luta dig tillbaka, lyft bröstet och slappna av i axlarna. Håll fötterna plant i golvet och skärmens överkant i ögonhöjd."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arkana yaslan, göğsünü kaldır ve omuzlarını gevşet. Ayaklarını yere düz bas ve ekranının üst kısmını göz hizasında tut."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Sit back, lift your chest and relax your shoulders. Keep your feet flat and the top of your screen at eye level."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ngồi tựa lưng, ưỡn ngực và thả lỏng vai. Đặt bàn chân phẳng trên sàn và giữ mép trên màn hình ngang tầm mắt."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "坐直并靠好，挺胸并放松肩膀。双脚平放，将屏幕顶部调整至与眼睛齐平。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "身體往後坐，挺起胸膛並放鬆肩膀。雙腳平放在地面，螢幕頂端保持與視線同高。"
          }
        }
      }
    },
