          "stringUnit" : {
            "state" : "new",
            "value" : "A widget stack can hold multiple tools in one slot. Scrolling over a stack pages through those tools."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In een widgetstapel kunnen meerdere tools in één vak worden geplaatst. Door met de muis over de stapel te scrollen, kun je door die tools bladeren."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stos widżetów może zawierać wiele narzędzi w jednym miejscu. Przewijanie nad stosem przełącza między tymi narzędziami."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma pilha de widgets pode conter várias ferramentas num só espaço. Deslocar sobre uma pilha percorre essas ferramentas."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma pilha de widgets pode segurar várias ferramentas em um slot. Role em uma pilha de páginas através dessas ferramentas."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "A widget stack can hold multiple tools in one slot. Scrolling over a stack pages through those tools."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В одной стопке виджетов может размещаться несколько инструментов. Прокрутка по стопке позволяет переключаться между ними."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "A widget stack can hold multiple tools in one slot. Scrolling over a stack pages through those tools."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En widgetstack kan rymma flera verktyg på en plats. Skrolla över en stack för att bläddra mellan verktygen."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir widget yığını, tek bir yuvada birden fazla aracı barındırabilir. Yığın üzerinde fareyi kaydırdığınızda bu araçlar arasında geçiş yapılır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "A widget stack can hold multiple tools in one slot. Scrolling over a stack pages through those tools."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Một ngăn xếp tiện ích có thể chứa nhiều công cụ trong một ô. Cuộn qua ngăn xếp để lần lượt chuyển giữa các công cụ đó."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一个小组件叠放可在同一位置容纳多个工具。在叠放上滚动即可切换其中的工具。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "小工具堆疊可以在同一個位置容納多個工具。在堆疊上捲動即可切換瀏覽這些工具。"
          }
        }
      }
    },
