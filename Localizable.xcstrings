    "Select what AppSense activates when focus moves to an unlinked app. Previous Profile restores the profile active before AppSense switched." : {
      "comment" : "Settings control description\nSettings search description",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Select what AppSense activates when focus moves to an unlinked app. Previous Profile restores the profile active before AppSense switched."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حدد ما يفعّله AppSense عند انتقال التركيز إلى تطبيق غير مرتبط. يستعيد «ملف التعريف السابق» ملف التعريف الذي كان نشطًا قبل تبديل AppSense."
          }
        },
        "ca" : {
          "stringUnit" : {
