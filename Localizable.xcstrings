        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bij de beste kwaliteit worden miniaturen van vensters vastgelegd in volledige Retina-resolutie. Dit levert scherpere voorbeelden op, maar de afbeeldingen in de cache nemen meer geheugen in beslag."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "W trybie najlepszej jakości miniatury okien są przechwytywane w pełnej rozdzielczości Retina. Podglądy są ostrzejsze, ale obrazy w pamięci podręcznej zajmują więcej pamięci."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Best quality captures window thumbnails at full Retina resolution. Sharper previews, but cached images use more memory."
