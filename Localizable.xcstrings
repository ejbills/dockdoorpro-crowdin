        },
        "vi" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Liquid Glass uses the macOS 26 glass effect. Frosted uses a blur material. Solid uses a full opacity color. Clear removes the background entirely."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liquid Glass 使用 macOS 26 的液态玻璃效果。“磨砂” 使用磨砂模糊背景。“纯色” 使用完全不透明的纯色背景。“透明” 则完全移除背景。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liquid Glass 使用 macOS 26 的玻璃效果；霧面使用模糊材質；實心使用完全不透明顏色；透明則完全移除背景。"
          }
        }
      }
