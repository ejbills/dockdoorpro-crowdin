        },
        "da" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Drag apps, files, or folders onto the dock to pin them. To combine apps into one icon, use Edit ▸ Add Item ▸ App Group."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ziehen Sie Apps, Dateien oder Ordner auf das Dock, um sie anzuheften. Um Apps in einem Symbol zu bündeln, verwenden Sie Bearbeiten ▸ Objekt hinzufügen ▸ App-Gruppe."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Drag apps, files, or folders onto the dock to pin them. To combine apps into one icon, use Edit ▸ Add Item ▸ App Group."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrastra apps, archivos o carpetas al Dock para fijarlos. Para combinar apps en un solo icono, usa Editar ▸ Añadir ítem ▸ Grupo de apps."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Drag apps, files, or folders onto the dock to pin them. To combine apps into one icon, use Edit ▸ Add Item ▸ App Group."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Glissez des apps, fichiers ou dossiers sur le dock pour les épingler. Pour combiner des apps en une seule icône, utilisez Modifier ▸ Ajouter un élément ▸ Groupe d'apps."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Drag apps, files, or folders onto the dock to pin them. To combine apps into one icon, use Edit ▸ Add Item ▸ App Group."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Húzzon appokat, fájlokat vagy mappákat a Dockra a kitűzésükhöz. Több app egy ikonba vonásához használja a Szerkesztés ▸ Elem hozzáadása ▸ Appcsoport lehetőséget."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Drag apps, files, or folders onto the dock to pin them. To combine apps into one icon, use Edit ▸ Add Item ▸ App Group."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アプリ、ファイル、フォルダをDockにドラッグしてピン留めします。複数のアプリを1つのアイコンにまとめるには、編集 ▸ 項目を追加 ▸ アプリグループを使用します。"
