          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envoyez un e-mail à %@ pour obtenir de l'aide sur les problèmes de configuration, d'activation ou sur l'utilisation de DockDoor Pro. Merci d'inclure votre clé d'activation dans l'e-mail ; le support ne peut pas être garanti sans cette information."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "new",
