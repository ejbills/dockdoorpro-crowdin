    "Panel shows a picker above the dock when scrolling; Inline changes the icon directly in the dock. Applies to the profile button and the file tray page switcher" : {
      "comment" : "Settings search description",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Panel shows a picker above the dock when scrolling; Inline changes the icon directly in the dock. Applies to the profile button and the file tray page switcher"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يعرض خيار اللوحة منتقيًا فوق Dock عند التمرير؛ بينما يغيّر الخيار المضمّن الأيقونة مباشرةً في Dock. ينطبق ذلك على زر ملف التعريف ومبدّل صفحات حاوية الملفات"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Panel shows a picker above the dock when scrolling; Inline changes the icon directly in the dock. Applies to the profile button and the file tray page switcher"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Panel shows a picker above the dock when scrolling; Inline changes the icon directly in the dock. Applies to the profile button and the file tray page switcher"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Panel shows a picker above the dock when scrolling; Inline changes the icon directly in the dock. Applies to the profile button and the file tray page switcher"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Panel“ zeigt beim Scrollen eine Auswahl über dem Dock an; „Inline“ ändert das Symbol direkt im Dock. Gilt für die Profilschaltfläche und den Seitenumschalter der Datei-Ablage"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Panel shows a picker above the dock when scrolling; Inline changes the icon directly in the dock. Applies to the profile button and the file tray page switcher"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Panel muestra un selector encima del Dock al desplazarse; En línea cambia el icono directamente en el Dock. Se aplica al botón de perfil y al selector de páginas de la bandeja de archivos"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Panel shows a picker above the dock when scrolling; Inline changes the icon directly in the dock. Applies to the profile button and the file tray page switcher"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Panneau affiche un sélecteur au-dessus du dock lors du défilement ; Intégré change l'icône directement dans le dock. S'applique au bouton de profil et au sélecteur de pages du tiroir de fichiers"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Panel shows a picker above the dock when scrolling; Inline changes the icon directly in the dock. Applies to the profile button and the file tray page switcher"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Panel görgetéskor választót jelenít meg a Dock fölött; a Beágyazott közvetlenül a Dockban váltja az ikont. A profilgombra és a Fájltároló Tálca lapváltójára vonatkozik"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Panel shows a picker above the dock when scrolling; Inline changes the icon directly in the dock. Applies to the profile button and the file tray page switcher"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「パネル」はスクロール時にDockの上にピッカーを表示し、「インライン」はDock内のアイコンを直接切り替えます。プロファイルボタンとファイルトレイのページ切り替えに適用されます"
          }
        },
        "ko" : {
          "stringUnit" : {
