          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tamanho, opacidade, contorno, reflexo e tonalidade com a cor da app dos cartões atrás dos ícones das apps em execução."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Card size, opacity, outline, glimmer, and app-color tint behind running app icons."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Card size, opacity, outline, glimmer, and app-color tint behind running app icons."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Размер, непрозрачность, контур, блик и оттенок цвета приложения у карточек за значками запущенных приложений."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "new",
