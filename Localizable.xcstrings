          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Affiche les arrière-plans de carte derrière les sections de l'étagère : tiroir de fichiers, dossiers, AirDrop et apps ouvertes. Désactivez pour un rendu plus épuré et plus contrasté."
          }
        },
        "he" : {
