          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A polcszakaszok (Fájltároló Tálca, mappák, AirDrop és nyitott appok) mögötti kártyahátterek megjelenítése. Kikapcsolva letisztultabb, kontrasztosabb megjelenést kap."
          }
        },
        "it" : {
          "stringUnit" : {
