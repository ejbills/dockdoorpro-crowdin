    "This is an edge divider. Items beyond it are pinned to the dock edge; everything between the dividers stays centered. Edges only separate visually in the taskbar dock style." : {
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "This is an edge divider. Items beyond it are pinned to the dock edge; everything between the dividers stays centered. Edges only separate visually in the taskbar dock style."
          }
