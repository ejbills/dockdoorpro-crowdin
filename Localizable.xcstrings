    "Show the card backgrounds behind shelf sections — File Tray, folders, AirDrop, and Open Apps. Turn off for a cleaner, higher-contrast look." : {
      "comment" : "Settings control description",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Show the card backgrounds behind shelf sections — File Tray, folders, AirDrop, and Open Apps. Turn off for a cleaner, higher-contrast look."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اعرض خلفيات البطاقات خلف أقسام الرف، أي حاوية الملفات والمجلدات وAirDrop والتطبيقات المفتوحة. أوقف هذا الخيار للحصول على مظهر أنقى وأعلى تباينًا."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Show the card backgrounds behind shelf sections — File Tray, folders, AirDrop, and Open Apps. Turn off for a cleaner, higher-contrast look."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Show the card backgrounds behind shelf sections — File Tray, folders, AirDrop, and Open Apps. Turn off for a cleaner, higher-contrast look."
