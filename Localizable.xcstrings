          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les piles de widgets apparaissent de chaque côté de vos icônes d'apps. Jusqu'à 3 piles par côté. Chaque pile peut contenir plusieurs widgets, faites défiler pour passer de l'un à l'autre."
          }
        },
