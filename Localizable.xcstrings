            "value" : "Ứng dụng nhận các tệp được gửi từ vùng AirDrop và các menu. Chọn một ứng dụng khác để dùng dịch vụ truyền tệp như Blip hoặc LocalSend."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "接收通过 AirDrop 区域和菜单发送的文件的应用。选择其他应用可使用 Blip 或 LocalSend 等传输服务。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用來接收從 AirDrop 區域與選單傳送之檔案的應用程式。你也可以選擇其他應用程式，改用 Blip 或 LocalSend 等檔案傳輸服務。"
          }
        }
      }
    },
