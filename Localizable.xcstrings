          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Írjon e-mailt a(z) %@ címre, ha segítségre van szüksége a beállítással, aktiválással vagy a DockDoor Pro problémáival kapcsolatban. Az e-mailben tüntesse fel az aktiváló kulcsát; enélkül a támogatás nem garantált."
          }
        },
