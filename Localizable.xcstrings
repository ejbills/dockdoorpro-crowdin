        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App que recibe los archivos enviados desde la zona de AirDrop y los menús. Elige otra app para usar un servicio de transferencia como Blip o LocalSend."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "App that receives files sent from the AirDrop zone and menus. Choose another app to use a transfer service such as Blip or LocalSend."
          }
        },
        "fr" : {
          "stringUnit" : {
