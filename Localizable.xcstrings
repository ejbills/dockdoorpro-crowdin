        "sr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "With the menu bar icon off, you can still reopen Settings from the dock's profile or settings button — or by relaunching DockDoor Pro from Finder, Spotlight, or Launchpad."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Med menyradssymbolen avstängd kan du fortfarande öppna Inställningar igen från dockans profil- eller inställningsknapp, eller genom att starta om DockDoor Pro från Finder, Spotlight eller Launchpad."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menü çubuğu simgesi kapalıyken bile Ayarlar'ı dock'un profil veya ayarlar düğmesinden — ya da DockDoor Pro'yu Finder, Spotlight veya Launchpad'den yeniden başlatarak — yeniden açabilirsin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "With the menu bar icon off, you can still reopen Settings from the dock's profile or settings button — or by relaunching DockDoor Pro from Finder, Spotlight, or Launchpad."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khi biểu tượng thanh menu tắt, bạn vẫn có thể mở lại phần Cài đặt từ nút hồ sơ hoặc nút cài đặt của dock — hoặc bằng cách chạy lại DockDoor Pro từ Finder, Spotlight hoặc Launchpad."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "即使关闭菜单栏图标，仍可通过 Dock 中的配置文件按钮或设置按钮重新打开“设置”；也可以通过访达、聚焦或启动台重新启动 DockDoor Pro。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "即使關閉選單列圖示，您仍可透過 Dock 的設定檔或設定按鈕重新開啟「設定」 — 或者從 Finder、Spotlight 或 Launchpad 重新啟動 DockDoor Pro。"
          }
        }
      }
    },
