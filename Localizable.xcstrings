          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا تتم قراءة البريد إلا أثناء فتحه. في المرة الأولى، يطلب macOS السماح لـ DockDoor Pro بالتحكم في البريد."
          }
        },
        "ca" : {
          "stringUnit" : {
