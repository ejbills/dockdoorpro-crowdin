    "Running apps, and any minimized windows from menu bar apps, appear at this position in the dock. Drag this row to reposition them; remove it to send them back to the end of the dock." : {
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Running apps, and any minimized windows from menu bar apps, appear at this position in the dock. Drag this row to reposition them; remove it to send them back to the end of the dock."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تظهر التطبيقات قيد التشغيل، وأي نوافذ مصغّرة من تطبيقات شريط القائمة، في هذا الموضع من Dock. اسحب هذا الصف لتغيير موضعها؛ وأزله لإعادتها إلى نهاية Dock."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Running apps, and any minimized windows from menu bar apps, appear at this position in the dock. Drag this row to reposition them; remove it to send them back to the end of the dock."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Running apps, and any minimized windows from menu bar apps, appear at this position in the dock. Drag this row to reposition them; remove it to send them back to the end of the dock."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Running apps, and any minimized windows from menu bar apps, appear at this position in the dock. Drag this row to reposition them; remove it to send them back to the end of the dock."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laufende Apps und alle minimierten Fenster von Menüleisten-Apps werden an dieser Position im Dock angezeigt. Ziehen Sie diese Zeile, um sie neu zu positionieren; entfernen Sie sie, um sie wieder ans Ende des Docks zu verschieben."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Running apps, and any minimized windows from menu bar apps, appear at this position in the dock. Drag this row to reposition them; remove it to send them back to the end of the dock."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las apps en ejecución, y cualquier ventana minimizada de apps de la barra de menús, aparecen en esta posición del Dock. Arrastra esta fila para recolocarlas; elimínala para que vuelvan al final del Dock."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Running apps, and any minimized windows from menu bar apps, appear at this position in the dock. Drag this row to reposition them; remove it to send them back to the end of the dock."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les apps actives, et les fenêtres réduites des apps de barre des menus, apparaissent à cette position dans le dock. Glissez cette rangée pour les repositionner ; supprimez-la pour les renvoyer à la fin du dock."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Running apps, and any minimized windows from menu bar apps, appear at this position in the dock. Drag this row to reposition them; remove it to send them back to the end of the dock."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A futó appok és a menüsori appok kicsinyített ablakai ezen a helyen jelennek meg a Dockban. Húzza ezt a sort az áthelyezésükhöz; eltávolítva visszakerülnek a Dock végére."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Running apps, and any minimized windows from menu bar apps, appear at this position in the dock. Drag this row to reposition them; remove it to send them back to the end of the dock."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "実行中のアプリと、メニューバーアプリのしまわれたウインドウはDock内のこの位置に表示されます。この行をドラッグすると位置を変更できます。削除するとDockの末尾に戻ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Running apps, and any minimized windows from menu bar apps, appear at this position in the dock. Drag this row to reposition them; remove it to send them back to the end of the dock."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Running apps, and any minimized windows from menu bar apps, appear at this position in the dock. Drag this row to reposition them; remove it to send them back to the end of the dock."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Actieve apps, en geminimaliseerde vensters van apps in de menubalk, worden op deze plek in het Dock weergegeven. Versleep deze rij om ze te verplaatsen of verwijder de rij om actieve apps weer naar het einde van het Dock te verplaatsen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uruchomione aplikacje oraz zminimalizowane okna aplikacji z paska menu pojawiają się w tym miejscu Docka. Przeciągnij ten wiersz, aby zmienić ich położenie; usuń go, aby odesłać je z powrotem na koniec Docka."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As apps em execução, e quaisquer janelas minimizadas de apps da barra de menus, aparecem nesta posição na dock. Arraste esta linha para as reposicionar; remova-a para as enviar de volta para o fim da dock."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Running apps, and any minimized windows from menu bar apps, appear at this position in the dock. Drag this row to reposition them; remove it to send them back to the end of the dock."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Running apps, and any minimized windows from menu bar apps, appear at this position in the dock. Drag this row to reposition them; remove it to send them back to the end of the dock."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Запущенные приложения и любые свернутые окна приложений из строки меню появляются в этом месте Dock. Перетащите эту строку, чтобы изменить их положение; удалите ее, чтобы вернуть их в конец Dock."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Running apps, and any minimized windows from menu bar apps, appear at this position in the dock. Drag this row to reposition them; remove it to send them back to the end of the dock."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appar som körs, och eventuella minimerade fönster från menyradsappar, visas på den här positionen i docken. Dra raden för att flytta dem; ta bort den för att skicka tillbaka dem till slutet av docken."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Çalışan uygulamalar ve menü çubuğu uygulamalarından gelen küçültülmüş pencereler dock'ta bu konumda görünür. Yeniden konumlandırmak için bu satırı sürükle; dock'un sonuna geri göndermek için kaldır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Running apps, and any minimized windows from menu bar apps, appear at this position in the dock. Drag this row to reposition them; remove it to send them back to the end of the dock."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Các ứng dụng đang chạy, cùng với mọi cửa sổ được thu nhỏ từ ứng dụng thanh menu, sẽ xuất hiện tại vị trí này trên dock. Kéo hàng này để thay đổi vị trí của chúng; gỡ bỏ nó để đưa chúng trở lại phía cuối của dock."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "运行中的应用以及菜单栏应用的最小化窗口会显示在 Dock 的此位置。拖动此行可调整其位置；移除后，它们将恢复显示在 Dock 的末尾。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "執行中的應用程式，以及選單列應用程式的所有最小化視窗，都會顯示在 Dock 的這個位置。拖曳此列即可重新調整位置；移除這一列則會將它們移回 Dock 的尾端。"
          }
        }
      }
    },
