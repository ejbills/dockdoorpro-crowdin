        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将鼠标悬停在任意 Dock 项目上即可触发相应功能，包括窗口预览、文件夹扇形展开、小组件和配置文件按钮。此设置适用于整个 Dock。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "將指標懸停於任何 Dock 項目即可觸發其功能，包括視窗預覽、檔案夾展開選單、小工具及設定檔按鈕。此設定會套用至整個 Dock。"
          }
        }
      }
    },
