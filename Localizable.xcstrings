    "Access is requested in context for the files and folders you choose. DockDoor Pro does not inventory your disk during setup." : {
      "comment" : "Setup permission preflight reassurance",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : ""
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يُطلب الوصول في سياقه للملفات والمجلدات التي تختارها. لا يقوم DockDoor Pro بفهرسة القرص لديك أثناء الإعداد."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Access is requested in context for the files and folders you choose. DockDoor Pro does not inventory your disk during setup."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Access is requested in context for the files and folders you choose. DockDoor Pro does not inventory your disk during setup."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Access is requested in context for the files and folders you choose. DockDoor Pro does not inventory your disk during setup."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Zugriff wird nur im Kontext der von Ihnen ausgewählten Dateien und Ordner angefordert. DockDoor Pro scannt Ihre Festplatte während der Einrichtung nicht."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Access is requested in context for the files and folders you choose. DockDoor Pro does not inventory your disk during setup."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El acceso se solicita en contexto para los archivos y carpetas que elijas. DockDoor Pro no hace un inventario de tu disco durante la configuración."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Access is requested in context for the files and folders you choose. DockDoor Pro does not inventory your disk during setup."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'accès est demandé en contexte pour les fichiers et dossiers que vous choisissez. DockDoor Pro n'inventorie pas votre disque pendant la configuration."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Access is requested in context for the files and folders you choose. DockDoor Pro does not inventory your disk during setup."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A hozzáférést a rendszer mindig az adott helyzetben kéri az Ön által kiválasztott fájlokhoz és mappákhoz. A DockDoor Pro nem térképezi fel a lemezt az üzembe helyezés során."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'accesso viene richiesto solo per i file e le cartelle che scegli. DockDoor Pro non esegue alcuna scansione o catalogazione del disco durante la configurazione iniziale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アクセスは、選択したファイルやフォルダに対して必要になった時点で要求されます。DockDoor Proがセットアップ中にディスク全体を調べることはありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "선택한 파일과 폴더에 한해서만 접근 권한이 요청됩니다. DockDoor Pro는 설정 중에 디스크를 검사하지 않습니다"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Access is requested in context for the files and folders you choose. DockDoor Pro does not inventory your disk during setup."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er wordt toegang gevraagd voor de bestanden en mappen die je selecteert. DockDoor Pro maakt geen overzicht van je schijf tijdens de installatie."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prośba o dostęp do wybranych plików i folderów pojawia się w kontekście ich użycia. DockDoor Pro nie inwentaryzuje dysku podczas konfiguracji."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O acesso é pedido em contexto para os ficheiros e pastas que escolher. O DockDoor Pro não inventaria o disco durante a configuração."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Access is requested in context for the files and folders you choose. DockDoor Pro does not inventory your disk during setup."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Access is requested in context for the files and folders you choose. DockDoor Pro does not inventory your disk during setup."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Доступ к выбранным вами файлам и папкам запрашивается по мере необходимости. DockDoor Pro не сканирует содержимое диска во время настройки."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Access is requested in context for the files and folders you choose. DockDoor Pro does not inventory your disk during setup."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Åtkomst begärs i sitt sammanhang för de filer och mappar du väljer. DockDoor Pro inventerar inte din disk under installationen."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seçtiğiniz dosya ve klasörler için bağlam içinde erişim izni istenir. DockDoor Pro, kurulum sırasında diskinizi taramaz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Access is requested in context for the files and folders you choose. DockDoor Pro does not inventory your disk during setup."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quyền truy cập chỉ được yêu cầu khi cần thiết đối với các tệp và thư mục bạn chọn. DockDoor Pro không quét toàn bộ ổ đĩa của bạn trong quá trình thiết lập."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅会请求你所选择的文件和文件夹的访问权限。DockDoor Pro 不会在设置过程中扫描你的磁盘。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "系統會根據你選擇的檔案和檔案夾，在對應的情境下要求取用權限。DockDoor Pro 在設定過程中不會清點你的磁碟。"
          }
        }
      }
    },
    "Access needed" : {
      "comment" : "Mail panel automation denied summary",
      "localizations" : {
        "af" : {
