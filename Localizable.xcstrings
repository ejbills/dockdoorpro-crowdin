    "Hide the native Dock only when you are ready to replace it. This changes Dock preferences and restarts the Dock process." : {
      "comment" : "Setup directory step description",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Hide the native Dock only when you are ready to replace it. This changes Dock preferences and restarts the Dock process."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أخفِ Dock الأصلي فقط عندما تكون مستعدًا لاستبداله. يغيّر هذا تفضيلات Dock ويعيد تشغيل عملية Dock."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "new",
