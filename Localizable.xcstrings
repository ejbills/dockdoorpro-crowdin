    "Reminders arrive between 9 AM and 9 PM, counted from your last glass. Set to 0 to turn them off." : {
      "comment" : "Drink water widget option footnote",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Reminders arrive between 9 AM and 9 PM, counted from your last glass. Set to 0 to turn them off."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تصل التذكيرات بين 9 صباحًا و9 مساءً، محسوبة من آخر كوب شربته. اضبطها على 0 لإيقافها."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Reminders arrive between 9 AM and 9 PM, counted from your last glass. Set to 0 to turn them off."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Reminders arrive between 9 AM and 9 PM, counted from your last glass. Set to 0 to turn them off."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Reminders arrive between 9 AM and 9 PM, counted from your last glass. Set to 0 to turn them off."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erinnerungen erfolgen zwischen 9 und 21 Uhr, gezählt ab Ihrem letzten Glas. Setzen Sie den Wert auf 0, um sie zu deaktivieren."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Reminders arrive between 9 AM and 9 PM, counted from your last glass. Set to 0 to turn them off."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los recordatorios llegan entre las 9:00 y las 21:00, contando desde tu último vaso. Ajústalo a 0 para desactivarlos."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Reminders arrive between 9 AM and 9 PM, counted from your last glass. Set to 0 to turn them off."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les rappels arrivent entre 9 h et 21 h, à compter de votre dernier verre. Réglez sur 0 pour les désactiver."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Reminders arrive between 9 AM and 9 PM, counted from your last glass. Set to 0 to turn them off."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az emlékeztetők 9 és 21 óra között érkeznek, az utolsó pohártól számítva. Állítsa 0-ra a kikapcsolásukhoz."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Reminders arrive between 9 AM and 9 PM, counted from your last glass. Set to 0 to turn them off."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "リマインダーは午前9時から午後9時の間に、最後の1杯から数えて通知されます。0に設定するとオフになります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Reminders arrive between 9 AM and 9 PM, counted from your last glass. Set to 0 to turn them off."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Reminders arrive between 9 AM and 9 PM, counted from your last glass. Set to 0 to turn them off."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Herinneringen komen tussen 9:00 en 21:00, gerekend vanaf je laatste glas. Stel in op 0 om ze uit te schakelen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przypomnienia pojawiają się między 9:00 a 21:00, licząc od ostatniej szklanki. Ustaw 0, aby je wyłączyć."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os lembretes chegam entre as 9h e as 21h, contados a partir do último copo. Defina 0 para os desativar."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Reminders arrive between 9 AM and 9 PM, counted from your last glass. Set to 0 to turn them off."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Reminders arrive between 9 AM and 9 PM, counted from your last glass. Set to 0 to turn them off."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Напоминания приходят с 9:00 до 21:00, отсчет ведется от последнего стакана. Установите 0, чтобы выключить их."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Reminders arrive between 9 AM and 9 PM, counted from your last glass. Set to 0 to turn them off."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Påminnelser kommer mellan 09.00 och 21.00, räknat från ditt senaste glas. Ställ in på 0 för att stänga av dem."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anımsatıcılar sabah 9 ile akşam 9 arasında, son bardağından itibaren sayılarak gelir. Kapatmak için 0 yap."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Reminders arrive between 9 AM and 9 PM, counted from your last glass. Set to 0 to turn them off."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lời nhắc xuất hiện từ 9 giờ sáng đến 9 giờ tối, tính từ ly nước gần nhất của bạn. Đặt thành 0 để tắt."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "提醒在上午 9 点至晚上 9 点之间发送，从您上次喝水时开始计时。设为 0 可关闭提醒。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "提醒會在上午 9 點至晚上 9 點之間發送，並從你上次喝水的時間開始計算。設為 0 即可關閉提醒。"
          }
        }
      }
    },
