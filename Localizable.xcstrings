    "Install community widgets directly from the marketplace. Widgets run natively in your dock. Widget updates may require a restart of the app to fully take effect." : {
      "comment" : "Marketplace info note",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Install community widgets directly from the marketplace. Widgets run natively in your dock. Widget updates may require a restart of the app to fully take effect."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قم بتثبيت أدوات المجتمع مباشرة من السوق. الأدوات تعمل محلياً في المرفأ الخاص بك. قد تتطلب تحديثات القطعة إعادة تشغيل التطبيق لتبدأ مفعولها بالكامل."
          }
        },
        "ca" : {
          "stringUnit" : {
