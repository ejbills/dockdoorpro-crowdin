        "uk" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Panel shows a picker above the dock when scrolling; Inline changes the icon directly in the dock. Applies to the profile button and the file tray page switcher"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bảng điều khiển hiển thị một bộ chọn phía trên dock khi cuộn; tùy chọn cùng dòng thay đổi trực tiếp biểu tượng ngay trong dock. Áp dụng cho nút hồ sơ và bộ chuyển đổi trang của khay tệp"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "面板模式会在滚动时在 Dock 上方显示选择器；内联模式则会直接在 Dock 中切换图标。 此设置适用于配置文件按钮和文件图托盘页面切换器"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「面板」模式會在捲動時於 Dock 上方顯示選擇器；「內嵌」模式則會直接在 Dock 中切換圖示。此設定適用於設定檔按鈕和檔案托盤頁面切換器"
          }
        }
      }
    },
