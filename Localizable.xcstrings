          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перетащите приложения, файлы или папки в Dock, чтобы закрепить их. Чтобы объединить приложения в один значок, выберите «Редактировать» ▸ «Добавить объект» ▸ «Группа приложений»."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Drag apps, files, or folders onto the dock to pin them. To combine apps into one icon, use Edit ▸ Add Item ▸ App Group."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dra appar, filer eller mappar till dockan för att fästa dem. Om du vill kombinera appar i en symbol använder du Redigera ▸ Lägg till objekt ▸ Appgrupp."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sabitlemek için uygulamaları, dosyaları veya klasörleri dock'a sürükle. Uygulamaları tek simgede birleştirmek için Düzenle ▸ Öğe Ekle ▸ Uygulama Grubu'nu kullan."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Drag apps, files, or folders onto the dock to pin them. To combine apps into one icon, use Edit ▸ Add Item ▸ App Group."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kéo các ứng dụng, tệp hoặc thư mục vào dock để ghim chúng. Để gộp nhiều ứng dụng vào một biểu tượng, hãy sử dụng Sửa ▸ Thêm mục ▸ Nhóm ứng dụng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将应用、文件或文件夹拖到 Dock 上即可将其固定。若要将多个应用合并为一个图标，请使用“编辑 ▸ 添加项目 ▸ 应用组”。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "將應用程式、檔案或檔案夾拖移到 Dock 以進行釘選。若要將多個應用程式合併為單一圖示，請使用「編輯 ▸ 新增項目 ▸ 應用程式群組」。"
          }
        }
      }
    },
