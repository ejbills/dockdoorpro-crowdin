    "When the dock is on the left or right, scrolling and gestures use horizontal (left/right) input instead of vertical." : {
      "comment" : "Vertical dock scroll orientation note",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "When the dock is on the left or right, scrolling and gestures use horizontal (left/right) input instead of vertical."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عندما يكون الرصيف على اليسار أو اليمين، يستخدم التمرير والإيماءات الإدخال الأفقي (اليسار/اليمين) بدلاً من الإدخال الرأسي."
          }
        },
        "ca" : {
