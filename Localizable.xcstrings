    "With ⌘ held, the Cycle Windows key steps through the highlighted app's windows, and the Preview Navigator action keys (Q, M, F by default) act on the selected one." : {
      "comment" : "Glance keyboard note",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "With ⌘ held, the Cycle Windows key steps through the highlighted app's windows, and the Preview Navigator action keys (Q, M, F by default) act on the selected one."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "With ⌘ held, the Cycle Windows key steps through the highlighted app's windows, and the Preview Navigator action keys (Q, M, F by default) act on the selected one."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "new",
