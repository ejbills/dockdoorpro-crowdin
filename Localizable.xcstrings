        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "E-mail %@ voor hulp met installatie, activatie, of DockDoor Pro problemen. Voeg je activatiecode toe aan de e-mail; ondersteuning zonder activatiecode is niet gegarandeerd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Napisz do %@, aby uzyskać pomoc z konfiguracją, aktywacją lub problemami z DockDoor Pro. Dołącz klucz aktywacyjny w wiadomości; bez niego pomoc może nie być gwarantowana."
