          "stringUnit" : {
            "state" : "new",
            "value" : "Stand up and move for a minute. Roll your shoulders, stretch your neck side to side and reach overhead."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Stand up and move for a minute. Roll your shoulders, stretch your neck side to side and reach overhead."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stehen Sie auf und bewegen Sie sich eine Minute lang. Kreisen Sie die Schultern, dehnen Sie den Nacken zu beiden Seiten und strecken Sie sich nach oben."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Stand up and move for a minute. Roll your shoulders, stretch your neck side to side and reach overhead."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Levántate y muévete durante un minuto. Gira los hombros, estira el cuello de lado a lado y estira los brazos por encima de la cabeza."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Stand up and move for a minute. Roll your shoulders, stretch your neck side to side and reach overhead."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Levez-vous et bougez pendant une minute. Faites rouler vos épaules, étirez votre cou d'un côté à l'autre et tendez les bras au-dessus de la tête."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Stand up and move for a minute. Roll your shoulders, stretch your neck side to side and reach overhead."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Álljon fel, és mozogjon egy percig. Körözzön a vállával, nyújtsa a nyakát jobbra-balra, és nyújtózkodjon a feje fölé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Stand up and move for a minute. Roll your shoulders, stretch your neck side to side and reach overhead."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "立ち上がって1分間体を動かしましょう。肩を回し、首を左右に伸ばし、腕を頭上に伸ばしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Stand up and move for a minute. Roll your shoulders, stretch your neck side to side and reach overhead."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Stand up and move for a minute. Roll your shoulders, stretch your neck side to side and reach overhead."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sta op en beweeg een minuut. Rol met je schouders, strek je nek van links naar rechts en reik boven je hoofd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wstań i poruszaj się przez minutę. Wykonaj krążenia ramion, rozciągnij szyję, przechylając głowę na boki, i wyciągnij ręce nad głowę."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Levante-se e mexa-se durante um minuto. Rode os ombros, alongue o pescoço de um lado para o outro e estique os braços acima da cabeça."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Stand up and move for a minute. Roll your shoulders, stretch your neck side to side and reach overhead."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Stand up and move for a minute. Roll your shoulders, stretch your neck side to side and reach overhead."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Встаньте и подвигайтесь минуту. Покрутите плечами, наклоните голову из стороны в сторону и потянитесь вверх."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Stand up and move for a minute. Roll your shoulders, stretch your neck side to side and reach overhead."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Res dig upp och rör på dig en minut. Rulla axlarna, sträck på nacken från sida till sida och sträck armarna över huvudet."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ayağa kalk ve bir dakika hareket et. Omuzlarını döndür, boynunu iki yana esnet ve başının üzerine uzan."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Stand up and move for a minute. Roll your shoulders, stretch your neck side to side and reach overhead."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đứng dậy và vận động trong một phút. Xoay vai, nghiêng cổ sang hai bên và vươn tay lên cao."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "站起来活动一分钟。转动肩膀，向两侧伸展颈部，再将双臂举过头顶伸展。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "起身活動一分鐘。轉動肩膀、左右伸展頸部，再將雙手向上伸展。"
          }
        }
      }
    },
