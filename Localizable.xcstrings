    "List shows one named row per item in a narrower panel. For the classic Control Center, choose List and turn off Running Apps." : {
      "comment" : "Control Center pinned items layout picker description",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "List shows one named row per item in a narrower panel. For the classic Control Center, choose List and turn off Running Apps."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يعرض خيار «قائمة» صفًا مسمى لكل عنصر في لوحة أضيق. للحصول على مركز التحكم الكلاسيكي، اختر «قائمة» وأوقف «التطبيقات قيد التشغيل»."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "List shows one named row per item in a narrower panel. For the classic Control Center, choose List and turn off Running Apps."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "List shows one named row per item in a narrower panel. For the classic Control Center, choose List and turn off Running Apps."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "List shows one named row per item in a narrower panel. For the classic Control Center, choose List and turn off Running Apps."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Liste“ zeigt eine benannte Zeile pro Objekt in einem schmaleren Panel. Für das klassische Kontrollzentrum wählen Sie „Liste“ und deaktivieren „Laufende Apps“."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "List shows one named row per item in a narrower panel. For the classic Control Center, choose List and turn off Running Apps."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lista muestra una fila con nombre por ítem en un panel más estrecho. Para el Centro de control clásico, elige Lista y desactiva Apps en ejecución."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "List shows one named row per item in a narrower panel. For the classic Control Center, choose List and turn off Running Apps."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liste affiche une ligne nommée par élément dans un panneau plus étroit. Pour le Centre de contrôle classique, choisissez Liste et désactivez Apps actives."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "List shows one named row per item in a narrower panel. For the classic Control Center, choose List and turn off Running Apps."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Lista elemenként egy megnevezett sort mutat egy keskenyebb panelen. A klasszikus Vezérlőközponthoz válassza a Listát, és kapcsolja ki a Futó appokat."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "List shows one named row per item in a narrower panel. For the classic Control Center, choose List and turn off Running Apps."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「リスト」では、幅の狭いパネルに項目ごとに名前付きの行を1つずつ表示します。従来のコントロールセンターにするには、「リスト」を選択して「実行中のアプリ」をオフにしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "List shows one named row per item in a narrower panel. For the classic Control Center, choose List and turn off Running Apps."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "List shows one named row per item in a narrower panel. For the classic Control Center, choose List and turn off Running Apps."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lijst toont één rij met naam per item in een smaller paneel. Kies voor het klassieke Control Center 'Lijst' en schakel 'Actieve apps' uit."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lista wyświetla każdy element w osobnym wierszu z nazwą, w węższym panelu. Aby uzyskać klasyczny wygląd Centrum sterowania, wybierz opcję Lista i wyłącz Uruchomione aplikacje."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lista mostra uma fila com nome por item, num painel mais estreito. Para a Central de controlo clássica, escolha Lista e desative Apps em Execução."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "List shows one named row per item in a narrower panel. For the classic Control Center, choose List and turn off Running Apps."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "List shows one named row per item in a narrower panel. For the classic Control Center, choose List and turn off Running Apps."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В режиме «Список» каждый объект занимает отдельную строку с названием, а панель становится уже. Для классического Пункта управления выберите «Список» и выключите «Запущенные приложения»."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "List shows one named row per item in a narrower panel. For the classic Control Center, choose List and turn off Running Apps."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lista visar en namngiven rad per objekt i en smalare panel. För det klassiska Kontrollcenter väljer du Lista och stänger av Appar som körs."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liste, daha dar bir panelde öğe başına adlandırılmış bir satır gösterir. Klasik Denetim Merkezi için Liste'yi seç ve Çalışan Uygulamalar'ı kapat."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "List shows one named row per item in a narrower panel. For the classic Control Center, choose List and turn off Running Apps."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Danh sách hiển thị mỗi mục một hàng có tên trong bảng hẹp hơn. Để có Trung tâm điều khiển cổ điển, hãy chọn Danh sách và tắt Ứng dụng đang chạy."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "列表会在较窄的面板中为每个项目显示一行名称。要使用经典控制中心，请选择“列表”并关闭“运行中的应用”。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「列表」會在較窄的面板中，以每個項目一列並顯示名稱。若要使用經典的「控制中心」樣式，請選擇「列表」並關閉「執行中的應用程式」。"
          }
        }
      }
    },
