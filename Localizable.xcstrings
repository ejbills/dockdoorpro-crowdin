    "Turn off to completely disable the shelf. Scrolling, file drags, shelf widgets, and action buttons will no longer open it." : {
      "comment" : "Settings control description",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Turn off to completely disable the shelf. Scrolling, file drags, shelf widgets, and action buttons will no longer open it."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أوقف هذا الخيار لتعطيل الرف تمامًا. لن يفتحه بعد ذلك التمرير أو سحب الملفات أو أدوات الرف أو أزرار الإجراءات."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Turn off to completely disable the shelf. Scrolling, file drags, shelf widgets, and action buttons will no longer open it."
          }
        },
        "cs" : {
