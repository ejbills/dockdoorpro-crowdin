    "Panel shows a picker above the dock when scrolling. Inline changes the profile icon directly in the dock." : {
      "comment" : "Profile button scroll mode description\nSettings search description",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Panel shows a picker above the dock when scrolling. Inline changes the profile icon directly in the dock."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يظهر اللوحة منتقي أعلى المرتبة عند التمرين. يغير الخط رمز الملف الشخصي مباشرة في المرفأ."
          }
        },
        "ca" : {
          "stringUnit" : {
