          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hiển thị các cửa sổ đã thu nhỏ từ thanh menu và ứng dụng nền thành các ô ở cuối dock, giống như cách Dock gốc sắp xếp chúng gần Thùng rác. Nhấp vào một ô để khôi phục cửa sổ đó."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将菜单栏应用和后台应用的最小化窗口以磁贴形式显示在 Dock 末尾，就像 macOS 原生 Dock 会将它们放在废纸篓旁一样。点击磁贴即可恢复对应窗口。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "將選單列和背景應用程式中最小化的視窗，以圖塊形式顯示在 Dock 的末端，就像原生 Dock 將它們放置在垃圾桶附近一樣。按一下圖塊即可還原該視窗。"
          }
        }
      }
