    "Email %@ for help with setup, activation, or DockDoor Pro issues. Include your activation key in the email; support may not be guaranteed without it." : {
      "comment" : "Support settings note",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "new",
