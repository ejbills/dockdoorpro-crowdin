        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le panneau affiche un sélecteur au-dessus du dock lors du défilement. \nLe mode intégré modifie directement l’icône de profil."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Panel shows a picker above the dock when scrolling. Inline changes the profile icon directly in the dock."
          }
