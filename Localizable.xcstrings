    "Fast Tap delays previews briefly so quick shortcut presses can switch without showing the panel" : {
      "comment" : "Settings control description",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Fast Tap delays previews briefly so quick shortcut presses can switch without showing the panel"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يؤخر «النقر السريع» المعاينات لفترة وجيزة بحيث يمكن لضغطات الاختصار السريعة التبديل دون إظهار اللوحة"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Fast Tap delays previews briefly so quick shortcut presses can switch without showing the panel"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Fast Tap delays previews briefly so quick shortcut presses can switch without showing the panel"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Fast Tap delays previews briefly so quick shortcut presses can switch without showing the panel"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fast Tap verzögert Vorschauen kurz, damit Sie bei schnellen Tastendrücken wechseln können, ohne das Panel anzuzeigen"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Fast Tap delays previews briefly so quick shortcut presses can switch without showing the panel"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La pulsación rápida retrasa brevemente las previsualizaciones para que las pulsaciones rápidas del atajo cambien de ventana sin mostrar el panel"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Fast Tap delays previews briefly so quick shortcut presses can switch without showing the panel"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appui rapide retarde brièvement les aperçus pour éviter d'afficher le panneau lors de changements rapides"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Fast Tap delays previews briefly so quick shortcut presses can switch without showing the panel"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Gyors lenyomás rövid időre késlelteti az előnézetek megjelenését, így a gyors billentyűparancsokkal történő váltás a panel felugrása nélkül történhet"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Fast Tap delays previews briefly so quick shortcut presses can switch without showing the panel"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "高速タップではプレビューの表示を少し遅らせるため、ショートカットをすばやく押すとパネルを表示せずに切り替えられます"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Fast Tap delays previews briefly so quick shortcut presses can switch without showing the panel"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Fast Tap delays previews briefly so quick shortcut presses can switch without showing the panel"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Snel tikken zorgt ervoor dat het voorbeeld kort wordt uitgesteld, zodat je met een snelle druk op de sneltoets kunt wisselen zonder dat het paneel wordt weergegeven"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Szybkie stuknięcie krótko opóźnia podglądy, aby szybkie naciśnięcia skrótów mogły przełączać bez pokazywania panelu"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Toque Rápido atrasa brevemente as pré-visualizações para que pressões rápidas do atalho alternem sem mostrar o painel"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Fast Tap delays previews briefly so quick shortcut presses can switch without showing the panel"
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Fast Tap delays previews briefly so quick shortcut presses can switch without showing the panel"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Быстрое нажатие» ненадолго задерживает предпросмотр, чтобы при быстром нажатии сочетания клавиш можно было переключиться, не показывая панель"
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Fast Tap delays previews briefly so quick shortcut presses can switch without showing the panel"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Snabbtryck fördröjer förhandsvisningar en kort stund så att snabba kortkommandotryck kan växla utan att panelen visas"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hızlı Dokunuş, önizlemeleri kısa süre geciktirir, böylece hızlı kısayol basışları paneli göstermeden geçiş yapabilir"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Fast Tap delays previews briefly so quick shortcut presses can switch without showing the panel"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nhấn nhanh sẽ trì hoãn việc xem trước một chút để các phím tắt nhanh có thể chuyển đổi mà không cần hiển thị bảng"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "快速点击会短暂延迟预览，以便快速按下快捷键时可以直接切换而不显示面板"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "快速點擊會短暫延後顯示預覽，讓快速按下快速鍵切換時不會顯示面板"
          }
        }
      }
    },
