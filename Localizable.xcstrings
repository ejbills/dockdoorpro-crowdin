          "stringUnit" : {
            "state" : "new",
            "value" : "Email %@ for help with setup, activation, or DockDoor Pro issues. Include your activation key in the email; support may not be guaranteed without it."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kurulum, etkinleştirme veya DockDoor Pro sorunları için yardım almak üzere %@ adresine e-posta gönderin. E-postaya lisans anahtarınızı ekleyin; lisans olmadan destek sağlanamayabilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Email %@ for help with setup, activation, or DockDoor Pro issues. Include your activation key in the email; support may not be guaranteed without it."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gửi email đến %@ để nhận hỗ trợ về thiết lập, kích hoạt hoặc các sự cố của DockDoor Pro. Vui lòng gửi kèm khóa kích hoạt của bạn trong email; việc hỗ trợ có thể không được đảm bảo nếu thiếu khóa."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如有安装、激活或 DockDoor Pro 相关问题，请发送邮件至 %@ 寻求帮助。请在邮件中附上您的激活码；若未提供，可能无法保证获得支持。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請寄信至 %@ 以取得設定、啟用或 DockDoor Pro 問題協助。請在信中附上啟用金鑰；若未提供，可能無法保證支援。"
          }
        }
      }
    },
