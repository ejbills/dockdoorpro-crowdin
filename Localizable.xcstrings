    "Pinned and running apps share the icon row. Scroll when there are more icons than fit, and use edit mode to reorder pinned items." : {
      "comment" : "Dock anatomy note description",
      "extractionState" : "manual",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Pinned and running apps share the icon row. Scroll when there are more icons than fit, and use edit mode to reorder pinned items."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تتشارك التطبيقات المثبتة والتطبيقات قيد التشغيل صف الأيقونات. مرر عندما يزيد عدد الأيقونات عن المساحة المتاحة، واستخدم وضع التحرير لإعادة ترتيب العناصر المثبتة."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Pinned and running apps share the icon row. Scroll when there are more icons than fit, and use edit mode to reorder pinned items."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Pinned and running apps share the icon row. Scroll when there are more icons than fit, and use edit mode to reorder pinned items."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Pinned and running apps share the icon row. Scroll when there are more icons than fit, and use edit mode to reorder pinned items."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Angeheftete und laufende Apps teilen sich die Symbolreihe. Scrollen Sie, wenn mehr Symbole vorhanden sind als hineinpassen, und verwenden Sie den Bearbeitungsmodus, um angeheftete Objekte neu anzuordnen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Pinned and running apps share the icon row. Scroll when there are more icons than fit, and use edit mode to reorder pinned items."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las apps fijadas y en ejecución comparten la fila de iconos. Desplázate cuando haya más iconos de los que caben y usa el modo de edición para reordenar los elementos fijados."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Pinned and running apps share the icon row. Scroll when there are more icons than fit, and use edit mode to reorder pinned items."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les apps épinglées et actives partagent la rangée d'icônes. Faites défiler quand il y a plus d'icônes que de place, et utilisez le mode d'édition pour réorganiser les éléments épinglés."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Pinned and running apps share the icon row. Scroll when there are more icons than fit, and use edit mode to reorder pinned items."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A kitűzött és a futó appok közös ikonsoron osztoznak. Görgessen, ha több ikon van, mint amennyi elfér, és a szerkesztési módban rendezze át a kitűzött elemeket."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Pinned and running apps share the icon row. Scroll when there are more icons than fit, and use edit mode to reorder pinned items."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ピン留めされたアプリと実行中のアプリはアイコン列を共有します。アイコンが収まりきらないときはスクロールし、編集モードでピン留め項目を並べ替えられます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Pinned and running apps share the icon row. Scroll when there are more icons than fit, and use edit mode to reorder pinned items."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Pinned and running apps share the icon row. Scroll when there are more icons than fit, and use edit mode to reorder pinned items."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vastgezette en actieve apps delen dezelfde rij met pictogrammen. Scroll er doorheen als er meer pictogrammen zijn dan er in de rij passen. Gebruik de bewerkingsmodus om de volgorde van de vastgezette items aan te passen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przypięte i uruchomione aplikacje współdzielą rząd ikon. Przewijaj, gdy ikon jest więcej niż się mieści, i używaj trybu edycji, aby zmieniać kolejność przypiętych elementów."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As aplicações afixadas e em execução partilham a fila de ícones. Desloque quando houver mais ícones do que os que cabem e use o modo de edição para reordenar os itens afixados."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Pinned and running apps share the icon row. Scroll when there are more icons than fit, and use edit mode to reorder pinned items."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Pinned and running apps share the icon row. Scroll when there are more icons than fit, and use edit mode to reorder pinned items."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Закрепленные и запущенные приложения используют один ряд значков. Прокручивайте, если значков больше, чем помещается, и используйте режим редактирования, чтобы изменить порядок закрепленных объектов."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Pinned and running apps share the icon row. Scroll when there are more icons than fit, and use edit mode to reorder pinned items."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fästa appar och appar som körs delar symbolraden. Rulla när symbolerna är fler än vad som får plats, och använd redigeringsläget för att ordna om fästa objekt."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sabitlenmiş ve çalışan uygulamalar simge satırını paylaşır. Sığandan fazla simge olduğunda kaydır ve sabitlenmiş öğeleri yeniden sıralamak için düzenleme modunu kullan."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Pinned and running apps share the icon row. Scroll when there are more icons than fit, and use edit mode to reorder pinned items."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Các ứng dụng được ghim và đang chạy chia sẻ chung một hàng biểu tượng. Cuộn khi có nhiều biểu tượng hơn mức vừa vặn, và sử dụng chế độ chỉnh sửa để sắp xếp lại các mục được ghim."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "固定的应用和运行中的应用共用同一应用行。图标超出可显示范围时可滚动查看，并可通过编辑模式重新排列固定项目。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已釘選與執行中的應用程式共用同一列圖示。當圖示數量超過可顯示範圍時可捲動瀏覽，並可使用編輯模式重新排列已釘選的項目。"
          }
        }
      }
    },
