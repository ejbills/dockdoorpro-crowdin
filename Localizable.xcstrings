    "A column listing every running app, its windows and their actions. Turn it off for a narrower panel." : {
      "comment" : "Control panel section settings description",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "A column listing every running app, its windows and their actions. Turn it off for a narrower panel."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عمود يسرد كل تطبيق قيد التشغيل ونوافذه وإجراءاتها. أوقفه للحصول على لوحة أضيق."
          }
        },
        "ca" : {
          "stringUnit" : {
