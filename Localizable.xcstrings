          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Panel shows a picker above the dock when scrolling. Inline changes the profile icon directly in the dock."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'Paneel' toont een keuzevak boven het Dock tijdens het scrollen. 'Inline' wijzigt het pictogram direct in het Dock."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Panel pokazuje wybierak nad Dockiem podczas przewijania. W miejscu zmienia ikonę profilu bezpośrednio w Docku."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Panel shows a picker above the dock when scrolling. Inline changes the profile icon directly in the dock."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Panel shows a picker above the dock when scrolling. Inline changes the profile icon directly in the dock."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Panel shows a picker above the dock when scrolling. Inline changes the profile icon directly in the dock."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Панель показывает подборку над панелью при прокрутке. В строке меняет значок профиля непосредственно в док - станции."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Panel shows a picker above the dock when scrolling. Inline changes the profile icon directly in the dock."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Panel shows a picker above the dock when scrolling. Inline changes the profile icon directly in the dock."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Panel, kaydırma sırasında dock’un üzerinde bir seçim arayüzü gösterir. “Inline” ise profil simgesini doğrudan dock içinde değiştirir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Panel shows a picker above the dock when scrolling. Inline changes the profile icon directly in the dock."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Panel shows a picker above the dock when scrolling. Inline changes the profile icon directly in the dock."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "面板模式在滚动时于 Dock 上方显示配置选择面板；内联模式则直接在 Dock 中切换配置图标。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「面板」模式會在捲動時於 Dock 上方顯示選擇器；「內嵌」模式則會直接在 Dock 中切換設定檔圖示。"
          }
        }
      }
    },
