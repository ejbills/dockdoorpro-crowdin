    "Widget stacks appear on either side of your app icons. Up to 3 stacks per side. Each stack can hold multiple widgets, scroll to page between them." : {
      "comment" : "Settings control title",
      "extractionState" : "stale",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Widget stacks appear on either side of your app icons. Up to 3 stacks per side. Each stack can hold multiple widgets, scroll to page between them."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ستظهر أكواما لودجت"
          }
        },
        "ca" : {
          "stringUnit" : {
