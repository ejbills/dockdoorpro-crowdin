        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Taille, opacité, contour, reflet et teinte de couleur de l'app des cartes derrière les icônes des apps actives."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "new",
