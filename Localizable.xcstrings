        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "انسخ التطبيقات والمجلدات والملفات من Dock في macOS إلى ملف التعريف النشط ليبدو DockDoor Pro مألوفًا من البداية."
          }
        },
        "ca" : {
