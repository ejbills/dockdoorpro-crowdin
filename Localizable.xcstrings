          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App, die Dateien empfängt, die über den AirDrop-Bereich und Menüs gesendet werden. Wählen Sie eine andere App, um einen Übertragungsdienst wie Blip oder LocalSend zu verwenden."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "App that receives files sent from the AirDrop zone and menus. Choose another app to use a transfer service such as Blip or LocalSend."
