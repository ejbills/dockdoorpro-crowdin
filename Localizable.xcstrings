        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hierdoor wordt het Dock-proces opnieuw gestart. Het beeld kan daarbij kort knipperen. *LET OP*: Het standaard Dock van macOS wordt mogelijk niet hersteld als het DockDoor Pro-proces geforceerd wordt afgesloten of crasht, waardoor het standaard Dock van macOS mogelijk uitgeschakeld blijft."
          }
        },
        "pl" : {
          "stringUnit" : {
