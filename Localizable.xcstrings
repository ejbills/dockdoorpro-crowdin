        "el" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "This is not broad file scanning or message reading. Each app is controlled only for the widget or action you chose, and only while that widget is in your dock."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se trata de un análisis amplio de archivos ni de lectura de mensajes. Cada app se controla solo para el widget o la acción que elegiste, y solo mientras ese widget esté en tu Dock."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "This is not broad file scanning or message reading. Each app is controlled only for the widget or action you chose, and only while that widget is in your dock."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il ne s'agit ni d'une analyse générale des fichiers ni d'une lecture de vos messages. Chaque app n'est contrôlée que pour le widget ou l'action que vous avez choisi, et uniquement tant que ce widget est dans votre dock."
          }
        },
