          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kartenhintergründe hinter Ablageabschnitten anzeigen: Datei-Ablage, Ordner, AirDrop und „Geöffnete Apps“. Deaktivieren Sie dies für eine klarere Ansicht mit höherem Kontrast."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Show the card backgrounds behind shelf sections — File Tray, folders, AirDrop, and Open Apps. Turn off for a cleaner, higher-contrast look."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muestra los fondos de tarjeta detrás de las secciones del estante: bandeja de archivos, carpetas, AirDrop y apps abiertas. Desactívalo para un aspecto más limpio y con mayor contraste."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "new",
