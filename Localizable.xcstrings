    "Star a widget in any stack to set it as the main widget. After scrolling to another widget, the stack will automatically return to the starred one after this delay." : {
      "comment" : "Settings control description",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Star a widget in any stack to set it as the main widget. After scrolling to another widget, the stack will automatically return to the starred one after this delay."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ميّز أداة بنجمة في أي مكدس لتعيينها كأداة رئيسية. بعد التمرير إلى أداة أخرى، سيعود المكدس تلقائيًا إلى الأداة المميزة بنجمة بعد هذا التأخير."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Star a widget in any stack to set it as the main widget. After scrolling to another widget, the stack will automatically return to the starred one after this delay."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Star a widget in any stack to set it as the main widget. After scrolling to another widget, the stack will automatically return to the starred one after this delay."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Star a widget in any stack to set it as the main widget. After scrolling to another widget, the stack will automatically return to the starred one after this delay."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Markieren Sie in einem beliebigen Stapel ein Widget mit einem Stern, um es als Haupt-Widget festzulegen. Nachdem Sie zu einem anderen Widget gescrollt haben, kehrt der Stapel nach dieser Verzögerung automatisch zum markierten Widget zurück."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Star a widget in any stack to set it as the main widget. After scrolling to another widget, the stack will automatically return to the starred one after this delay."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marca con una estrella un widget de cualquier pila para establecerlo como widget principal. Tras desplazarte a otro widget, la pila volverá automáticamente al widget destacado después de este tiempo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Star a widget in any stack to set it as the main widget. After scrolling to another widget, the stack will automatically return to the starred one after this delay."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoutez une étoile à un widget dans n'importe quelle pile pour en faire le widget principal. Après un défilement vers un autre widget, la pile revient automatiquement au widget favori après ce délai."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Star a widget in any stack to set it as the main widget. After scrolling to another widget, the stack will automatically return to the starred one after this delay."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Csillagozzon meg egy widgetet bármelyik kötegben, hogy az legyen a fő widget. Ha másik widgetre görget, a köteg ennyi idő után automatikusan visszatér a csillagozott widgethez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Star a widget in any stack to set it as the main widget. After scrolling to another widget, the stack will automatically return to the starred one after this delay."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "いずれかのスタックでウィジェットにスターを付けると、メインウィジェットに設定されます。別のウィジェットにスクロールした後、この遅延時間が経過するとスタックは自動的にスター付きのウィジェットに戻ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Star a widget in any stack to set it as the main widget. After scrolling to another widget, the stack will automatically return to the starred one after this delay."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Star a widget in any stack to set it as the main widget. After scrolling to another widget, the stack will automatically return to the starred one after this delay."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Markeer een widget met een ster om deze als hoofdwidget in te stellen. Nadat je naar een andere widget bent gescrolld, keert de stapel na deze vertraging automatisch terug naar de widget met de ster."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oznacz widżet gwiazdką w dowolnym stosie, aby ustawić go jako główny. Po przewinięciu do innego widżetu stos automatycznie wróci do oznaczonego po tym opóźnieniu."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marque com estrela um widget em qualquer pilha para o definir como widget principal. Depois de deslocar para outro widget, a pilha volta automaticamente ao widget com estrela após este atraso."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Star a widget in any stack to set it as the main widget. After scrolling to another widget, the stack will automatically return to the starred one after this delay."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Star a widget in any stack to set it as the main widget. After scrolling to another widget, the stack will automatically return to the starred one after this delay."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отметьте виджет в любой стопке, чтобы сделать его основным виджетом. После прокрутки к другому виджету стопка автоматически вернется к отмеченному виджету после этой задержки."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Star a widget in any stack to set it as the main widget. After scrolling to another widget, the stack will automatically return to the starred one after this delay."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stjärnmärk en widget i valfri stack för att göra den till huvudwidget. När du har rullat till en annan widget återgår stacken automatiskt till den stjärnmärkta efter den här fördröjningen."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ana widget olarak ayarlamak için herhangi bir yığındaki bir widget'ı yıldızla. Başka bir widget'a kaydırdıktan sonra yığın, bu gecikmenin ardından otomatik olarak yıldızlı olana geri döner."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Star a widget in any stack to set it as the main widget. After scrolling to another widget, the stack will automatically return to the starred one after this delay."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đánh dấu sao một tiện ích trong bất kỳ ngăn xếp nào để đặt nó làm tiện ích chính. Sau khi cuộn sang tiện ích khác, ngăn xếp sẽ tự động quay trở lại tiện ích đã gắn dấu sao sau khoảng thời gian trì hoãn này."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在任意小组件叠放中将某个小组件设为已收藏，即可将其设为主小组件。切换到其他小组件后，叠放会在此延迟时间后自动切换回已收藏的小组件。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "將任一堆疊中的小工具設為收藏後，即可作為主要小工具。切換至其他小工具後，堆疊會在此延遲時間後自動返回該收藏小工具。"
          }
        }
      }
    },
