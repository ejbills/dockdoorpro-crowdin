    "Launch on Login adds DockDoor Pro as a login item. Hiding the native Dock changes Dock preferences and restarts the Dock process, so the desktop may flash briefly." : {
      "comment" : "Setup permission preflight explanation",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Launch on Login adds DockDoor Pro as a login item. Hiding the native Dock changes Dock preferences and restarts the Dock process, so the desktop may flash briefly."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يضيف «التشغيل عند تسجيل الدخول» DockDoor Pro كعنصر تسجيل دخول. ويغيّر إخفاء Dock الأصلي تفضيلات Dock ويعيد تشغيل عملية Dock، لذا قد يومض سطح المكتب لوهلة."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Launch on Login adds DockDoor Pro as a login item. Hiding the native Dock changes Dock preferences and restarts the Dock process, so the desktop may flash briefly."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Launch on Login adds DockDoor Pro as a login item. Hiding the native Dock changes Dock preferences and restarts the Dock process, so the desktop may flash briefly."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Launch on Login adds DockDoor Pro as a login item. Hiding the native Dock changes Dock preferences and restarts the Dock process, so the desktop may flash briefly."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Bei Anmeldung starten“ fügt DockDoor Pro als Anmeldeobjekt hinzu. Das Ausblenden des systemeigenen Docks ändert Dock-Einstellungen und startet den Dock-Prozess neu, daher kann der Schreibtisch kurz flackern."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Launch on Login adds DockDoor Pro as a login item. Hiding the native Dock changes Dock preferences and restarts the Dock process, so the desktop may flash briefly."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abrir al iniciar sesión añade DockDoor Pro como ítem de inicio. Ocultar el Dock nativo cambia las preferencias del Dock y reinicia su proceso, por lo que el escritorio puede parpadear brevemente."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Launch on Login adds DockDoor Pro as a login item. Hiding the native Dock changes Dock preferences and restarts the Dock process, so the desktop may flash briefly."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'ouverture à la connexion ajoute DockDoor Pro aux éléments d'ouverture de session. Masquer le Dock natif modifie les préférences du Dock et redémarre le processus Dock, le bureau peut donc clignoter brièvement."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Launch on Login adds DockDoor Pro as a login item. Hiding the native Dock changes Dock preferences and restarts the Dock process, so the desktop may flash briefly."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az Indítás bejelentkezéskor bejelentkezési elemként adja hozzá a DockDoor Pro-t. A natív Dock elrejtése módosítja a Dock beállításait, és újraindítja a Dock folyamatát, ezért az íróasztal rövid időre felvillanhat."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Launch on Login adds DockDoor Pro as a login item. Hiding the native Dock changes Dock preferences and restarts the Dock process, so the desktop may flash briefly."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「ログイン時に起動」はDockDoor Proをログイン項目として追加します。標準のDockを非表示にするとDockの設定が変更され、Dockのプロセスが再起動されるため、デスクトップが一瞬ちらつくことがあります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Launch on Login adds DockDoor Pro as a login item. Hiding the native Dock changes Dock preferences and restarts the Dock process, so the desktop may flash briefly."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Launch on Login adds DockDoor Pro as a login item. Hiding the native Dock changes Dock preferences and restarts the Dock process, so the desktop may flash briefly."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Met 'Start bij het inloggen' wordt DockDoor Pro als inlogitem toegevoegd. Als je het standaard Dock van macOS verbergt, worden de Dock-voorkeuren gewijzigd en wordt het Dock-proces opnieuw gestart, waardoor het bureaublad even kan knipperen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otwieranie podczas logowania dodaje DockDoor Pro do rzeczy otwieranych podczas logowania. Ukrycie systemowego Docka zmienia jego ustawienia i ponownie uruchamia proces Dock, więc Biurko może na chwilę mignąć."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abrir ao iniciar sessão adiciona o DockDoor Pro como item de início de sessão. Ocultar a Dock nativa altera as preferências da Dock e reinicia o processo da Dock, pelo que a secretária pode piscar por instantes."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Launch on Login adds DockDoor Pro as a login item. Hiding the native Dock changes Dock preferences and restarts the Dock process, so the desktop may flash briefly."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Launch on Login adds DockDoor Pro as a login item. Hiding the native Dock changes Dock preferences and restarts the Dock process, so the desktop may flash briefly."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Запуск при входе» добавляет DockDoor Pro в объекты входа. Скрытие системного Dock изменяет настройки Dock и перезапускает процесс Dock, поэтому рабочий стол может ненадолго мигнуть."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Launch on Login adds DockDoor Pro as a login item. Hiding the native Dock changes Dock preferences and restarts the Dock process, so the desktop may flash briefly."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öppna vid inloggning lägger till DockDoor Pro som inloggningsobjekt. Att gömma den inbyggda Docken ändrar Dock-inställningarna och startar om Dock-processen, så skrivbordet kan blinka till kort."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oturum Açıldığında Başlat, DockDoor Pro'yu bir oturum açma öğesi olarak ekler. Yerel Dock'u gizlemek Dock tercihlerini değiştirir ve Dock sürecini yeniden başlatır, bu yüzden masaüstü kısa süre yanıp sönebilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Launch on Login adds DockDoor Pro as a login item. Hiding the native Dock changes Dock preferences and restarts the Dock process, so the desktop may flash briefly."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khởi chạy khi đăng nhập sẽ thêm DockDoor Pro làm một mục đăng nhập. Việc ẩn Dock gốc của macOS sẽ thay đổi các tùy chọn của Dock và khởi động lại tiến trình Dock, vì vậy màn hình nền có thể nháy sáng trong chốc lát."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“登录时启动”会将 DockDoor Pro 添加为登录项。隐藏系统 Dock 会修改 Dock 的偏好设置并重新启动 Dock 进程，因此桌面可能会短暂闪烁。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「登入時啟動」會將 DockDoor Pro 加入登入項目。隱藏原生 Dock 會變更 Dock 偏好設定並重新啟動 Dock 程序，因此桌面可能會短暫閃爍。"
          }
        }
      }
    },
