          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El Finder gestiona la Papelera y las acciones de mostrar que elijas. Los widgets Mail y Última nota leen tu número de mensajes sin leer y tu nota más reciente, y los widgets Controles rápidos y Fondo de pantalla usan System Events para cambiar el modo oscuro y el fondo de pantalla. Se pregunta por cada app por separado, la primera vez que un widget la necesita."
          }
        },
        "fi" : {
          "stringUnit" : {
