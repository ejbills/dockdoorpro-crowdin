    "Floating centers the dock. Taskbar spans the full screen width." : {
      "comment" : "Dock style setting description\nSettings search description",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Floating centers the dock. Taskbar spans the full screen width."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يضع «عائم» Dock في المنتصف. ويمتد «شريط المهام» بعرض الشاشة بالكامل."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Floating centers the dock. Taskbar spans the full screen width."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Floating centers the dock. Taskbar spans the full screen width."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Floating centers the dock. Taskbar spans the full screen width."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schwebend zentriert das Dock. Die Taskleiste erstreckt sich über die gesamte Bildschirmbreite."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Floating centers the dock. Taskbar spans the full screen width."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flotante centra el Dock. Barra de tareas ocupa todo el ancho de la pantalla."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Floating centers the dock. Taskbar spans the full screen width."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flottant centre le dock. Barre des tâches s'étend sur toute la largeur de l'écran."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Floating centers the dock. Taskbar spans the full screen width."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A lebegő elrendezés középre helyezi a Dockot. A tálca a képernyő teljes szélességén végigér."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Floating centers the dock. Taskbar spans the full screen width."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "フローティングはDockを中央に配置します。タスクバーは画面の幅いっぱいに広がります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Floating centers the dock. Taskbar spans the full screen width."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Floating centers the dock. Taskbar spans the full screen width."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Met 'Zwevend' wordt het Dock in het midden geplaatst. 'Taakbalk' wordt over de volledige breedte van het scherm weergegeven."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tryb pływający wyśrodkowuje Dock. Pasek zadań rozciąga się na całą szerokość wyświetlacza."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flutuante centra a dock. Barra de tarefas ocupa toda a largura do ecrã."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Floating centers the dock. Taskbar spans the full screen width."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Floating centers the dock. Taskbar spans the full screen width."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Плавающий» размещает Dock по центру. «Панель задач» занимает всю ширину экрана."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Floating centers the dock. Taskbar spans the full screen width."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Svävande centrerar dockan. Aktivitetsfält sträcker sig över hela skärmens bredd."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
