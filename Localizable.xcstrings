        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Håll en dragen fil över en appsymbol för att visa App Exposé och släpp den sedan på ett fönster. Släpper du den på symbolen öppnas filen med appen."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir dosyayı sürükleyip bir uygulama simgesinin üzerinde tut, App Exposé görünsün, ardından bir pencereye bırak. Simgeye bırakmak dosyayı uygulamayla açar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Hold a dragged file over an app icon to show App Exposé, then drop it on a window. Dropping on the icon opens the file with the app."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Giữ một tệp đang được kéo phía trên biểu tượng ứng dụng để hiển thị App Exposé, sau đó thả tệp đó vào một cửa sổ. Thả trực tiếp vào biểu tượng sẽ mở tệp bằng ứng dụng tương ứng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将拖动中的文件悬停在应用图标上，即可显示 App Exposé，然后将文件拖放到某个窗口上。直接拖放到图标上时，会使用该应用打开文件。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "將拖曳中的檔案停留在應用程式圖示上，即可顯示 App Exposé，接著可將檔案放到視窗中。若直接放到應用程式圖示上，則會使用該應用程式開啟檔案。"
          }
        }
      }
    },
