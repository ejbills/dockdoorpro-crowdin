    "Email %@ for help with setup, activation, or DockDoor Pro issues. Include your activation key in the email; support may not be guaranteed without it." : {
      "comment" : "Support settings note",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Email %@ for help with setup, activation, or DockDoor Pro issues. Include your activation key in the email; support may not be guaranteed without it."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "راسل %@ للمساعدة في الإعداد أو التفعيل أو مشكلات DockDoor Pro. أرفق مفتاح التفعيل في رسالتك؛ فقد لا يكون الدعم مضمونًا بدونه."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Email %@ for help with setup, activation, or DockDoor Pro issues. Include your activation key in the email; support may not be guaranteed without it."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Email %@ for help with setup, activation, or DockDoor Pro issues. Include your activation key in the email; support may not be guaranteed without it."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Email %@ for help with setup, activation, or DockDoor Pro issues. Include your activation key in the email; support may not be guaranteed without it."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Senden Sie eine E-Mail an %@, wenn Sie Hilfe bei der Einrichtung, Aktivierung oder bei Problemen mit DockDoor Pro benötigen. Geben Sie Ihren Aktivierungsschlüssel in der E-Mail an; ohne ihn kann Support nicht garantiert werden."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Email %@ for help with setup, activation, or DockDoor Pro issues. Include your activation key in the email; support may not be guaranteed without it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escribe a %@ para recibir ayuda con la configuración, la activación o problemas de DockDoor Pro. Incluye tu clave de activación en el correo; sin ella, el soporte puede no estar garantizado."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Email %@ for help with setup, activation, or DockDoor Pro issues. Include your activation key in the email; support may not be guaranteed without it."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envoyez un e-mail à %@ pour obtenir de l'aide sur les problèmes de configuration, d'activation ou sur l'utilisation de DockDoor Pro. Merci d'inclure votre clé d'activation dans l'e-mail ; le support ne peut pas être garanti sans cette information."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Email %@ for help with setup, activation, or DockDoor Pro issues. Include your activation key in the email; support may not be guaranteed without it."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Írjon e-mailt a(z) %@ címre, ha segítségre van szüksége a beállítással, aktiválással vagy a DockDoor Pro problémáival kapcsolatban. Az e-mailben tüntesse fel az aktiváló kulcsát; enélkül a támogatás nem garantált."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Email %@ for help with setup, activation, or DockDoor Pro issues. Include your activation key in the email; support may not be guaranteed without it."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "セットアップ、アクティベーション、DockDoor Proの問題については%@にメールでお問い合わせください。メールにはアクティベーションキーを記載してください。記載がない場合、サポートを保証できないことがあります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Email %@ for help with setup, activation, or DockDoor Pro issues. Include your activation key in the email; support may not be guaranteed without it."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Email %@ for help with setup, activation, or DockDoor Pro issues. Include your activation key in the email; support may not be guaranteed without it."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "E-mail %@ voor hulp bij installatie, activatie of problemen met DockDoor Pro. Voeg je activatiecode toe aan de e-mail; ondersteuning zonder activatiecode is niet gegarandeerd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Napisz do %@, aby uzyskać pomoc z konfiguracją, aktywacją lub problemami z DockDoor Pro. Dołącz klucz aktywacyjny w wiadomości; bez niego pomoc może nie być gwarantowana."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envie um email para %@ para obter ajuda com a configuração, a ativação ou problemas do DockDoor Pro. Inclua a sua chave de ativação no email; sem ela, o suporte pode não ser garantido."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Email %@ for help with setup, activation, or DockDoor Pro issues. Include your activation key in the email; support may not be guaranteed without it."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Email %@ for help with setup, activation, or DockDoor Pro issues. Include your activation key in the email; support may not be guaranteed without it."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Напишите на %@, чтобы получить помощь с настройкой, активацией или проблемами DockDoor Pro. Укажите в письме свой ключ активации; без него поддержка может быть не гарантирована."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Email %@ for help with setup, activation, or DockDoor Pro issues. Include your activation key in the email; support may not be guaranteed without it."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skicka e-post till %@ för hjälp med konfigurering, aktivering eller DockDoor Pro-problem. Ange din aktiveringsnyckel i mejlet; utan den kan support inte garanteras."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kurulum, etkinleştirme veya DockDoor Pro sorunları için yardım almak üzere %@ adresine e-posta gönderin. E-postaya lisans anahtarınızı ekleyin; lisans olmadan destek sağlanamayabilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Email %@ for help with setup, activation, or DockDoor Pro issues. Include your activation key in the email; support may not be guaranteed without it."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gửi email đến %@ để nhận hỗ trợ về thiết lập, kích hoạt hoặc các sự cố của DockDoor Pro. Vui lòng gửi kèm khóa kích hoạt của bạn trong email; việc hỗ trợ có thể không được đảm bảo nếu thiếu khóa."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如有安装、激活或 DockDoor Pro 相关问题，请发送邮件至 %@ 寻求帮助。请在邮件中附上您的激活码；若未提供，可能无法保证获得支持。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請寄信至 %@ 以取得設定、啟用或 DockDoor Pro 問題協助。請在信中附上啟用金鑰；若未提供，可能無法保證支援。"
          }
        }
      }
    },
