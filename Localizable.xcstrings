    "Shows the input level in wider slots. Needs microphone access and keeps the microphone indicator on while the dock is visible." : {
      "comment" : "Microphone widget option footnote",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Shows the input level in wider slots. Needs microphone access and keeps the microphone indicator on while the dock is visible."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يعرض مستوى الإدخال في الخانات الأعرض. يتطلب الوصول إلى الميكروفون ويُبقي مؤشر الميكروفون مضاءً أثناء ظهور Dock."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Shows the input level in wider slots. Needs microphone access and keeps the microphone indicator on while the dock is visible."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Shows the input level in wider slots. Needs microphone access and keeps the microphone indicator on while the dock is visible."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Shows the input level in wider slots. Needs microphone access and keeps the microphone indicator on while the dock is visible."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeigt den Eingangspegel in breiteren Plätzen. Erfordert Mikrofonzugriff und lässt die Mikrofonanzeige an, solange das Dock sichtbar ist."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Shows the input level in wider slots. Needs microphone access and keeps the microphone indicator on while the dock is visible."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muestra el nivel de entrada en los espacios más anchos. Necesita acceso al micrófono y mantiene encendido el indicador del micrófono mientras el Dock está visible."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Shows the input level in wider slots. Needs microphone access and keeps the microphone indicator on while the dock is visible."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Affiche le niveau d'entrée dans les emplacements plus larges. Nécessite l'accès au micro et garde l'indicateur du micro allumé tant que le dock est visible."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Shows the input level in wider slots. Needs microphone access and keeps the microphone indicator on while the dock is visible."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Szélesebb helyeken megjeleníti a bemeneti szintet. Mikrofon-hozzáférés szükséges, és a mikrofonjelző bekapcsolva marad, amíg a Dock látható."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Shows the input level in wider slots. Needs microphone access and keeps the microphone indicator on while the dock is visible."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "幅の広いスロットでは入力レベルを表示します。マイクへのアクセスが必要で、Dockが表示されている間はマイクのインジケータがオンのままになります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Shows the input level in wider slots. Needs microphone access and keeps the microphone indicator on while the dock is visible."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Shows the input level in wider slots. Needs microphone access and keeps the microphone indicator on while the dock is visible."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toont het invoerniveau in bredere vakken. Vereist toegang tot de microfoon en houdt de microfoonindicator aan zolang het Dock zichtbaar is."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pokazuje poziom wejściowy w szerszych miejscach na widżety. Wymaga dostępu do mikrofonu. Wskaźnik mikrofonu pozostaje włączony, gdy Dock jest widoczny."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra o nível de entrada em espaços mais largos. Requer acesso ao microfone e mantém o indicador do microfone ligado enquanto a Dock estiver visível."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Shows the input level in wider slots. Needs microphone access and keeps the microphone indicator on while the dock is visible."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Shows the input level in wider slots. Needs microphone access and keeps the microphone indicator on while the dock is visible."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Показывает уровень входного сигнала в широких ячейках. Требует доступа к микрофону, а индикатор микрофона горит, пока Dock виден."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Shows the input level in wider slots. Needs microphone access and keeps the microphone indicator on while the dock is visible."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Visar ingångsnivån på bredare platser. Kräver mikrofonåtkomst och håller mikrofonindikatorn tänd medan dockan är synlig."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Daha geniş yuvalarda giriş seviyesini gösterir. Mikrofon erişimi gerektirir ve dock görünürken mikrofon göstergesini açık tutar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Shows the input level in wider slots. Needs microphone access and keeps the microphone indicator on while the dock is visible."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hiển thị mức đầu vào ở các ô rộng hơn. Cần quyền truy cập micrô và giữ chỉ báo micrô luôn bật khi dock hiển thị."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在较宽的区域中显示输入电平。需要麦克风访问权限，且 Dock 可见时麦克风指示器会持续亮起。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在較寬的欄位中顯示輸入音量。需要麥克風存取權限，且 Dock 顯示期間會持續顯示麥克風使用指示器。"
          }
        }
      }
    },
