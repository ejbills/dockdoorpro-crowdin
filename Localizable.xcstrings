        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Панель» показывает переключатель над Dock при прокрутке; «Встроенный» меняет значок прямо в Dock. Применяется к кнопке профиля и переключателю страниц лотка файлов"
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Panel shows a picker above the dock when scrolling; Inline changes the icon directly in the dock. Applies to the profile button and the file tray page switcher"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Panel visar en väljare ovanför docken när du rullar; Infogad ändrar symbolen direkt i docken. Gäller profilknappen och filbrickans sidväxlare"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Panel, kaydırırken dock'un üstünde bir seçici gösterir; Satır İçi ise simgeyi doğrudan dock'ta değiştirir. Profil düğmesi ve dosya tepsisi sayfa değiştiricisi için geçerlidir"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Panel shows a picker above the dock when scrolling; Inline changes the icon directly in the dock. Applies to the profile button and the file tray page switcher"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tùy chọn Bảng hiển thị một bộ chọn phía trên dock khi cuộn; tùy chọn Cùng dòng thay đổi trực tiếp biểu tượng ngay trong dock. Áp dụng cho nút hồ sơ và bộ chuyển đổi trang của khay tệp"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "滚动时，面板模式在 Dock 上方显示选择器；内联模式直接切换 Dock 中的图标。此设置适用于配置文件按钮和文件托盘页面切换器"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「面板」模式會在捲動時於 Dock 上方顯示選擇器；「內嵌」模式則會直接在 Dock 中切換圖示。此設定適用於設定檔按鈕和檔案托盤頁面切換器"
          }
        }
      }
    },
