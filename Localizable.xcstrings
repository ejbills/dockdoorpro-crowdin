            "value" : "Some setup choices affect macOS behavior, such as Launch on Login or hiding the native Dock."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Some setup choices affect macOS behavior, such as Launch on Login or hiding the native Dock."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
