    "Open Apps shows your running apps. Long-press an app to see its window previews (controlled by the dock's Window Previews setting)." : {
      "comment" : "Open Apps settings note",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Open Apps shows your running apps. Long-press an app to see its window previews (controlled by the dock's Window Previews setting)."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعرض صفحة التطبيقات المفتوحة تطبيقاتك قيد التشغيل. اضغط مطولًا على تطبيق لرؤية معاينات نوافذه (يتحكم بها إعداد معاينات النوافذ في Dock)."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Open Apps shows your running apps. Long-press an app to see its window previews (controlled by the dock's Window Previews setting)."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Open Apps shows your running apps. Long-press an app to see its window previews (controlled by the dock's Window Previews setting)."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Open Apps shows your running apps. Long-press an app to see its window previews (controlled by the dock's Window Previews setting)."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Geöffnete Apps“ zeigt Ihre laufenden Apps. Halten Sie eine App länger gedrückt, um ihre Fenstervorschauen anzuzeigen (gesteuert über die Dock-Einstellung „Fenstervorschauen“)."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "new",
