    "Record a key or modifier to cycle backward. Until one is set, Shift with the switcher key cycles backward." : {
      "comment" : "Back key disabled help",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Record a key or modifier to cycle backward. Until one is set, Shift with the switcher key cycles backward."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سجّل مفتاحًا أو مفتاح تعديل للتنقل للخلف. إلى أن يتم تعيينه، يتنقل Shift مع مفتاح المبدّل للخلف."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Record a key or modifier to cycle backward. Until one is set, Shift with the switcher key cycles backward."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Record a key or modifier to cycle backward. Until one is set, Shift with the switcher key cycles backward."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Record a key or modifier to cycle backward. Until one is set, Shift with the switcher key cycles backward."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nehmen Sie eine Taste oder Sondertaste zum Rückwärtswechseln auf. Bis eine festgelegt ist, wechselt die Umschalttaste zusammen mit der Wechslertaste rückwärts."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Record a key or modifier to cycle backward. Until one is set, Shift with the switcher key cycles backward."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Graba una tecla o un modificador para recorrer hacia atrás. Mientras no haya uno definido, Mayúsculas con la tecla del selector recorre hacia atrás."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Record a key or modifier to cycle backward. Until one is set, Shift with the switcher key cycles backward."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enregistrez une touche ou un modificateur pour parcourir en arrière. Tant qu'aucune n'est définie, Maj avec la touche du sélecteur parcourt en arrière."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Record a key or modifier to cycle backward. Until one is set, Shift with the switcher key cycles backward."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rögzítsen egy billentyűt vagy módosítót a visszafelé léptetéshez. Amíg nincs beállítva, a Shift és a váltóbillentyű együtt léptet visszafelé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Record a key or modifier to cycle backward. Until one is set, Shift with the switcher key cycles backward."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "逆方向に切り替えるキーまたは修飾キーを記録してください。設定するまでは、Shiftとスイッチャーキーで逆方向に切り替わります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Record a key or modifier to cycle backward. Until one is set, Shift with the switcher key cycles backward."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Record a key or modifier to cycle backward. Until one is set, Shift with the switcher key cycles backward."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leg een toets of modificatietoets vast om terug te bladeren. Zolang er geen is ingesteld, blader je terug met Shift en de wisseltoets."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ustaw klawisz lub klawisz modyfikujący do przełączania wstecz. Dopóki go nie ustawisz, Shift w połączeniu z klawiszem przełącznika będzie przełączać wstecz."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grave uma tecla ou modificador para recuar. Até definir uma, Shift com a tecla do alternador recua."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Record a key or modifier to cycle backward. Until one is set, Shift with the switcher key cycles backward."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Record a key or modifier to cycle backward. Until one is set, Shift with the switcher key cycles backward."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Запишите клавишу или модификатор для перебора в обратном порядке. Пока она не задана, для этого используется Shift с клавишей переключателя."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Record a key or modifier to cycle backward. Until one is set, Shift with the switcher key cycles backward."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spela in en tangent eller modifierare för att bläddra bakåt. Tills en har ställts in bläddrar Skift tillsammans med växlartangenten bakåt."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geriye doğru dolaşmak için bir tuş veya değiştirici kaydet. Bir tane ayarlanana kadar, değiştirici tuşla Shift geriye doğru dolaşır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Record a key or modifier to cycle backward. Until one is set, Shift with the switcher key cycles backward."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ghi lại một phím hoặc phím bổ trợ để xoay vòng ngược lại. Cho đến khi được thiết lập, tổ hợp phím Shift cùng với phím chuyển đổi sẽ thực hiện thao tác xoay vòng ngược lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "录制一个按键或修饰键来反向切换。在尚未设定前，可使用 Shift 键搭配切换键来反向切换。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "錄製一個按鍵或修飾鍵來反向切換。在尚未設定前，可使用 Shift 鍵搭配切換鍵來反向切換。"
          }
        }
      }
    },
