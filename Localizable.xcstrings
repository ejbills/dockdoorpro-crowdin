    "Float live window previews above the highlighted app while you hold ⌘-Tab. Glance rides along with the built-in macOS switcher, unlike the Alt Tab Window Switcher." : {
      "comment" : "Settings control description",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Float live window previews above the highlighted app while you hold ⌘-Tab. Glance rides along with the built-in macOS switcher, unlike the Alt Tab Window Switcher."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عرض معاينات حية للنوافذ فوق التطبيق المحدد أثناء الضغط المستمر على ⌘-Tab. يعمل Glance جنبًا إلى جنب مع مبدّل macOS المدمج، على عكس مبدّل نوافذ Alt Tab."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Float live window previews above the highlighted app while you hold ⌘-Tab. Glance rides along with the built-in macOS switcher, unlike the Alt Tab Window Switcher."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Float live window previews above the highlighted app while you hold ⌘-Tab. Glance rides along with the built-in macOS switcher, unlike the Alt Tab Window Switcher."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Float live window previews above the highlighted app while you hold ⌘-Tab. Glance rides along with the built-in macOS switcher, unlike the Alt Tab Window Switcher."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Live-Fenstervorschauen schweben über der hervorgehobenen App, solange Sie ⌘-Tab gedrückt halten. Glance folgt dabei dem integrierten macOS-Umschalter, anders als der Alt-Tab-Fensterwechsler."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Float live window previews above the highlighted app while you hold ⌘-Tab. Glance rides along with the built-in macOS switcher, unlike the Alt Tab Window Switcher."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muestra previsualizaciones de ventanas en directo sobre la app resaltada mientras mantienes ⌘-Tab. Glance acompaña al selector integrado de macOS, a diferencia del selector de ventanas Alt Tab."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Float live window previews above the highlighted app while you hold ⌘-Tab. Glance rides along with the built-in macOS switcher, unlike the Alt Tab Window Switcher."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Affiche des aperçus de fenêtre en direct au-dessus de l'app en surbrillance pendant que vous maintenez ⌘-Tab. Glance accompagne le sélecteur macOS intégré, contrairement au sélecteur de fenêtres Alt-Tab."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Float live window previews above the highlighted app while you hold ⌘-Tab. Glance rides along with the built-in macOS switcher, unlike the Alt Tab Window Switcher."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Élő ablak-előnézetek lebegtetése a kiemelt app fölött, amíg a ⌘-Tab lenyomva van. A Glance a beépített macOS-váltóval együtt működik, ellentétben az Alt-Tab ablakváltóval."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Float live window previews above the highlighted app while you hold ⌘-Tab. Glance rides along with the built-in macOS switcher, unlike the Alt Tab Window Switcher."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⌘-Tabを押している間、ハイライトされたアプリの上にライブのウインドウプレビューを表示します。GlanceはAlt Tabウインドウスイッチャーとは異なり、macOS標準のスイッチャーと連動します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Float live window previews above the highlighted app while you hold ⌘-Tab. Glance rides along with the built-in macOS switcher, unlike the Alt Tab Window Switcher."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Float live window previews above the highlighted app while you hold ⌘-Tab. Glance rides along with the built-in macOS switcher, unlike the Alt Tab Window Switcher."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laat live venstervoorbeelden boven de gemarkeerde app zweven terwijl je ⌘-Tab ingedrukt houdt. Glance werkt samen met de ingebouwde macOS-wisselaar, in tegenstelling tot de Alt Tab-vensterwisselaar."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pokazuj podglądy okien na żywo nad wyróżnioną aplikacją podczas przytrzymywania ⌘-Tab. Glance współpracuje z systemowym przełącznikiem macOS, w przeciwieństwie do Przełącznika okien Alt-Tab."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra pré-visualizações de janelas em tempo real sobre a app destacada enquanto mantém ⌘-Tab premido. O Glance acompanha o seletor integrado do macOS, ao contrário do Alternador de Janelas Alt-Tab."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Float live window previews above the highlighted app while you hold ⌘-Tab. Glance rides along with the built-in macOS switcher, unlike the Alt Tab Window Switcher."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Float live window previews above the highlighted app while you hold ⌘-Tab. Glance rides along with the built-in macOS switcher, unlike the Alt Tab Window Switcher."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Показывать живые предпросмотры окон над выделенным приложением, пока удерживаете ⌘-Tab. Glance встраивается во встроенный переключатель macOS, в отличие от Alt Tab Window Switcher."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Float live window previews above the highlighted app while you hold ⌘-Tab. Glance rides along with the built-in macOS switcher, unlike the Alt Tab Window Switcher."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Låt fönsterförhandsvisningar i realtid sväva ovanför den markerade appen medan du håller in ⌘-Tab. Glance följer med den inbyggda macOS-växlaren, till skillnad från Alt Tab-fönsterväxlaren."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⌘-Tab'a basılı tutarken canlı pencere önizlemelerini vurgulanan uygulamanın üzerinde süzdür. Glance, Alt Tab Pencere Değiştirici'nin aksine yerleşik macOS değiştiricisiyle birlikte çalışır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Float live window previews above the highlighted app while you hold ⌘-Tab. Glance rides along with the built-in macOS switcher, unlike the Alt Tab Window Switcher."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hiển thị nổi bản xem trước cửa sổ trực tiếp phía trên ứng dụng được tô sáng khi bạn giữ ⌘-Tab. Glance hoạt động song hành cùng bộ chuyển đổi mặc định của macOS, khác với Bộ chuyển đổi cửa sổ Alt Tab."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按住 ⌘-Tab 时，在当前高亮应用上方显示实时窗口预览。Glance 基于 macOS 内置的应用切换器运行，不同于 Alt Tab 窗口切换器。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按住 ⌘-Tab 時，在目前反白的應用程式上方顯示即時視窗預覽。Glance 會搭配 macOS 內建的應用程式切換器運作，不同於 Alt-Tab 視窗切換器。"
          }
        }
      }
    },
