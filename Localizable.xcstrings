    "Local widget bundles run unverified code. Only install bundles you built or trust." : {
      "comment" : "Local widget security warning",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Local widget bundles run unverified code. Only install bundles you built or trust."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تشغّل حزم الأدوات المحلية تعليمات برمجية غير موثّقة. لا تثبّت إلا الحزم التي أنشأتها أو تثق بها."
          }
        },
