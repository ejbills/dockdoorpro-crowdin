    "Windows from these apps lead the switcher in this order. Drag to reorder." : {
      "comment" : "Settings control description",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Windows from these apps lead the switcher in this order. Drag to reorder."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تتصدر نوافذ هذه التطبيقات المبدّل بهذا الترتيب. اسحب لإعادة الترتيب."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Windows from these apps lead the switcher in this order. Drag to reorder."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Windows from these apps lead the switcher in this order. Drag to reorder."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Windows from these apps lead the switcher in this order. Drag to reorder."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fenster dieser Apps stehen in dieser Reihenfolge am Anfang des Fensterwechslers. Zum Neuanordnen ziehen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Windows from these apps lead the switcher in this order. Drag to reorder."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las ventanas de estas apps encabezan el selector en este orden. Arrastra para reordenar."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Windows from these apps lead the switcher in this order. Drag to reorder."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les fenêtres de ces apps apparaissent en tête du sélecteur dans cet ordre. Faites glisser pour réorganiser."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Windows from these apps lead the switcher in this order. Drag to reorder."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ezeknek az appoknak az ablakai vezetik a váltót, ebben a sorrendben. Húzással rendezhet át."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Windows from these apps lead the switcher in this order. Drag to reorder."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これらのアプリのウインドウが、この順序でスイッチャーの先頭に表示されます。ドラッグして並べ替えます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Windows from these apps lead the switcher in this order. Drag to reorder."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Windows from these apps lead the switcher in this order. Drag to reorder."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vensters van deze apps staan in deze volgorde vooraan in de wisselaar. Sleep om de volgorde te wijzigen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Okna tych aplikacji są wyświetlane na początku przełącznika w tej kolejności. Przeciągnij, aby zmienić kolejność."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As janelas destas apps aparecem primeiro no alternador, por esta ordem. Arraste para reordenar."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Windows from these apps lead the switcher in this order. Drag to reorder."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Windows from these apps lead the switcher in this order. Drag to reorder."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Окна этих приложений идут первыми в переключателе в этом порядке. Перетаскивайте, чтобы изменить порядок."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Windows from these apps lead the switcher in this order. Drag to reorder."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fönster från de här apparna visas först i växlaren i den här ordningen. Dra för att ändra ordning."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu uygulamaların pencereleri değiştiricide bu sırayla başta yer alır. Yeniden sıralamak için sürükle."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Windows from these apps lead the switcher in this order. Drag to reorder."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cửa sổ của các ứng dụng này đứng đầu bộ chuyển đổi theo thứ tự này. Kéo để sắp xếp lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
