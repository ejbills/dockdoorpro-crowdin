          }
        }
      }
    },
    "Windows of these apps are never resized. Use this for apps that force their own window size and would otherwise be resized repeatedly." : {
      "comment" : "Settings control description",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Windows of these apps are never resized. Use this for apps that force their own window size and would otherwise be resized repeatedly."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يتم أبدًا تغيير حجم نوافذ هذه التطبيقات. استخدم هذا للتطبيقات التي تفرض حجم نوافذها الخاص والتي كان سيتغير حجمها مرارًا بخلاف ذلك."
          }
        },
        "ca" : {
          "stringUnit" : {
