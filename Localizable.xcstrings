    "Liquid Glass uses the macOS 26 glass effect. Frosted uses a blur material. Solid uses a full opacity color. Clear removes the background entirely." : {
      "comment" : "Settings control description",
      "extractionState" : "stale",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Liquid Glass uses the macOS 26 glass effect. Frosted uses a blur material. Solid uses a full opacity color. Clear removes the background entirely."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يستخدم الزجاج السائل تأثير زجاج macOS 26. يستخدم الزجاج الملطخ مادة ضبابية. يستخدم الصلب لون التعتيم الكامل. إزالة الخلفية بالكامل."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Liquid Glass uses the macOS 26 glass effect. Frosted uses a blur material. Solid uses a full opacity color. Clear removes the background entirely."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Liquid Glass uses the macOS 26 glass effect. Frosted uses a blur material. Solid uses a full opacity color. Clear removes the background entirely."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Liquid Glass uses the macOS 26 glass effect. Frosted uses a blur material. Solid uses a full opacity color. Clear removes the background entirely."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liquid Glass verwendet den Glaseffekt von macOS 26. Milchglas nutzt ein Weichzeichnungsmaterial. Einfarbig nutzt eine vollständig deckende Farbe. Transparent entfernt den Hintergrund vollständig."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Liquid Glass uses the macOS 26 glass effect. Frosted uses a blur material. Solid uses a full opacity color. Clear removes the background entirely."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Liquid Glass uses the macOS 26 glass effect. Frosted uses a blur material. Solid uses a full opacity color. Clear removes the background entirely."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Liquid Glass uses the macOS 26 glass effect. Frosted uses a blur material. Solid uses a full opacity color. Clear removes the background entirely."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liquid Glass utilise l'effet verre de macOS 26. Givré utilise un effet de flou. Opaque utilise une couleur pleine. Transparent supprime entièrement l'arrière-plan."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Liquid Glass uses the macOS 26 glass effect. Frosted uses a blur material. Solid uses a full opacity color. Clear removes the background entirely."
          }
        },
        "hu" : {
          "stringUnit" : {
