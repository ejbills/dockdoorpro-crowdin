    "DockDoor Pro does not record video or send screenshots anywhere. Without this, previews can fall back to compact text-only rows." : {
      "comment" : "Setup permission preflight reassurance",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "DockDoor Pro does not record video or send screenshots anywhere. Without this, previews can fall back to compact text-only rows."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يسجل DockDoor Pro فيديو ولا يرسل لقطات شاشة إلى أي مكان. بدون هذا الإذن، قد تتحول المعاينات إلى صفوف نصية مضغوطة فقط."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "DockDoor Pro does not record video or send screenshots anywhere. Without this, previews can fall back to compact text-only rows."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "DockDoor Pro does not record video or send screenshots anywhere. Without this, previews can fall back to compact text-only rows."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "DockDoor Pro does not record video or send screenshots anywhere. Without this, previews can fall back to compact text-only rows."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DockDoor Pro zeichnet keine Videos auf und sendet keine Bildschirmfotos. Ohne diese Berechtigung können Vorschauen auf kompakte Nur-Text-Zeilen ausweichen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "DockDoor Pro does not record video or send screenshots anywhere. Without this, previews can fall back to compact text-only rows."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DockDoor Pro no graba vídeo ni envía capturas de pantalla a ningún sitio. Sin este permiso, las previsualizaciones pueden mostrarse como filas compactas de solo texto."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "DockDoor Pro does not record video or send screenshots anywhere. Without this, previews can fall back to compact text-only rows."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DockDoor Pro n'enregistre aucune vidéo et n'envoie aucune capture d'écran. Sans cela, les aperçus peuvent se rabattre sur des rangées compactes en texte seul."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "DockDoor Pro does not record video or send screenshots anywhere. Without this, previews can fall back to compact text-only rows."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A DockDoor Pro nem rögzít videót, és nem küld képernyőképeket sehová. Enélkül az előnézetek kompakt, csak szöveges sorokra válthatnak."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "DockDoor Pro does not record video or send screenshots anywhere. Without this, previews can fall back to compact text-only rows."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DockDoor Proがビデオを録画したり、スクリーンショットを外部に送信したりすることはありません。この権限がない場合、プレビューはテキストのみのコンパクトな表示になることがあります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "DockDoor Pro does not record video or send screenshots anywhere. Without this, previews can fall back to compact text-only rows."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "DockDoor Pro does not record video or send screenshots anywhere. Without this, previews can fall back to compact text-only rows."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DockDoor Pro neemt geen video op en verstuurt nergens schermafbeeldingen naartoe. Zonder deze machtiging worden voorbeelden mogelijk weergegeven als compacte rijen met alleen tekst."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DockDoor Pro nie nagrywa wideo ani nie wysyła zrzutów ekranu. Bez tego podglądy mogą wrócić do kompaktowych wierszy tylko z tekstem."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O DockDoor Pro não grava vídeo nem envia capturas de ecrã para lado nenhum. Sem esta permissão, as pré-visualizações podem passar a linhas compactas só de texto."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "DockDoor Pro does not record video or send screenshots anywhere. Without this, previews can fall back to compact text-only rows."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "DockDoor Pro does not record video or send screenshots anywhere. Without this, previews can fall back to compact text-only rows."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DockDoor Pro не записывает видео и не отправляет скриншоты. Без этого предпросмотры могут переключаться на компактные строки только с текстом."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "DockDoor Pro does not record video or send screenshots anywhere. Without this, previews can fall back to compact text-only rows."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DockDoor Pro spelar inte in video och skickar inte skärmavbilder någonstans. Utan detta kan förhandsvisningar falla tillbaka till kompakta rader med enbart text."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DockDoor Pro video kaydetmez veya ekran görüntülerini hiçbir yere göndermez. Bu olmadan önizlemeler yalnızca metinli kompakt satırlara dönebilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "DockDoor Pro does not record video or send screenshots anywhere. Without this, previews can fall back to compact text-only rows."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DockDoor Pro không ghi lại video hoặc gửi ảnh chụp màn hình đi bất cứ đâu. Nếu không có quyền này, bản xem trước có thể phải chuyển về hiển thị các hàng văn bản thu gọn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DockDoor Pro 不会录制视频，也不会将屏幕截图发送到任何地方。没有此权限时，预览将回退为仅显示文本的紧凑列表。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DockDoor Pro 不會錄製畫面，也不會將螢幕截圖傳送至任何地方。若未啟用此功能，預覽可能會改以精簡的純文字列顯示。"
          }
        }
      }
    },
    "DockDoor Pro has separate regions for profiles, widgets, apps, Trash, and files. Each region scrolls or reacts differently." : {
