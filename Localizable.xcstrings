            "value" : "Card size, opacity, outline, glimmer, and app-color tint behind running app icons."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaartgrootte, dekking, omlijning, glinstering en app-kleurtint achter pictogrammen van actieve apps."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
