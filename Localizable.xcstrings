    "Card mode shows a background behind running apps. Focused apps are highlighted, while hidden or minimized apps appear dimmed." : {
      "extractionState" : "stale",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Card mode shows a background behind running apps. Focused apps are highlighted, while hidden or minimized apps appear dimmed."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يظهر وضع البطاقة خلفية خلف تشغيل التطبيقات. يتم تسليط الضوء على التطبيقات المركزة في حين تظهر التطبيقات المخفية أو المصغرة بشكل غير ثابت."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Card mode shows a background behind running apps. Focused apps are highlighted, while hidden or minimized apps appear dimmed."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Card mode shows a background behind running apps. Focused apps are highlighted, while hidden or minimized apps appear dimmed."
