    "Apps inside an app group still appear in the running-apps section while they have open windows, so you can reach them in one click instead of opening the group first." : {
      "comment" : "Settings control description",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Apps inside an app group still appear in the running-apps section while they have open windows, so you can reach them in one click instead of opening the group first."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تظل التطبيقات داخل مجموعة التطبيقات ظاهرة في قسم التطبيقات قيد التشغيل ما دامت لديها نوافذ مفتوحة، لتصل إليها بنقرة واحدة بدلًا من فتح المجموعة أولًا."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Apps inside an app group still appear in the running-apps section while they have open windows, so you can reach them in one click instead of opening the group first."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Apps inside an app group still appear in the running-apps section while they have open windows, so you can reach them in one click instead of opening the group first."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Apps inside an app group still appear in the running-apps section while they have open windows, so you can reach them in one click instead of opening the group first."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apps in einer App-Gruppe werden weiterhin im Bereich für laufende Apps angezeigt, solange sie geöffnete Fenster haben. So erreichen Sie sie mit einem Klick, ohne zuerst die Gruppe öffnen zu müssen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Apps inside an app group still appear in the running-apps section while they have open windows, so you can reach them in one click instead of opening the group first."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las apps dentro de un grupo de apps siguen apareciendo en la sección de apps en ejecución mientras tienen ventanas abiertas, para que puedas acceder a ellas con un clic en lugar de abrir primero el grupo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Apps inside an app group still appear in the running-apps section while they have open windows, so you can reach them in one click instead of opening the group first."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les apps d'un groupe d'apps restent visibles dans la section des apps actives tant qu'elles ont des fenêtres ouvertes, pour les atteindre en un clic sans devoir ouvrir le groupe."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Apps inside an app group still appear in the running-apps section while they have open windows, so you can reach them in one click instead of opening the group first."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az appcsoportban lévő appok továbbra is megjelennek a futó appok szakaszban, amíg van nyitott ablakuk, így egy kattintással elérheti őket a csoport megnyitása nélkül."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Apps inside an app group still appear in the running-apps section while they have open windows, so you can reach them in one click instead of opening the group first."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アプリグループ内のアプリも、ウインドウを開いている間は実行中のアプリのセクションに表示されるため、グループを開かなくてもワンクリックでアクセスできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Apps inside an app group still appear in the running-apps section while they have open windows, so you can reach them in one click instead of opening the group first."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Apps inside an app group still appear in the running-apps section while they have open windows, so you can reach them in one click instead of opening the group first."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apps binnen een app-groep blijven in het gedeelte met actieve apps verschijnen zolang er vensters van openstaan, zodat je ze met één klik kunt openen in plaats van eerst de groep te moeten openen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplikacje znajdujące się w grupie aplikacji nadal będą wyświetlane w sekcji uruchomionych aplikacji, jeśli mają otwarte okna. Dzięki temu możesz przejść do nich jednym kliknięciem, bez konieczności najpierw otwierania grupy."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As aplicações dentro de um grupo continuam a aparecer na secção de aplicações em execução enquanto tiverem janelas abertas, para que possa aceder-lhes com um clique em vez de abrir primeiro o grupo."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Apps inside an app group still appear in the running-apps section while they have open windows, so you can reach them in one click instead of opening the group first."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Apps inside an app group still appear in the running-apps section while they have open windows, so you can reach them in one click instead of opening the group first."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Приложения, входящие в группу, по-прежнему отображаются в разделе запущенных программ, пока у них открыты окна; благодаря этому их можно открыть одним щелчком, не открывая предварительно саму группу."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Apps inside an app group still appear in the running-apps section while they have open windows, so you can reach them in one click instead of opening the group first."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appar i en appgrupp visas fortfarande i sektionen för appar som körs medan de har öppna fönster, så att du kan nå dem med ett klick istället för att först öppna gruppen."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir uygulama grubunun içindeki uygulamalar, pencereleri açıkken bile çalışan uygulamalar bölümünde görünmeye devam eder; böylece grubu önce açmanıza gerek kalmadan tek bir tıklamayla bunlara ulaşabilirsiniz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Apps inside an app group still appear in the running-apps section while they have open windows, so you can reach them in one click instead of opening the group first."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Các ứng dụng bên trong một nhóm ứng dụng vẫn xuất hiện trong phần ứng dụng đang chạy khi chúng có cửa sổ đang mở, vì vậy bạn có thể tiếp cận chúng bằng một cú nhấp chuột thay vì phải mở nhóm trước."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "应用组中的应用在有打开的窗口时，仍会显示在“运行中的应用”区域，这样无需先打开应用组，即可一键访问。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "應用程式群組內的應用程式在有開啟視窗時，仍會顯示在執行中應用程式區域，因此您可以直接按一下進入，無需先開啟該群組。"
          }
        }
      }
    },
