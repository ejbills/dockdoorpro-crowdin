          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Spalte mit allen laufenden Apps, ihren Fenstern und deren Aktionen. Deaktivieren Sie sie für ein schmaleres Panel."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "new",
