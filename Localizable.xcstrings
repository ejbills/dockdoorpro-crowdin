    "Hold %@ and press a letter to jump to matching running apps. Press the same letter to cycle through matches." : {
      "comment" : "Settings control description",
      "extractionState" : "manual",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Hold %@ and press a letter to jump to matching running apps. Press the same letter to cycle through matches."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اضغط على %@ واضغط على رسالة للقفز إلى مطابقة التطبيقات قيد التشغيل. اضغط على نفس الحرف إلى الدورة من خلال المطابقات."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Hold %@ and press a letter to jump to matching running apps. Press the same letter to cycle through matches."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "new",
