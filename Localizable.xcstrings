          "stringUnit" : {
            "state" : "translated",
            "value" : "Installeer community widgets rechtstreeks vanuit de marketplace. Widgets worden getoond in je Dock. Widgetupdatess hebben mogelijk een herstart van de app nodig om correct te werken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Instaluj widżety społeczności bezpośrednio z Marketplace. Widżety działają bezpośrednio w Docku. Pełne zastosowanie uaktualnień widżetów może wymagać ponownego uruchomienia aplikacji."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Install community widgets directly from the marketplace. Widgets run natively in your dock. Widget updates may require a restart of the app to fully take effect."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Install community widgets directly from the marketplace. Widgets run natively in your dock. Widget updates may require a restart of the app to fully take effect."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "new",
