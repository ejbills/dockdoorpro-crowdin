          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En kolumn som listar alla appar som körs, deras fönster och fönstrens åtgärder. Stäng av den för en smalare panel."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Çalışmakta olan tüm uygulamaları, pencerelerini ve bu pencerelerde gerçekleştirilen işlemleri listeleyen bir sütun. Paneli daha dar hale getirmek için bu özelliği kapatın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "A column listing every running app, its windows and their actions. Turn it off for a narrower panel."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Một cột liệt kê mọi ứng dụng đang chạy, các cửa sổ và tác vụ của chúng. Tắt để có bảng hẹp hơn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在单独一栏中列出所有运行中的应用、各应用的窗口及其操作。关闭此选项可缩窄面板。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "列出所有執行中的應用程式、其視窗及對應動作的欄位。關閉此選項可縮小面板。"
          }
        }
      }
    },
