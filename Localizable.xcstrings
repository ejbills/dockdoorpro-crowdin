    "Native Dock keeps app icons central with Trash after apps. Minimal Dock hides widget stacks but keeps hover previews and running-app cleanup." : {
      "comment" : "Dock anatomy preset note",
      "extractionState" : "manual",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Native Dock keeps app icons central with Trash after apps. Minimal Dock hides widget stacks but keeps hover previews and running-app cleanup."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يُبقي «Dock الأصلي» أيقونات التطبيقات في الوسط مع المهملات بعد التطبيقات. ويخفي «Dock البسيط» مكدسات الأدوات لكنه يحتفظ بمعاينات تمرير المؤشر وتنظيم التطبيقات قيد التشغيل."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Native Dock keeps app icons central with Trash after apps. Minimal Dock hides widget stacks but keeps hover previews and running-app cleanup."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Native Dock keeps app icons central with Trash after apps. Minimal Dock hides widget stacks but keeps hover previews and running-app cleanup."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Native Dock keeps app icons central with Trash after apps. Minimal Dock hides widget stacks but keeps hover previews and running-app cleanup."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Natives Dock zentriert App-Symbole und platziert den Papierkorb nach den Apps. Minimales Dock blendet Widget-Stapel aus, behält aber Hover-Vorschauen und die Bereinigung laufender Apps bei."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Native Dock keeps app icons central with Trash after apps. Minimal Dock hides widget stacks but keeps hover previews and running-app cleanup."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dock nativo mantiene los iconos de apps centrados con la Papelera después de las apps. Dock mínimo oculta las pilas de widgets pero conserva las previsualizaciones al pasar el puntero y la limpieza de apps en ejecución."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Native Dock keeps app icons central with Trash after apps. Minimal Dock hides widget stacks but keeps hover previews and running-app cleanup."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dock natif garde les icônes d'apps au centre avec la Corbeille après les apps. Dock minimal masque les piles de widgets mais conserve les aperçus au survol et le nettoyage des apps actives."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Native Dock keeps app icons central with Trash after apps. Minimal Dock hides widget stacks but keeps hover previews and running-app cleanup."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Natív Dock az app-ikonokat középen tartja, a Kuka az appok után következik. A Minimál Dock elrejti a widgetkötegeket, de megtartja a rámutatási előnézeteket és a futó appok rendezését."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Native Dock keeps app icons central with Trash after apps. Minimal Dock hides widget stacks but keeps hover previews and running-app cleanup."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「標準のDock」はアプリアイコンを中央に置き、ゴミ箱をアプリの後に配置します。「ミニマルDock」はウィジェットスタックを非表示にしますが、ホバープレビューと起動中のアプリの整理は維持します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Native Dock keeps app icons central with Trash after apps. Minimal Dock hides widget stacks but keeps hover previews and running-app cleanup."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Native Dock keeps app icons central with Trash after apps. Minimal Dock hides widget stacks but keeps hover previews and running-app cleanup."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Standaard Dock plaatst app-pictogrammen centraal, met de prullenmand achter de apps. Minimale Dock verbergt widgetstapels, maar behoudt de voorbeelden bij het aanwijzen en het opschonen van geopende apps."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Systemowy Dock umieszcza ikony aplikacji pośrodku, a Kosz za aplikacjami. Minimalny Dock ukrywa stosy widżetów, ale zachowuje podglądy po wskazaniu i porządkowanie uruchomionych aplikacji."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Dock Nativa mantém os ícones das aplicações ao centro, com o Lixo depois das aplicações. A Dock Mínima oculta as pilhas de widgets, mas mantém as pré-visualizações ao passar o cursor e a limpeza das aplicações em execução."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Native Dock keeps app icons central with Trash after apps. Minimal Dock hides widget stacks but keeps hover previews and running-app cleanup."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Native Dock keeps app icons central with Trash after apps. Minimal Dock hides widget stacks but keeps hover previews and running-app cleanup."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Системный Dock держит значки приложений по центру, а Корзину после приложений. Минимальный Dock скрывает стопки виджетов, но сохраняет предпросмотр при наведении и очистку запущенных приложений."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Native Dock keeps app icons central with Trash after apps. Minimal Dock hides widget stacks but keeps hover previews and running-app cleanup."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inbyggd Dock håller appsymbolerna centrerade med Papperskorgen efter apparna. Minimal Dock döljer widgetstackar men behåller hovringsförhandsvisningar och upprensning av appar som körs."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yerel Dock, uygulama simgelerini ortada tutar ve Çöp Sepeti'ni uygulamalardan sonra yerleştirir. Minimal Dock, widget yığınlarını gizler ama üzerine gelince önizlemeleri ve çalışan uygulama temizliğini korur."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Native Dock keeps app icons central with Trash after apps. Minimal Dock hides widget stacks but keeps hover previews and running-app cleanup."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dock mặc định giữ các biểu tượng ứng dụng ở trung tâm với Thùng rác ở sau các ứng dụng. Dock tối giản ẩn các ngăn xếp tiện ích nhưng vẫn giữ bản xem trước khi di chuột và dọn dẹp ứng dụng đang chạy."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“原生 Dock”会将应用图标保持在中央，并将废纸篓放在应用之后。“精简 Dock”会隐藏小组件叠放，同时保留悬停预览和运行中的应用自动清理功能。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "原生 Dock 將應用程式圖示置中，並將垃圾桶置於末端。極簡 Dock 會隱藏小工具堆疊，但仍保留懸停預覽與執行中應用程式的清理功能。"
          }
        }
      }
    },
