    "Before Apps is for leading tools. After Apps is where native-style layouts keep Trash." : {
      "comment" : "Dock anatomy note description",
      "extractionState" : "manual",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Before Apps is for leading tools. After Apps is where native-style layouts keep Trash."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«قبل التطبيقات» مخصص لأدوات البداية. و«بعد التطبيقات» هو حيث تُبقي التخطيطات الشبيهة بالأصلي على المهملات."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Before Apps is for leading tools. After Apps is where native-style layouts keep Trash."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Before Apps is for leading tools. After Apps is where native-style layouts keep Trash."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Before Apps is for leading tools. After Apps is where native-style layouts keep Trash."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Vor Apps“ ist für Werkzeuge am Anfang. „Nach Apps“ ist der Bereich, in dem Layouts im nativen Stil den Papierkorb platzieren."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Before Apps is for leading tools. After Apps is where native-style layouts keep Trash."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Antes de las apps es para herramientas iniciales. Después de las apps es donde las disposiciones de estilo nativo colocan la Papelera."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Before Apps is for leading tools. After Apps is where native-style layouts keep Trash."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« Avant les apps » regroupe les outils de début. « Après les apps » est là où les dispositions de style natif gardent la Corbeille."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Before Apps is for leading tools. After Apps is where native-style layouts keep Trash."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az Appok előtt szakasz az elöl lévő eszközöké. Az Appok után szakaszban tartják a natív stílusú elrendezések a Kukát."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Before Apps is for leading tools. After Apps is where native-style layouts keep Trash."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「アプリの前」は先頭側のツール用です。「アプリの後」は、ネイティブ風のレイアウトでゴミ箱を置く場所です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Before Apps is for leading tools. After Apps is where native-style layouts keep Trash."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Before Apps is for leading tools. After Apps is where native-style layouts keep Trash."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'Voor apps' is bedoeld voor tools vooraan. 'Na apps' is waar lay-outs in de stijl van het standaard Dock de prullenmand plaatsen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Strefa Przed aplikacjami jest przeznaczona na narzędzia początkowe. W układach wzorowanych na systemowym Docku Kosz znajduje się w strefie Po aplikacjach."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Antes das Aplicações serve para ferramentas iniciais. Depois das Aplicações é onde as disposições de estilo nativo mantêm o Lixo."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Before Apps is for leading tools. After Apps is where native-style layouts keep Trash."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Before Apps is for leading tools. After Apps is where native-style layouts keep Trash."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Перед приложениями» предназначено для инструментов в начале. В «После приложений» макеты в стиле системного Dock размещают Корзину."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Before Apps is for leading tools. After Apps is where native-style layouts keep Trash."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Före appar är platsen för inledande verktyg. Efter appar är där layouter i systemstil har papperskorgen."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uygulamalardan Önce, baştaki araçlar içindir. Uygulamalardan Sonra, yerel tarzdaki düzenlerin Çöp Sepeti'ni tuttuğu yerdir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Before Apps is for leading tools. After Apps is where native-style layouts keep Trash."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trước ứng dụng là vị trí dành cho các công cụ ở đầu. Sau ứng dụng là vị trí mà các bố cục kiểu macOS đặt Thùng rác."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“应用前”区域用于放置前置工具，“应用后”区域则是原生布局中废纸篓所在的位置。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「在應用程式之前」用於放置前端工具；「在應用程式之後」則是原生風格配置中垃圾桶所在的位置。"
          }
        }
      }
    },
