            "value" : "Cap how wide this folder's zone gets on a bottom/top dock, or how tall on a side dock. Unlimited fills its share of the row and scrolls."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Cap how wide this folder's zone gets on a bottom/top dock, or how tall on a side dock. Unlimited fills its share of the row and scrolls."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ограничьте ширину области этой папки при размещении панели задач (дока) внизу или вверху экрана, либо её высоту при боковом размещении. Режим «Без ограничений» позволяет папке занимать всё доступное место в ряду с возможностью прокрутки."
          }
        },
        "sr" : {
          "stringUnit" : {
