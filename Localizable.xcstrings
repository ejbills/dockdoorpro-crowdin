    "The modifier that triggers the Alt-Tab window switcher, letter navigation, and initializer-based dock shortcuts. Command-Tab is active; the shortcut fields below can't record ⌘-Tab directly because macOS reserves it." : {
      "comment" : "Settings control description when Command is already selected",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The modifier that triggers the Alt-Tab window switcher, letter navigation, and initializer-based dock shortcuts. Command-Tab is active; the shortcut fields below can't record ⌘-Tab directly because macOS reserves it."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مفتاح التعديل الذي يشغّل مبدّل نوافذ Alt-Tab والتنقل بالحروف واختصارات Dock المعتمدة على مفتاح البدء. اختصار Command-Tab نشط؛ ولا يمكن لحقول الاختصارات أدناه تسجيل ⌘-Tab مباشرةً لأن macOS يحجزه."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The modifier that triggers the Alt-Tab window switcher, letter navigation, and initializer-based dock shortcuts. Command-Tab is active; the shortcut fields below can't record ⌘-Tab directly because macOS reserves it."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The modifier that triggers the Alt-Tab window switcher, letter navigation, and initializer-based dock shortcuts. Command-Tab is active; the shortcut fields below can't record ⌘-Tab directly because macOS reserves it."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The modifier that triggers the Alt-Tab window switcher, letter navigation, and initializer-based dock shortcuts. Command-Tab is active; the shortcut fields below can't record ⌘-Tab directly because macOS reserves it."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Modifikatortaste, die den Alt-Tab-Fensterwechsler, die Buchstabennavigation und Dock-Kurzbefehle mit Auslösertaste auslöst. Command-Tab ist aktiv; die Kurzbefehlfelder unten können ⌘-Tab nicht direkt aufzeichnen, da macOS diese Kombination reserviert."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The modifier that triggers the Alt-Tab window switcher, letter navigation, and initializer-based dock shortcuts. Command-Tab is active; the shortcut fields below can't record ⌘-Tab directly because macOS reserves it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El modificador que activa el selector de ventanas Alt-Tab, la navegación por letras y los atajos del Dock basados en el inicializador. Comando-Tab está activo; los campos de atajo de abajo no pueden registrar ⌘-Tab directamente porque macOS lo reserva."
          }
        },
        "fi" : {
          "stringUnit" : {
