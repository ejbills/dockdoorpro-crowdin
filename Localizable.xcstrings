    "Don't shrink icons to fit the screen; scroll instead and add floating edge zones" : {
      "comment" : "Settings search description",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Don't shrink icons to fit the screen; scroll instead and add floating edge zones"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا تصغّر الأيقونات لملاءمة الشاشة؛ مرر بدلًا من ذلك وأضف مناطق حافة عائمة"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Don't shrink icons to fit the screen; scroll instead and add floating edge zones"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Don't shrink icons to fit the screen; scroll instead and add floating edge zones"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Don't shrink icons to fit the screen; scroll instead and add floating edge zones"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Symbole nicht verkleinern, damit sie auf den Bildschirm passen; stattdessen scrollen und schwebende Randzonen hinzufügen"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Don't shrink icons to fit the screen; scroll instead and add floating edge zones"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No encoge los iconos para caber en la pantalla; en su lugar permite desplazarse y añade zonas flotantes en los bordes"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Don't shrink icons to fit the screen; scroll instead and add floating edge zones"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ne pas réduire les icônes pour tenir sur l'écran ; faire défiler à la place et ajouter des zones de bord flottantes"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Don't shrink icons to fit the screen; scroll instead and add floating edge zones"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az ikonok ne zsugorodjanak a képernyőhöz; helyette görgetés és lebegő élzónák hozzáadása"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Don't shrink icons to fit the screen; scroll instead and add floating edge zones"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "画面に収めるためにアイコンを縮小せず、代わりにスクロールしてフローティングのエッジゾーンを追加します"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Don't shrink icons to fit the screen; scroll instead and add floating edge zones"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Don't shrink icons to fit the screen; scroll instead and add floating edge zones"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maak pictogrammen niet kleiner om ze op het scherm te laten passen; scroll in plaats daarvan en voeg zwevende randzones toe"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie zmniejszaj ikon, aby zmieściły się na wyświetlaczu. Zamiast tego przewijaj i dodaj pływające strefy krawędzi"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não encolher os ícones para caberem no ecrã; a dock desloca-se e ganha zonas flutuantes nas extremidades"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Don't shrink icons to fit the screen; scroll instead and add floating edge zones"
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Don't shrink icons to fit the screen; scroll instead and add floating edge zones"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не уменьшать значки для подгонки под экран; вместо этого прокручивать и добавлять плавающие краевые зоны"
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Don't shrink icons to fit the screen; scroll instead and add floating edge zones"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Krymp inte symboler för att få plats på skärmen; rulla i stället och lägg till svävande kantzoner"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Simgeleri ekrana sığdırmak için küçültme; bunun yerine kaydır ve kenarlara yüzen bölgeler ekle"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Don't shrink icons to fit the screen; scroll instead and add floating edge zones"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không thu nhỏ các biểu tượng để vừa với màn hình; thay vào đó hãy cuộn và thêm các vùng cạnh nổi"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不要缩小图标以适应屏幕，而是改为滚动显示，并添加悬浮边缘区域"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不要縮小圖示以適應螢幕，而是改為捲動並新增浮動邊緣區域"
          }
        }
      }
    },
    "Don't shrink icons to fit the screen. The dock scrolls when there are too many icons, and floating mode gains leading and trailing edge zones." : {
      "comment" : "Settings control description",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Don't shrink icons to fit the screen. The dock scrolls when there are too many icons, and floating mode gains leading and trailing edge zones."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا تصغّر الأيقونات لملاءمة الشاشة. يتمرر Dock عندما تكثر الأيقونات، ويكتسب الوضع العائم منطقتي حافة في البداية والنهاية."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Don't shrink icons to fit the screen. The dock scrolls when there are too many icons, and floating mode gains leading and trailing edge zones."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Don't shrink icons to fit the screen. The dock scrolls when there are too many icons, and floating mode gains leading and trailing edge zones."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Don't shrink icons to fit the screen. The dock scrolls when there are too many icons, and floating mode gains leading and trailing edge zones."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Symbole nicht verkleinern, damit sie auf den Bildschirm passen. Das Dock scrollt, wenn zu viele Symbole vorhanden sind, und der schwebende Modus erhält Randzonen vorne und hinten."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Don't shrink icons to fit the screen. The dock scrolls when there are too many icons, and floating mode gains leading and trailing edge zones."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No encoge los iconos para caber en la pantalla. El Dock se desplaza cuando hay demasiados iconos, y el modo flotante añade zonas en los bordes inicial y final."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Don't shrink icons to fit the screen. The dock scrolls when there are too many icons, and floating mode gains leading and trailing edge zones."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ne pas réduire les icônes pour tenir sur l'écran. Le dock défile quand il y a trop d'icônes, et le mode flottant gagne des zones de début et de fin."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Don't shrink icons to fit the screen. The dock scrolls when there are too many icons, and floating mode gains leading and trailing edge zones."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az ikonok nem zsugorodnak, hogy elférjenek a képernyőn. Túl sok ikon esetén a Dock görgethető, lebegő módban pedig elülső és hátsó élzónák jelennek meg."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Don't shrink icons to fit the screen. The dock scrolls when there are too many icons, and floating mode gains leading and trailing edge zones."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "画面に収めるためにアイコンを縮小しません。アイコンが多すぎる場合はDockがスクロールし、フローティングモードでは先頭と末尾のエッジゾーンが追加されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Don't shrink icons to fit the screen. The dock scrolls when there are too many icons, and floating mode gains leading and trailing edge zones."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Don't shrink icons to fit the screen. The dock scrolls when there are too many icons, and floating mode gains leading and trailing edge zones."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maak de pictogrammen niet kleiner om ze op het scherm te laten passen. Je kunt door het Dock scrollen als er te veel pictogrammen zijn, en in de zwevende modus krijgt het Dock randzones aan het begin en het einde."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie zmniejszaj ikon, aby zmieściły się na wyświetlaczu. Dock można przewijać, gdy ikon jest za dużo, a tryb pływający zyskuje strefy przy krawędzi początkowej i końcowej."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não encolher os ícones para caberem no ecrã. A dock desloca-se quando há demasiados ícones e o modo flutuante ganha zonas nas extremidades inicial e final."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Don't shrink icons to fit the screen. The dock scrolls when there are too many icons, and floating mode gains leading and trailing edge zones."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Don't shrink icons to fit the screen. The dock scrolls when there are too many icons, and floating mode gains leading and trailing edge zones."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не уменьшать значки для подгонки под экран. Dock прокручивается, когда значков слишком много, а в плавающем режиме появляются зоны у левого и правого краев."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Don't shrink icons to fit the screen. The dock scrolls when there are too many icons, and floating mode gains leading and trailing edge zones."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Krymp inte symboler för att få plats på skärmen. Dockan rullar när det finns för många symboler, och svävande läge får inledande och avslutande kantzoner."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Simgeleri ekrana sığdırmak için küçültme. Çok fazla simge olduğunda dock kaydırılır, yüzen modda ise baş ve son kenar bölgeleri eklenir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Don't shrink icons to fit the screen. The dock scrolls when there are too many icons, and floating mode gains leading and trailing edge zones."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không thu nhỏ các biểu tượng để vừa với màn hình. Dock sẽ cho phép cuộn khi có quá nhiều biểu tượng, và chế độ nổi sẽ có thêm các vùng ở cạnh đầu và cạnh cuối."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不要缩小图标以适应屏幕。当图标过多时，Dock 会改为滚动显示；启用悬浮模式后，还会增加起始端和末端区域。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不要縮小圖示以適應螢幕；當圖示過多時將改為捲動顯示，浮動模式則會增加前端與尾端的邊緣區域。"
          }
        }
      }
    },
