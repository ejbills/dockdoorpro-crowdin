            "value" : "Uma coluna que lista todas as apps em execução, as respetivas janelas e ações. Desative-a para ter um painel mais estreito."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma coluna listando todos os aplicativos em execução, suas janelas e suas ações. Desligue-o para um painel mais estreito."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "A column listing every running app, its windows and their actions. Turn it off for a narrower panel."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Столбец со всеми запущенными приложениями, их окнами и действиями. Выключите, чтобы панель была уже."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "new",
