        "sv" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Widget stacks appear on either side of your app icons. Up to 3 stacks per side. Each stack can hold multiple widgets, scroll to page between them."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Widget stacks appear on either side of your app icons. Up to 3 stacks per side. Each stack can hold multiple widgets, scroll to page between them."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Widget stacks appear on either side of your app icons. Up to 3 stacks per side. Each stack can hold multiple widgets, scroll to page between them."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Các ngăn xếp tiện ích xuất hiện ở hai bên của các biểu tượng ứng dụng. Tối đa 3 ngăn xếp mỗi bên. Mỗi ngăn xếp có thể chứa nhiều tiện ích, cuộn để chuyển trang giữa chúng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "小组件叠放会显示在应用图标两侧。每侧最多可放置 3 个叠放。每个叠放可包含多个小组件，并可通过滚动在它们之间切换。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "小工具堆疊會顯示在應用程式圖示的任一側。每側最多可容納 3 個堆疊。每個堆疊可放置多個小工具，捲動即可在它們之間切換頁面。"
          }
        }
      }
    },
