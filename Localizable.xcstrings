    "Move open members to the front using Running App Order, while closed members keep their configured order." : {
      "comment" : "Settings control description\nSettings search description",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Move open members to the front using Running App Order, while closed members keep their configured order."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نقل العناصر المفتوحة إلى المقدمة وفق «ترتيب التطبيقات قيد التشغيل»، بينما تحتفظ العناصر المغلقة بترتيبها المضبوط."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Move open members to the front using Running App Order, while closed members keep their configured order."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Move open members to the front using Running App Order, while closed members keep their configured order."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Move open members to the front using Running App Order, while closed members keep their configured order."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geöffnete Mitglieder gemäß „Reihenfolge laufender Apps“ nach vorne verschieben, während geschlossene Mitglieder ihre festgelegte Reihenfolge behalten."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Move open members to the front using Running App Order, while closed members keep their configured order."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mueve al principio los miembros abiertos según el Orden de apps en ejecución, mientras que los cerrados mantienen el orden configurado."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Move open members to the front using Running App Order, while closed members keep their configured order."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Placer les membres ouverts en tête selon l'ordre des apps actives, tandis que les membres fermés conservent leur ordre configuré."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Move open members to the front using Running App Order, while closed members keep their configured order."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A nyitott tagok a Futó appok sorrendje szerint előre kerülnek, a bezártak pedig megtartják a beállított sorrendjüket."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Move open members to the front using Running App Order, while closed members keep their configured order."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "開いているメンバーを「実行中アプリの並び順」に従って先頭に移動し、閉じているメンバーは設定した順序を維持します。"
          }
        },
        "ko" : {
          "stringUnit" : {
