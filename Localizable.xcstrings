          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appuyez sur l'étoile d'un widget pour le définir comme principal. \nLa pile y reviendra automatiquement après ce délai."
          }
        },
        "he" : {
