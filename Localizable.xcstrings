        },
        "nb" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Native Dock keeps app icons central with Trash after apps. Minimal Dock hides widget stacks but keeps hover previews and running-app cleanup."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Standaard Dock plaatst app-pictogrammen centraal, met de prullenmand achter de apps. Minimale Dock verbergt widgetstapels, maar behoudt de voorbeelden bij het aanwijzen en het opschonen van geopende apps."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Systemowy Dock umieszcza ikony aplikacji pośrodku, a Kosz za aplikacjami. Minimalny Dock ukrywa stosy widżetów, ale zachowuje podglądy po wskazaniu i porządkowanie uruchomionych aplikacji."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Native Dock keeps app icons central with Trash after apps. Minimal Dock hides widget stacks but keeps hover previews and running-app cleanup."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Native Dock keeps app icons central with Trash after apps. Minimal Dock hides widget stacks but keeps hover previews and running-app cleanup."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Native Dock keeps app icons central with Trash after apps. Minimal Dock hides widget stacks but keeps hover previews and running-app cleanup."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Родной док держит иконки приложений по центру, а корзину — после приложений. Минимальный док скрывает стопки виджетов, но сохраняет предпросмотры при наведении и очистку запущенных приложений."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Native Dock keeps app icons central with Trash after apps. Minimal Dock hides widget stacks but keeps hover previews and running-app cleanup."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Native Dock keeps app icons central with Trash after apps. Minimal Dock hides widget stacks but keeps hover previews and running-app cleanup."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Native Dock keeps app icons central with Trash after apps. Minimal Dock hides widget stacks but keeps hover previews and running-app cleanup."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Native Dock keeps app icons central with Trash after apps. Minimal Dock hides widget stacks but keeps hover previews and running-app cleanup."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dock mặc định giữ các biểu tượng ứng dụng ở trung tâm với Thùng rác ở sau các ứng dụng. Dock tối giản ẩn các ngăn xếp tiện ích nhưng vẫn giữ bản xem trước khi di chuột và dọn dẹp ứng dụng đang chạy."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“原生 Dock”会将应用图标保持在中央，并将废纸篓放在应用之后。“精简 Dock”会隐藏小组件叠放，同时保留悬停预览和运行中的应用自动清理功能。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "原生 Dock 將應用程式圖示置中，並將垃圾桶置於末端。極簡 Dock 會隱藏小工具堆疊，但仍保留懸停預覽與執行中應用程式的清理功能。"
          }
        }
      }
    },
