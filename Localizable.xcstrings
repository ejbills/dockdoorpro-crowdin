          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aan weerszijden van je app-pictogrammen verschijnen widgetstapels. Maximaal 3 stapels per kant. Elke stapel kan meerdere widgets bevatten; je kunt tussen de stapels bladeren."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stosy widżetów pojawiają się po obu stronach ikon aplikacji. Maksymalnie 3 stosy na stronę. Każdy stos może zawierać wiele widżetów; przewijaj, aby przełączać strony między nimi."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Widget stacks appear on either side of your app icons. Up to 3 stacks per side. Each stack can hold multiple widgets, scroll to page between them."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
