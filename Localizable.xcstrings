        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liquid Glass gebruik het glaseffect van macOS 26. Mat gebruikt een vervagingseffect. Effen gebruikt een volledig dekkende kleur. Transparant verwijdert de achtergrond volledig."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liquid Glass używa efektu szkła z macOS 26. Matowy używa materiału rozmycia. Jednolity używa w pełni kryjącego koloru. Przezroczysty całkowicie usuwa tło."
          }
        },
        "pt" : {
          "stringUnit" : {
