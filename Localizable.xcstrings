          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Показывать Dock только из области его фактической ширины или высоты. Выключите, чтобы показывать его из любого места вдоль края дисплея."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Only reveal from the hidden dock's actual width or height. Turn this off to reveal from anywhere along that display edge."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Visa bara från den gömda dockans faktiska bredd eller höjd. Stäng av för att kunna visa den från valfri plats längs skärmkanten."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yalnızca gizli dock'un gerçek genişliğinden veya yüksekliğinden aç. O ekran kenarı boyunca her yerden açmak için bunu kapat."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Only reveal from the hidden dock's actual width or height. Turn this off to reveal from anywhere along that display edge."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chỉ hiển thị từ chiều rộng hoặc chiều cao thực tế của dock bị ẩn. Tắt tính năng này để hiển thị từ bất kỳ vị trí nào dọc theo cạnh màn hình đó."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅在隐藏后 Dock 的实际宽度或高度范围内唤出。关闭此选项后，可从该显示器的整个边缘唤出。"
