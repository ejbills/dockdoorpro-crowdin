            "value" : "Widget stacks appear on either side of your app icons. Up to 3 stacks per side. Each stack can hold multiple widgets, scroll to page between them."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Widget stacks appear on either side of your app icons. Up to 3 stacks per side. Each stack can hold multiple widgets, scroll to page between them."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Widget-Stacks erscheinen auf beiden Seiten deiner App-Icons. Bis zu 3 Stapel pro Seite möglich. Jeder Stapel kann mehrere Widgets enthalten, die durch Maus-Scrolling gewechselt werden können."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "new",
