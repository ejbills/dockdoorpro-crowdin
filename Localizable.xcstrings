            "value" : "Zacznij od stylu pływającego lub paska zadań, a potem przejdź przez Wygląd, aby ustawić rozmiar, wskaźniki i tło."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comece pelo estilo flutuante ou de barra de tarefas e continue depois pela Aparência para tamanho, indicadores e fundo."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Start with floating or taskbar style, then continue through Appearance for size, indicators, and background."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Start with floating or taskbar style, then continue through Appearance for size, indicators, and background."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Начните с плавающего стиля или панели задач, затем перейдите к внешнему виду для размера, индикаторов и фона."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Start with floating or taskbar style, then continue through Appearance for size, indicators, and background."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Börja med svävande stil eller aktivitetsfältsstil och fortsätt sedan genom Utseende för storlek, indikatorer och bakgrund."
          }
        },
        "tr" : {
          "stringUnit" : {
