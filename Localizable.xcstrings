        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Com o ícone da barra de menus desativado, pode continuar a reabrir as Definições através do botão de perfil ou de definições da Dock, ou voltando a abrir o DockDoor Pro a partir do Finder, do Spotlight ou do Launchpad."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "With the menu bar icon off, you can still reopen Settings from the dock's profile or settings button — or by relaunching DockDoor Pro from Finder, Spotlight, or Launchpad."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "With the menu bar icon off, you can still reopen Settings from the dock's profile or settings button — or by relaunching DockDoor Pro from Finder, Spotlight, or Launchpad."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если значок в строке меню выключен, вы все равно можете открыть настройки кнопкой профиля или настроек в Dock, а также перезапустив DockDoor Pro из Finder, Spotlight или Launchpad."
