          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Hold %@ and press a letter to jump to matching running apps. Press the same letter to cycle through matches."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halten Sie %@ gedrückt und drücken Sie einen Buchstaben, um zu passenden laufenden Apps zu springen. Drücken Sie denselben Buchstaben erneut, um zwischen Treffern zu wechseln."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Hold %@ and press a letter to jump to matching running apps. Press the same letter to cycle through matches."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantén pulsada la tecla %@ y pulsa una letra para saltar a las apps en ejecución que coincidan. Pulsa la misma letra para recorrer las coincidencias."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Hold %@ and press a letter to jump to matching running apps. Press the same letter to cycle through matches."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maintenez %@ et appuyez sur une lettre pour accéder à l'application correspondante. \nAppuyez à nouveau sur la même lettre pour basculer entre les correspondances."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Hold %@ and press a letter to jump to matching running apps. Press the same letter to cycle through matches."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tartsd lenyomva a %@ billentyűt, és nyomj meg egy betűt a megfelelő futó alkalmazásra ugráshoz. Nyomd meg újra ugyanazt a betűt a találatok közötti váltáshoz."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Hold %@ and press a letter to jump to matching running apps. Press the same letter to cycle through matches."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@を押したまま文字キーを押すと、一致する実行中のアプリにジャンプします。同じ文字キーを押すと、一致するアプリを順に切り替えます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Hold %@ and press a letter to jump to matching running apps. Press the same letter to cycle through matches."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Hold %@ and press a letter to jump to matching running apps. Press the same letter to cycle through matches."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Houd %@ ingedrukt en druk op een letter om naar de overeenkomende geopende app te springen. Druk nogmaals op dezelfde letter om door de overeenkomsten te bladeren."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przytrzymaj %@ i naciśnij literę, aby przejść do pasujących uruchomionych aplikacji. Naciśnij tę samą literę, aby przełączać dopasowania."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantenha premida a tecla %@ e prima uma letra para saltar para as apps em execução correspondentes. Prima a mesma letra para percorrer as correspondências."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Hold %@ and press a letter to jump to matching running apps. Press the same letter to cycle through matches."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Hold %@ and press a letter to jump to matching running apps. Press the same letter to cycle through matches."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Удерживайте %@ и нажмите на букву, чтобы перейти к совпадающим приложениям. Нажмите на ту же букву еще раз для повторения матчей."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Hold %@ and press a letter to jump to matching running apps. Press the same letter to cycle through matches."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Håll ned %@ och tryck på en bokstav för att hoppa till matchande appar som körs. Tryck på samma bokstav igen för att bläddra mellan träffarna."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ tuşunu basılı tutun ve bir harfe basarak eşleşen çalışan uygulamalara atlayın. Eşleşenler arasında geçiş yapmak için aynı harfe tekrar basın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Hold %@ and press a letter to jump to matching running apps. Press the same letter to cycle through matches."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Giữ %@ và nhấn một chữ cái để nhảy đến ứng dụng đang chạy tương ứng. Nhấn cùng một chữ cái để chuyển qua các ứng dụng khớp."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按住 %@ 并按下字母键可跳转到匹配的运行中应用。重复按下同一字母键可在匹配项之间循环切换。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按住 %@ 並按下字母鍵，即可跳至符合條件的執行中 應用程式。重複按下相同字母鍵可在符合項目間切換。"
          }
        }
      }
    },
    "Hold a dragged file over an app icon to show App Exposé, then drop it on a window. Dropping on the icon opens the file with the app." : {
