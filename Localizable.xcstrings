          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Install community widgets directly from the marketplace. Widgets run natively in your dock. Widget updates may require a restart of the app to fully take effect."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Topluluk bileşenlerini doğrudan mağazadan yükleyin. Bileşenler dock içinde yerel olarak çalışır. Bileşen güncellemelerinin tam olarak etkili olması için uygulamanın yeniden başlatılması gerekebilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Install community widgets directly from the marketplace. Widgets run natively in your dock. Widget updates may require a restart of the app to fully take effect."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cài đặt các tiện ích từ cộng đồng trực tiếp từ cửa hàng. Các tiện ích sẽ chạy nguyên bản trên dock của bạn. Các bản cập nhật tiện ích có thể yêu cầu khởi động lại ứng dụng để có hiệu lực đầy đủ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "可直接从应用市场安装社区小组件。小组件将在 Dock 中原生运行。更新小组件后，可能需要重新启动应用才能使更改完全生效。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "可直接從市集安裝社群小工具。小工具會在 Dock 中原生執行。小工具更新後可能需要重新啟動應用程式才能完全生效。"
          }
        }
      }
    },
