        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bij het scrollen wordt in het paneel een selectievenster boven het Dock weergegeven; met 'Inline' wordt het pictogram direct in het Dock gewijzigd. Dit geldt voor de profielknop en de paginakiezer in het bestandsvak"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Panel pokazuje wybierak nad Dockiem podczas przewijania, a tryb W miejscu zmienia ikonę bezpośrednio w Docku. Dotyczy to przycisku profilu i przełącznika stron Półki plików"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Painel mostra um seletor acima da dock ao deslocar; Integrado muda o ícone diretamente na dock. Aplica-se ao botão de perfil e ao alternador de páginas do tabuleiro de ficheiros"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
