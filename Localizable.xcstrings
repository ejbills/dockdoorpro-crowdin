    "DockDoor Pro uses this to understand window focus, switch windows, support dock overlap avoidance, and react to fullscreen/window state." : {
      "comment" : "Setup permission preflight explanation",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "DockDoor Pro uses this to understand window focus, switch windows, support dock overlap avoidance, and react to fullscreen/window state."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يستخدم DockDoor Pro هذا الإذن لفهم تركيز النوافذ، وتبديل النوافذ، ودعم تجنب تداخل Dock مع النوافذ، والتفاعل مع حالة ملء الشاشة والنوافذ."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "DockDoor Pro uses this to understand window focus, switch windows, support dock overlap avoidance, and react to fullscreen/window state."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "DockDoor Pro uses this to understand window focus, switch windows, support dock overlap avoidance, and react to fullscreen/window state."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "DockDoor Pro uses this to understand window focus, switch windows, support dock overlap avoidance, and react to fullscreen/window state."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DockDoor Pro nutzt dies, um den Fensterfokus zu erkennen, zwischen Fenstern zu wechseln, Dock-Überlappungen zu vermeiden und auf Vollbild- und Fensterzustände zu reagieren."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "DockDoor Pro uses this to understand window focus, switch windows, support dock overlap avoidance, and react to fullscreen/window state."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DockDoor Pro lo usa para conocer el foco de las ventanas, cambiar de ventana, evitar superposiciones con el Dock y reaccionar al estado de pantalla completa o de las ventanas."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "DockDoor Pro uses this to understand window focus, switch windows, support dock overlap avoidance, and react to fullscreen/window state."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DockDoor Pro l'utilise pour connaître le focus des fenêtres, changer de fenêtre, éviter le chevauchement avec le dock et réagir à l'état plein écran ou fenêtré."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "DockDoor Pro uses this to understand window focus, switch windows, support dock overlap avoidance, and react to fullscreen/window state."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A DockDoor Pro ezzel érzékeli az ablakfókuszt, vált ablakot, kerüli el a Dock takarását, és reagál a teljes képernyős, illetve ablakállapotra."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "DockDoor Pro uses this to understand window focus, switch windows, support dock overlap avoidance, and react to fullscreen/window state."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ウインドウのフォーカスの把握、ウインドウの切り替え、Dockの重なり回避、フルスクリーンやウインドウ状態への対応のために使用します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "DockDoor Pro uses this to understand window focus, switch windows, support dock overlap avoidance, and react to fullscreen/window state."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "DockDoor Pro uses this to understand window focus, switch windows, support dock overlap avoidance, and react to fullscreen/window state."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DockDoor Pro gebruikt dit om de focus van vensters te bepalen, tussen vensters te schakelen, overlapping met het Dock te voorkomen en te reageren op de status van het venster of de volledig-schermmodus."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DockDoor Pro używa tego do rozpoznawania aktywnego okna, przełączania okien, unikania nakładania Docka oraz reagowania na stan pełnego ekranu i okna."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O DockDoor Pro usa esta permissão para perceber o foco das janelas, alternar entre janelas, evitar sobreposições com a dock e reagir ao estado de ecrã completo e das janelas."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "DockDoor Pro uses this to understand window focus, switch windows, support dock overlap avoidance, and react to fullscreen/window state."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "DockDoor Pro uses this to understand window focus, switch windows, support dock overlap avoidance, and react to fullscreen/window state."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DockDoor Pro использует это для отслеживания фокуса окон, их переключения, предотвращения перекрытия Dock и реакции на полноэкранный режим и состояние окон."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "DockDoor Pro uses this to understand window focus, switch windows, support dock overlap avoidance, and react to fullscreen/window state."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DockDoor Pro använder detta för att förstå fönsterfokus, växla fönster, undvika att dockan överlappas och reagera på helskärms- och fönsterstatus."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DockDoor Pro bunu pencere odağını anlamak, pencereler arasında geçiş yapmak, dock çakışmasını önlemeyi desteklemek ve tam ekran/pencere durumuna tepki vermek için kullanır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "DockDoor Pro uses this to understand window focus, switch windows, support dock overlap avoidance, and react to fullscreen/window state."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DockDoor Pro sử dụng quyền này để nhận biết tiêu điểm cửa sổ, chuyển đổi cửa sổ, hỗ trợ tránh chồng lấn dock, và phản hồi lại trạng thái toàn màn hình hoặc trạng thái cửa sổ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DockDoor Pro 需要此权限，以便识别窗口焦点、切换窗口、避免与 Dock 重叠，并响应全屏和窗口状态的变化。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DockDoor Pro 使用此功能來判斷視窗焦點、執行視窗切換、支援避免 Dock 重疊，並回應全螢幕與視窗狀態變更。"
          }
        }
      }
    },
    "DockDoor Pro won't observe or query these apps through accessibility. Use this for fragile apps that misbehave when accessibility clients query them. Window previews and window info are unavailable for isolated apps." : {
      "comment" : "Settings control description",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "DockDoor Pro won't observe or query these apps through accessibility. Use this for fragile apps that misbehave when accessibility clients query them. Window previews and window info are unavailable for isolated apps."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لن يراقب DockDoor Pro هذه التطبيقات أو يستعلم عنها عبر تسهيلات الاستخدام. استخدم هذا للتطبيقات الحساسة التي يختل سلوكها عندما تستعلم عنها برامج تسهيلات الاستخدام. معاينات النوافذ ومعلوماتها غير متاحة للتطبيقات المعزولة."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "DockDoor Pro won't observe or query these apps through accessibility. Use this for fragile apps that misbehave when accessibility clients query them. Window previews and window info are unavailable for isolated apps."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "DockDoor Pro won't observe or query these apps through accessibility. Use this for fragile apps that misbehave when accessibility clients query them. Window previews and window info are unavailable for isolated apps."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "DockDoor Pro won't observe or query these apps through accessibility. Use this for fragile apps that misbehave when accessibility clients query them. Window previews and window info are unavailable for isolated apps."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DockDoor Pro überwacht diese Apps nicht über die Bedienungshilfen und fragt sie darüber nicht ab. Verwenden Sie dies für empfindliche Apps, die sich fehlerhaft verhalten, wenn Bedienungshilfen-Clients sie abfragen. Fenstervorschauen und Fensterinformationen sind für isolierte Apps nicht verfügbar."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "DockDoor Pro won't observe or query these apps through accessibility. Use this for fragile apps that misbehave when accessibility clients query them. Window previews and window info are unavailable for isolated apps."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DockDoor Pro no observará ni consultará estas apps mediante la accesibilidad. Úsalo para apps delicadas que fallan cuando los clientes de accesibilidad las consultan. Las previsualizaciones y la información de ventanas no están disponibles para las apps aisladas."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "DockDoor Pro won't observe or query these apps through accessibility. Use this for fragile apps that misbehave when accessibility clients query them. Window previews and window info are unavailable for isolated apps."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DockDoor Pro n'observera ni n'interrogera ces apps via l'accessibilité. Utilisez cette option pour les apps fragiles qui se comportent mal lorsque des clients d'accessibilité les interrogent. Les aperçus et les informations de fenêtre ne sont pas disponibles pour les apps isolées."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "DockDoor Pro won't observe or query these apps through accessibility. Use this for fragile apps that misbehave when accessibility clients query them. Window previews and window info are unavailable for isolated apps."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A DockDoor Pro nem figyeli és nem kérdezi le ezeket az appokat a kisegítő lehetőségeken keresztül. Olyan kényes appokhoz használja, amelyek hibásan működnek, ha kisegítő kliensek lekérdezik őket. Az elkülönített appoknál nem érhetők el az ablak-előnézetek és az ablakadatok."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "DockDoor Pro won't observe or query these apps through accessibility. Use this for fragile apps that misbehave when accessibility clients query them. Window previews and window info are unavailable for isolated apps."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DockDoor Proは、これらのアプリをアクセシビリティ経由で監視または照会しません。アクセシビリティクライアントからの照会で誤動作する不安定なアプリに使用してください。分離されたアプリでは、ウインドウプレビューとウインドウ情報を利用できません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "DockDoor Pro won't observe or query these apps through accessibility. Use this for fragile apps that misbehave when accessibility clients query them. Window previews and window info are unavailable for isolated apps."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "DockDoor Pro won't observe or query these apps through accessibility. Use this for fragile apps that misbehave when accessibility clients query them. Window previews and window info are unavailable for isolated apps."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DockDoor Pro zal deze apps niet controleren of opvragen via de toegankelijkheidsfuncties. Gebruik deze functie voor kwetsbare apps die niet naar behoren werken wanneer toegankelijkheidsclients ze opvragen. Venstervoorbeelden en vensterinformatie zijn niet beschikbaar voor geïsoleerde apps."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DockDoor Pro nie będzie obserwować tych aplikacji ani odczytywać ich danych za pomocą funkcji dostępności. Użyj tej opcji dla aplikacji, które działają nieprawidłowo, gdy inne programy odczytują ich dane za pomocą funkcji dostępności. Podglądy okien i informacje o nich są niedostępne dla izolowanych aplikacji."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O DockDoor Pro não observa nem consulta estas apps através da acessibilidade. Use isto para apps frágeis que se comportam mal quando os clientes de acessibilidade as consultam. As pré-visualizações e as informações de janelas não estão disponíveis para apps isoladas."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "DockDoor Pro won't observe or query these apps through accessibility. Use this for fragile apps that misbehave when accessibility clients query them. Window previews and window info are unavailable for isolated apps."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "DockDoor Pro won't observe or query these apps through accessibility. Use this for fragile apps that misbehave when accessibility clients query them. Window previews and window info are unavailable for isolated apps."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DockDoor Pro не будет отслеживать и опрашивать эти приложения через универсальный доступ. Используйте это для нестабильных приложений, которые работают некорректно при запросах клиентов универсального доступа. Предпросмотр окон и сведения об окнах недоступны для изолированных приложений."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "DockDoor Pro won't observe or query these apps through accessibility. Use this for fragile apps that misbehave when accessibility clients query them. Window previews and window info are unavailable for isolated apps."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DockDoor Pro övervakar eller frågar inte de här apparna via hjälpmedelsfunktionerna. Använd detta för känsliga appar som beter sig fel när hjälpmedelsklienter frågar dem. Fönsterförhandsvisningar och fönsterinformation är inte tillgängliga för isolerade appar."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DockDoor Pro bu uygulamaları erişilebilirlik üzerinden gözlemlemez veya sorgulamaz. Erişilebilirlik istemcileri sorguladığında bozulan hassas uygulamalar için kullan. İzole edilen uygulamalar için pencere önizlemeleri ve pencere bilgileri kullanılamaz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "DockDoor Pro won't observe or query these apps through accessibility. Use this for fragile apps that misbehave when accessibility clients query them. Window previews and window info are unavailable for isolated apps."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DockDoor Pro sẽ không quan sát hoặc truy vấn các ứng dụng này qua trợ năng. Dùng tùy chọn này cho các ứng dụng dễ lỗi, hoạt động bất thường khi bị các ứng dụng trợ năng truy vấn. Bản xem trước cửa sổ và thông tin cửa sổ không khả dụng cho các ứng dụng bị cô lập."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DockDoor Pro 将不会通过辅助功能监测或查询这些应用。如果某些应用在辅助功能客户端查询时出现异常，可使用此选项。隔离的应用无法提供窗口预览和窗口信息。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DockDoor Pro 不會透過「輔助使用」功能監控或查詢這些應用程式。若某些應用程式在被輔助使用程式查詢時容易發生異常，可將它們加入此處。被隔離的應用程式將無法顯示視窗預覽與視窗資訊。"
          }
        }
      }
    },
