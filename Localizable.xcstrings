          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "This is not broad file scanning or message reading. Each app is controlled only for the widget or action you chose, and only while that widget is in your dock."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es handelt sich nicht um umfassendes Durchsuchen von Dateien oder Lesen von Nachrichten. Jede App wird nur für das von Ihnen gewählte Widget oder die gewählte Aktion gesteuert und nur, solange sich dieses Widget in Ihrem Dock befindet."
