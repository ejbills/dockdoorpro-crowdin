          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Turn off to completely disable the shelf. Scrolling, file drags, shelf widgets, and action buttons will no longer open it."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deaktivieren, um die Ablage vollständig abzuschalten. Scrollen, Dateiziehen, Ablage-Widgets und Aktionsschaltflächen öffnen sie dann nicht mehr."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Turn off to completely disable the shelf. Scrolling, file drags, shelf widgets, and action buttons will no longer open it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desactívalo para deshabilitar el estante por completo. El desplazamiento, los arrastres de archivos, los widgets del estante y los botones de acción ya no lo abrirán."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Turn off to completely disable the shelf. Scrolling, file drags, shelf widgets, and action buttons will no longer open it."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Désactivez cette option pour désactiver entièrement l'étagère. Le défilement, les glissements de fichiers, les widgets d'étagère et les boutons d'action ne l'ouvriront plus."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Turn off to completely disable the shelf. Scrolling, file drags, shelf widgets, and action buttons will no longer open it."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kapcsolja ki a polc teljes letiltásához. A görgetés, a fájlhúzás, a polcwidgetek és a műveletgombok többé nem nyitják meg."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Turn off to completely disable the shelf. Scrolling, file drags, shelf widgets, and action buttons will no longer open it."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "オフにするとシェルフが完全に無効になります。スクロール、ファイルのドラッグ、シェルフウィジェット、アクションボタンではシェルフが開かなくなります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Turn off to completely disable the shelf. Scrolling, file drags, shelf widgets, and action buttons will no longer open it."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Turn off to completely disable the shelf. Scrolling, file drags, shelf widgets, and action buttons will no longer open it."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schakel deze optie uit om de plank volledig uit te schakelen. De plank wordt dan niet meer geopend door te scrollen, bestanden te verslepen, plankwidgets of actieknoppen te gebruiken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wyłącz tę opcję, aby całkowicie wyłączyć Szufladę. Przewijanie, przeciąganie plików, widżety Szuflady i przyciski czynności nie będą już jej otwierać."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desative para desligar completamente a prateleira. O deslocamento, o arrastamento de ficheiros, os widgets da prateleira e os botões de ação deixarão de a abrir."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Turn off to completely disable the shelf. Scrolling, file drags, shelf widgets, and action buttons will no longer open it."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Turn off to completely disable the shelf. Scrolling, file drags, shelf widgets, and action buttons will no longer open it."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выключите этот параметр, чтобы полностью выключить полку. После этого прокрутка, перетаскивание файлов, виджеты полки и кнопки действий перестанут ее открывать."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Turn off to completely disable the shelf. Scrolling, file drags, shelf widgets, and action buttons will no longer open it."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stäng av för att avaktivera hyllan helt. Rullning, fildragningar, hyllwidgetar och åtgärdsknappar öppnar den inte längre."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rafı tamamen devre dışı bırakmak için kapat. Kaydırma, dosya sürüklemeleri, raf widget'ları ve eylem düğmeleri artık onu açmaz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Turn off to completely disable the shelf. Scrolling, file drags, shelf widgets, and action buttons will no longer open it."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tắt đi để vô hiệu hóa hoàn toàn phần ngăn. Việc cuộn, kéo tệp, các tiện ích của ngăn và các nút tác vụ sẽ không còn mở nó ra nữa."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "关闭此选项可完全禁用暂存区。滚动、拖动文件、暂存区小组件和操作按钮都将无法再打开暂存区。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "關閉此選項即可完全停用暫存區。停用後，捲動、拖曳檔案、暫存區小工具和動作按鈕都無法再開啟暫存區。"
          }
        }
      }
    },
