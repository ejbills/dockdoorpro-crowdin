        "nb" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "A column listing every running app, its windows and their actions. Turn it off for a narrower panel."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een kolom met elke geopende app, de vensters ervan en hun acties. Schakel dit uit voor een smaller paneel."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
