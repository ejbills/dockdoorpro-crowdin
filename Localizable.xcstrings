        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Giới hạn độ rộng vùng của thư mục này trên dock dưới/dock trên, hoặc giới hạn chiều cao trên dock bên. Không giới hạn sẽ chiếm toàn bộ phần của nó trong hàng và cho phép cuộn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "限制此文件夹区域在顶部或底部 Dock 中的最大宽度，以及在侧边 Dock 中的最大高度。设为“不限”时，它会占满所在行分配的空间，并通过滚动显示内容。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "設定此檔案夾區域的最大尺寸。在上方或下方 Dock 中限制其寬度，在側邊 Dock 中限制其高度。選擇「無限制」時，將填滿所分配的列空間，並可透過捲動瀏覽內容。"
          }
        }
      }
    },
