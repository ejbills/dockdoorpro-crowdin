    "Install community widgets directly from the marketplace. Widgets run natively in your dock. Widget updates may require a restart of the app to fully take effect." : {
      "comment" : "Marketplace info note",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Install community widgets directly from the marketplace. Widgets run natively in your dock. Widget updates may require a restart of the app to fully take effect."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قم بتثبيت أدوات المجتمع مباشرة من السوق. الأدوات تعمل محلياً في المرفأ الخاص بك. قد تتطلب تحديثات القطعة إعادة تشغيل التطبيق لتبدأ مفعولها بالكامل."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Install community widgets directly from the marketplace. Widgets run natively in your dock. Widget updates may require a restart of the app to fully take effect."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Install community widgets directly from the marketplace. Widgets run natively in your dock. Widget updates may require a restart of the app to fully take effect."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Install community widgets directly from the marketplace. Widgets run natively in your dock. Widget updates may require a restart of the app to fully take effect."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Installieren Sie Community-Widgets direkt aus dem Marktplatz. Widgets laufen nativ in Ihrem Dock. Widget-Updates erfordern möglicherweise einen Neustart der App, damit sie vollständig wirksam werden."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Install community widgets directly from the marketplace. Widgets run natively in your dock. Widget updates may require a restart of the app to fully take effect."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Install community widgets directly from the marketplace. Widgets run natively in your dock. Widget updates may require a restart of the app to fully take effect."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Install community widgets directly from the marketplace. Widgets run natively in your dock. Widget updates may require a restart of the app to fully take effect."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Installez les widgets de la communauté directement depuis le marketplace. Les widgets s'exécutent nativement dans votre dock.\nLes mises à jour de widgets peuvent nécessiter un redémarrage de l'application pour prendre pleinement en compte."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Install community widgets directly from the marketplace. Widgets run natively in your dock. Widget updates may require a restart of the app to fully take effect."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Telepíts közösségi widgeteket közvetlenül a piactérről. A widgetek natívan futnak a Dockban. A widgetfrissítések teljes érvénybe lépéséhez előfordulhat, hogy újra kell indítani az alkalmazást."
          }
        },
