            "value" : "Schakel widgetstapels in en voeg Dock-hulpmiddelen toe, zoals widgets voor de prullenmand, klokken, het weer en de marketplace."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Włącz stosy widżetów, aby umieścić narzędzia obok aplikacji, a następnie dodaj Kosz, zegary, pogodę i widżety z Marketplace."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Enable widget stacks to keep tools beside your apps, then add Trash, clocks, weather, and marketplace widgets."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Enable widget stacks to keep tools beside your apps, then add Trash, clocks, weather, and marketplace widgets."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Enable widget stacks to keep tools beside your apps, then add Trash, clocks, weather, and marketplace widgets."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Включить стопки виджетов, чтобы инструменты были рядом с приложениями, затем добавьте корзину, часы, погоду и виджеты магазина."
          }
        },
        "sr" : {
          "stringUnit" : {
