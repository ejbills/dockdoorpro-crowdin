          "stringUnit" : {
            "state" : "new",
            "value" : "Divides captured thumbnail resolution to save memory. 1 is best quality; higher values are lighter but blurrier."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يقسم دقة الصور المصغرة الملتقطة لتوفير الذاكرة. القيمة 1 هي الأفضل جودة؛ والقيم الأعلى أخف لكنها أكثر ضبابية."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Divides captured thumbnail resolution to save memory. 1 is best quality; higher values are lighter but blurrier."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Divides captured thumbnail resolution to save memory. 1 is best quality; higher values are lighter but blurrier."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Divides captured thumbnail resolution to save memory. 1 is best quality; higher values are lighter but blurrier."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teilt die Auflösung aufgenommener Miniaturen, um Speicher zu sparen. 1 ist die beste Qualität; höhere Werte sind sparsamer, aber unschärfer."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Divides captured thumbnail resolution to save memory. 1 is best quality; higher values are lighter but blurrier."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Divide la resolución de las miniaturas capturadas para ahorrar memoria. 1 es la mejor calidad; los valores más altos son más ligeros pero más borrosos."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Divides captured thumbnail resolution to save memory. 1 is best quality; higher values are lighter but blurrier."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Divise la résolution des miniatures capturées pour économiser de la mémoire. 1 offre la meilleure qualité ; des valeurs plus élevées sont plus légères mais plus floues."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Divides captured thumbnail resolution to save memory. 1 is best quality; higher values are lighter but blurrier."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A rögzített miniatűrök felbontását osztja el a memória megtakarításához. Az 1 a legjobb minőség; a nagyobb értékek kevesebb memóriát használnak, de elmosódottabbak."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Divides captured thumbnail resolution to save memory. 1 is best quality; higher values are lighter but blurrier."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "キャプチャしたサムネールの解像度を下げてメモリを節約します。1が最高画質で、値が大きいほど軽くなりますがぼやけます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Divides captured thumbnail resolution to save memory. 1 is best quality; higher values are lighter but blurrier."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Divides captured thumbnail resolution to save memory. 1 is best quality; higher values are lighter but blurrier."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De resolutie van de opgeslagen miniatuurafbeeldingen wordt aangepast om geheugen te besparen. '1' is de beste kwaliteit, een hogere waarde levert kleinere, maar wazigere afbeeldingen op."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zmniejsza rozdzielczość przechwytywanych miniatur, aby oszczędzać pamięć. 1 oznacza najlepszą jakość; wyższe wartości zmniejszają zużycie pamięci, ale dają bardziej rozmyty obraz."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Divide a resolução das miniaturas capturadas para poupar memória. 1 é a melhor qualidade; valores mais altos são mais leves mas mais desfocados."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Divides captured thumbnail resolution to save memory. 1 is best quality; higher values are lighter but blurrier."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Divides captured thumbnail resolution to save memory. 1 is best quality; higher values are lighter but blurrier."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Делит разрешение захваченных миниатюр для экономии памяти. 1 означает наилучшее качество; более высокие значения экономнее, но размытее."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Divides captured thumbnail resolution to save memory. 1 is best quality; higher values are lighter but blurrier."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Delar ned miniatyrernas upplösning för att spara minne. 1 ger bäst kvalitet; högre värden är lättare men suddigare."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Belleği korumak için yakalanan küçük resim çözünürlüğünü böler. 1 en iyi kalitedir; yüksek değerler daha hafif ama daha bulanıktır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Divides captured thumbnail resolution to save memory. 1 is best quality; higher values are lighter but blurrier."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chia nhỏ độ phân giải hình thu nhỏ đã ghi để tiết kiệm bộ nhớ. Giá trị 1 mang lại chất lượng tốt nhất; các giá trị cao hơn sẽ nhẹ hơn nhưng mờ hơn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "降低捕获的缩略图分辨率以节省内存。数值为1时质量最佳；数值越高，内存占用越低，但缩略图越模糊。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "降低擷取的縮圖解析度以節省記憶體。數值為 1 時畫質最佳；數值越高，占用的記憶體越少，但縮圖會越模糊。"
          }
        }
      }
    },
