    "On multi-display Macs, each display can show or hide DockDoor Pro and use its own edge and profile." : {
      "comment" : "Setup directory step description",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "On multi-display Macs, each display can show or hide DockDoor Pro and use its own edge and profile."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "على أجهزة Mac متعددة الشاشات، يمكن لكل شاشة إظهار DockDoor Pro أو إخفاؤه واستخدام حافتها وملف التعريف الخاص بها."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "On multi-display Macs, each display can show or hide DockDoor Pro and use its own edge and profile."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "On multi-display Macs, each display can show or hide DockDoor Pro and use its own edge and profile."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "On multi-display Macs, each display can show or hide DockDoor Pro and use its own edge and profile."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auf Macs mit mehreren Displays kann jedes Display DockDoor Pro ein- oder ausblenden und eine eigene Bildschirmkante sowie ein eigenes Profil verwenden."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "On multi-display Macs, each display can show or hide DockDoor Pro and use its own edge and profile."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En los Mac con varias pantallas, cada pantalla puede mostrar u ocultar DockDoor Pro y usar su propio borde y perfil."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "On multi-display Macs, each display can show or hide DockDoor Pro and use its own edge and profile."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sur les Mac à plusieurs écrans, chaque écran peut afficher ou masquer DockDoor Pro et utiliser son propre bord et son propre profil."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "On multi-display Macs, each display can show or hide DockDoor Pro and use its own edge and profile."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Több kijelzős Maceken minden kijelző külön megjelenítheti vagy elrejtheti a DockDoor Pro-t, és saját képernyőélt és profilt használhat."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "On multi-display Macs, each display can show or hide DockDoor Pro and use its own edge and profile."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "複数ディスプレイのMacでは、ディスプレイごとにDockDoor Proの表示/非表示を切り替え、それぞれ別の辺とプロファイルを使用できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "여러 디스플레이를 사용하는 경우 각 화면마다 DockDoor Pro 표시 여부, 위치, 프로필을 따로 설정할 수 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "On multi-display Macs, each display can show or hide DockDoor Pro and use its own edge and profile."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Op Macs met meerdere beeldschermen kan op elk beeldscherm DockDoor Pro worden weergegeven of verborgen, en kan elk beeldscherm zijn eigen rand en profiel gebruiken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na Macach z wieloma wyświetlaczami każdy z nich może pokazywać lub ukrywać DockDoor Pro oraz używać własnej krawędzi i profilu."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Em Macs com vários ecrãs, cada ecrã pode mostrar ou ocultar o DockDoor Pro e usar a sua própria extremidade e perfil."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "On multi-display Macs, each display can show or hide DockDoor Pro and use its own edge and profile."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "On multi-display Macs, each display can show or hide DockDoor Pro and use its own edge and profile."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "На Mac с несколькими дисплеями каждый дисплей может показывать или скрывать DockDoor Pro и использовать свой собственный край и профиль."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "On multi-display Macs, each display can show or hide DockDoor Pro and use its own edge and profile."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "På Mac-datorer med flera skärmar kan varje skärm visa eller gömma DockDoor Pro och använda sin egen kant och profil."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Birden fazla ekranlı Mac'lerde her ekran DockDoor Pro'yu gösterebilir veya gizleyebilir ve kendi kenarını ve profilini kullanabilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "On multi-display Macs, each display can show or hide DockDoor Pro and use its own edge and profile."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trên máy Mac có nhiều màn hình, mỗi màn hình có thể ẩn hoặc hiện DockDoor Pro và sử dụng cạnh cũng như hồ sơ riêng của nó."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在多显示器 Mac 上，每台显示器都可以单独显示或隐藏 DockDoor Pro，并使用各自的边缘和配置文件。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在配備多個顯示器的 Mac 上，每個顯示器都可以顯示或隱藏 DockDoor Pro，並使用各自的邊緣和設定檔。"
          }
        }
      }
    },
