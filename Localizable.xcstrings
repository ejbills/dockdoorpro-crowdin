    "Since DockDoor Pro is on the %@, we recommend moving the native dock to the %@ to avoid overlap." : {
      "comment" : "Settings control title",
      "extractionState" : "manual",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Since DockDoor Pro is on the %1$@, we recommend moving the native dock to the %2$@ to avoid overlap."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نظرًا لأن DockDoor Pro على %1$@، نوصي بنقل الرصيف الأصلي إلى %2$@ لتجنب التداخل."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Since DockDoor Pro is on the %1$@, we recommend moving the native dock to the %2$@ to avoid overlap."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Since DockDoor Pro is on the %1$@, we recommend moving the native dock to the %2$@ to avoid overlap."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Since DockDoor Pro is on the %1$@, we recommend moving the native dock to the %2$@ to avoid overlap."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Da DockDoor Pro %1$@ angezeigt wird, empfehlen wir, das systemeigene Dock nach %2$@ zu verschieben, um Überlappungen zu vermeiden."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Since DockDoor Pro is on the %1$@, we recommend moving the native dock to the %2$@ to avoid overlap."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Since DockDoor Pro is on the %1$@, we recommend moving the native dock to the %2$@ to avoid overlap."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Como la posición de DockDoor Pro es «%1$@», te recomendamos cambiar la posición del Dock nativo a «%2$@» para evitar que se solapen."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Since DockDoor Pro is on the %1$@, we recommend moving the native dock to the %2$@ to avoid overlap."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comme DockDoor Pro est sur la %1$@, nous vous recommandons de déplacer le dock natif vers l' %2$@ pour éviter le chevauchement."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Since DockDoor Pro is on the %1$@, we recommend moving the native dock to the %2$@ to avoid overlap."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mivel a DockDoor Pro pozíciója „%1$@”, az átfedés elkerülése érdekében javasoljuk, hogy a natív Dockot helyezze át a következő pozícióba: „%2$@”."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Since DockDoor Pro is on the %1$@, we recommend moving the native dock to the %2$@ to avoid overlap."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DockDoor Proは%1$@に配置されているため、重なりを避けるために標準のDockを%2$@に移動することをおすすめします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Since DockDoor Pro is on the %1$@, we recommend moving the native dock to the %2$@ to avoid overlap."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Since DockDoor Pro is on the %1$@, we recommend moving the native dock to the %2$@ to avoid overlap."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Omdat DockDoor Pro %1$@ staat, raden we aan om het standaard Dock van macOS naar %2$@ te verplaatsen om overlap te voorkomen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ponieważ DockDoor Pro znajduje się na %1$@, zalecamy przeniesienie systemowego Docka na %2$@, aby uniknąć nakładania."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Como a posição do DockDoor Pro é «%1$@», recomendamos alterar a posição da Dock nativa para «%2$@» para evitar sobreposições."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Since DockDoor Pro is on the %1$@, we recommend moving the native dock to the %2$@ to avoid overlap."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Since DockDoor Pro is on the %1$@, we recommend moving the native dock to the %2$@ to avoid overlap."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Так как DockDoor Pro находится на %1$@, мы рекомендуем переместить родной док - станцию на %2$@ во избежание перекрытия."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Since DockDoor Pro is on the %1$@, we recommend moving the native dock to the %2$@ to avoid overlap."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eftersom DockDoor Pro har positionen %1$@ rekommenderar vi att du flyttar den inbyggda Docken till positionen %2$@ för att undvika överlappning."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DockDoor Pro %1$@ üzerinde olduğundan, çakışmayı önlemek için yerel dock’u %2$@’ye taşımanızı öneririz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Since DockDoor Pro is on the %1$@, we recommend moving the native dock to the %2$@ to avoid overlap."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vì DockDoor Pro nằm ở %1$@, chúng tôi khuyên bạn nên chuyển dock mặc định sang %2$@ để tránh bị chồng lấn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "由于 DockDoor Pro 位于 %1$@，我们建议将系统原生 Dock 移动到 %2$@ 以避免重叠。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DockDoor Pro 目前位於 %1$@，建議將系統 Dock 移至 %2$@，以避免彼此重疊。"
          }
        }
      }
