    "When the dock is on the left or right, scrolling and gestures use horizontal (left/right) input instead of vertical." : {
      "comment" : "Vertical dock scroll orientation note",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "When the dock is on the left or right, scrolling and gestures use horizontal (left/right) input instead of vertical."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عندما يكون Dock على اليسار أو اليمين، يستخدم التمرير والإيماءات الإدخال الأفقي (اليسار/اليمين) بدلاً من الإدخال الرأسي."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "When the dock is on the left or right, scrolling and gestures use horizontal (left/right) input instead of vertical."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "When the dock is on the left or right, scrolling and gestures use horizontal (left/right) input instead of vertical."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "When the dock is on the left or right, scrolling and gestures use horizontal (left/right) input instead of vertical."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn sich das Dock links oder rechts befindet, verwenden Scrollen und Gesten horizontale Eingaben (links/rechts) statt vertikaler."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "When the dock is on the left or right, scrolling and gestures use horizontal (left/right) input instead of vertical."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuando el Dock está a la izquierda o a la derecha, el desplazamiento y los gestos usan una entrada horizontal (izquierda/derecha) en lugar de vertical."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "When the dock is on the left or right, scrolling and gestures use horizontal (left/right) input instead of vertical."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lorsque le dock est à gauche ou à droite, le défilement et les gestes utilisent l'entrée horizontale (à gauche/droite) au lieu de la verticale."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "When the dock is on the left or right, scrolling and gestures use horizontal (left/right) input instead of vertical."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ha a Dock a bal vagy a jobb oldalon van, a görgetés és a kézmozdulatok vízszintes (bal/jobb) bemenetet használnak függőleges helyett."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "When the dock is on the left or right, scrolling and gestures use horizontal (left/right) input instead of vertical."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dockが左または右にある場合、スクロールとジェスチャは縦ではなく横(左右)の入力を使用します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "When the dock is on the left or right, scrolling and gestures use horizontal (left/right) input instead of vertical."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "When the dock is on the left or right, scrolling and gestures use horizontal (left/right) input instead of vertical."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als het Dock zich aan de linker- of rechterkant bevindt, worden bij het scrollen en bij gebaren horizontale (links/rechts) bewegingen gebruikt in plaats van verticale."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gdy Dock znajduje się po lewej lub prawej stronie, przewijanie i gesty używają ruchu poziomego, w lewo lub w prawo, zamiast pionowego."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando a Dock está à esquerda ou à direita, o deslocamento e os gestos usam movimento horizontal (esquerda/direita) em vez de vertical."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "When the dock is on the left or right, scrolling and gestures use horizontal (left/right) input instead of vertical."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "When the dock is on the left or right, scrolling and gestures use horizontal (left/right) input instead of vertical."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Когда Dock находится слева или справа, прокрутка и жесты используют ввод по горизонтали (влево/вправо), а не по вертикали."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "When the dock is on the left or right, scrolling and gestures use horizontal (left/right) input instead of vertical."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "När dockan är till vänster eller höger använder rullning och gester horisontell (vänster/höger) inmatning i stället för vertikal."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dock solda veya sağdaysa, kaydırma ve jestler dikey yerine yatay (sol/sağ) giriş kullanır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "When the dock is on the left or right, scrolling and gestures use horizontal (left/right) input instead of vertical."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khi dock nằm ở bên trái hoặc bên phải, thao tác cuộn và cử chỉ sẽ sử dụng đầu vào theo chiều ngang (trái/phải) thay vì chiều dọc."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当 Dock 位于左侧或右侧时，滚动和手势将使用水平（左右）输入，而非垂直输入。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "當 Dock 位於左側或右側時，捲動與手勢會使用水平（左／右）輸入，而非垂直輸入。"
          }
        }
      }
    },
