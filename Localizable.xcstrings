            "state" : "new",
            "value" : "Mark the frontmost app with a longer accent bar instead of dots, so it's easy to see where you are on the dock."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geef de app die op de voorgrond staat aan met een langere accentbalk in plaats van stippen, zodat je gemakkelijk kunt zien waar het zich op het Dock bevindt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oznacz aktywną aplikację dłuższym paskiem akcentu zamiast kropek, aby łatwo było zobaczyć, gdzie jesteś w Docku."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Assinalar a aplicação em primeiro plano com uma barra de destaque mais longa em vez de pontos, para ver facilmente onde está na dock."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Mark the frontmost app with a longer accent bar instead of dots, so it's easy to see where you are on the dock."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Mark the frontmost app with a longer accent bar instead of dots, so it's easy to see where you are on the dock."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отмечать активное приложение более длинной полосой цвета акцента вместо точек, чтобы было легко видеть, где вы находитесь в Dock."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Mark the frontmost app with a longer accent bar instead of dots, so it's easy to see where you are on the dock."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Markera främsta appen med en längre accentstapel istället för punkter, så att det är lätt att se var du är i dockan."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En öndeki uygulamayı noktalar yerine daha uzun bir vurgu çubuğuyla işaretle, böylece dock'ta nerede olduğunu görmek kolaylaşır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Mark the frontmost app with a longer accent bar instead of dots, so it's easy to see where you are on the dock."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đánh dấu ứng dụng trên cùng bằng một thanh nổi bật dài hơn thay vì các dấu chấm, giúp bạn dễ dàng nhìn thấy vị trí của mình trên dock."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用较长的指示条代替圆点标识当前最前台的应用，方便快速确认 Dock 中当前所在的位置。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "以較長的強調線取代圓點，標示目前最前方的應用程式，讓您更容易辨識目前在 Dock 上的位置。"
          }
        }
      }
    },
