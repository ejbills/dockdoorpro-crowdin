    "Press your Edit Dock shortcut to edit the dock. Drag apps, folders, files, URLs, or running apps onto the dock to pin them to the active profile. In edit mode, long-press a pinned icon to reorder it, then click the checkmark when finished." : {
      "comment" : "Dock profile edit mode instruction note",
      "extractionState" : "stale",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Press your Edit Dock shortcut to edit the dock. Drag apps, folders, files, URLs, or running apps onto the dock to pin them to the active profile. In edit mode, long-press a pinned icon to reorder it, then click the checkmark when finished."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اضغط على اختصار قائمة التعديلات لتحرير المرفأ. اسحب التطبيقات، المجلدات، الملفات، عناوين الراوبط، أو تشغيل التطبيقات على الإرساء لتثبيتها في الملف الشخصي النشط. في وضع التحرير، اضغط طويلاً على أيقونة مثبتة لإعادة ترتيبها، ثم انقر فوق علامة الاختيار عند الانتهاء."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Press your Edit Dock shortcut to edit the dock. Drag apps, folders, files, URLs, or running apps onto the dock to pin them to the active profile. In edit mode, long-press a pinned icon to reorder it, then click the checkmark when finished."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Press your Edit Dock shortcut to edit the dock. Drag apps, folders, files, URLs, or running apps onto the dock to pin them to the active profile. In edit mode, long-press a pinned icon to reorder it, then click the checkmark when finished."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Press your Edit Dock shortcut to edit the dock. Drag apps, folders, files, URLs, or running apps onto the dock to pin them to the active profile. In edit mode, long-press a pinned icon to reorder it, then click the checkmark when finished."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drücken Sie Ihren Kurzbefehl „Dock bearbeiten“, um das Dock zu bearbeiten. Ziehen Sie Apps, Ordner, Dateien, URLs oder laufende Apps auf das Dock, um sie im aktiven Profil anzuheften. Halten Sie im Bearbeitungsmodus ein angeheftetes Symbol gedrückt, um es neu anzuordnen, und klicken Sie anschließend auf das Häkchen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Press your Edit Dock shortcut to edit the dock. Drag apps, folders, files, URLs, or running apps onto the dock to pin them to the active profile. In edit mode, long-press a pinned icon to reorder it, then click the checkmark when finished."
          }
        },
