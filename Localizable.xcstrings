          "stringUnit" : {
            "state" : "translated",
            "value" : "Durée pendant laquelle les miniatures de fenêtre capturées restent en cache avant d'être recapturées. Plus longue, elle réduit l'usage du processeur ; plus courte, elle garde les aperçus plus à jour."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "How long captured window thumbnails stay cached before they are recaptured. Longer keeps CPU lower; shorter keeps previews more up to date."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meddig maradnak gyorsítótárban a rögzített ablak-miniatűrök az újrarögzítés előtt. A hosszabb idő kisebb CPU-terhelést, a rövidebb naprakészebb előnézeteket jelent."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "How long captured window thumbnails stay cached before they are recaptured. Longer keeps CPU lower; shorter keeps previews more up to date."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "取り込んだウインドウのサムネールを再取得するまでキャッシュしておく時間です。長くするとCPU負荷が下がり、短くするとプレビューがより最新に保たれます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "How long captured window thumbnails stay cached before they are recaptured. Longer keeps CPU lower; shorter keeps previews more up to date."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "How long captured window thumbnails stay cached before they are recaptured. Longer keeps CPU lower; shorter keeps previews more up to date."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hoe lang miniaturen van vastgelegde vensters in de cache blijven voordat ze opnieuw worden vastgelegd. Een langere tijdsduur zorgt voor een lagere CPU-belasting; een kortere tijdsduur zorgt ervoor dat de voorbeelden actueler blijven."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jak długo przechwycone miniatury okien pozostają w pamięci podręcznej przed ponownym przechwyceniem. Dłuższy czas obniża użycie CPU; krótszy zapewnia bardziej aktualne podglądy."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Durante quanto tempo as miniaturas de janelas capturadas ficam em cache antes de serem novamente capturadas. Mais tempo reduz o uso de CPU; menos tempo mantém as pré-visualizações mais atualizadas."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "How long captured window thumbnails stay cached before they are recaptured. Longer keeps CPU lower; shorter keeps previews more up to date."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "How long captured window thumbnails stay cached before they are recaptured. Longer keeps CPU lower; shorter keeps previews more up to date."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Как долго захваченные миниатюры окон хранятся в кэше перед повторным захватом. Чем дольше, тем ниже нагрузка на ЦП; чем короче, тем актуальнее предпросмотр."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "How long captured window thumbnails stay cached before they are recaptured. Longer keeps CPU lower; shorter keeps previews more up to date."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hur länge tagna fönsterminiatyrer cachas innan de tas om. Längre tid ger lägre CPU-användning; kortare håller förhandsvisningarna mer aktuella."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yakalanan pencere küçük resimlerinin yeniden yakalanmadan önce ne kadar süre önbellekte kaldığı. Daha uzun süre CPU kullanımını düşük tutar; daha kısa süre önizlemeleri daha güncel tutar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "How long captured window thumbnails stay cached before they are recaptured. Longer keeps CPU lower; shorter keeps previews more up to date."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thời gian các hình thu nhỏ cửa sổ đã chụp được lưu trong bộ nhớ đệm trước khi chúng được chụp lại. Thời gian dài hơn sẽ giúp giảm tải CPU; thời gian ngắn hơn giúp bản xem trước luôn cập nhật mới nhất."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "设置窗口缩略图在重新生成前的缓存时长。时间越长，CPU 占用越低；时间越短，预览内容越及时。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "設定視窗縮圖重新擷取前的快取保留時間。較長的時間可降低 CPU 負載；較短的時間則可讓預覽內容更即時。"
          }
        }
      }
    },
