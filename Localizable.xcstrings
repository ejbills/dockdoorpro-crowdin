    "The Handoff tile appears at this position in the dock while another device advertises an activity. Drag this row to reposition it; remove it to send it back to the start of the dock." : {
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The Handoff tile appears at this position in the dock while another device advertises an activity. Drag this row to reposition it; remove it to send it back to the start of the dock."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يظهر مربع Handoff في هذا الموضع في Dock عندما يعلن جهاز آخر عن نشاط. اسحب هذا الصف لتغيير موضعه، أو أزله لإعادته إلى بداية Dock."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The Handoff tile appears at this position in the dock while another device advertises an activity. Drag this row to reposition it; remove it to send it back to the start of the dock."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The Handoff tile appears at this position in the dock while another device advertises an activity. Drag this row to reposition it; remove it to send it back to the start of the dock."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The Handoff tile appears at this position in the dock while another device advertises an activity. Drag this row to reposition it; remove it to send it back to the start of the dock."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Handoff-Kachel erscheint an dieser Position im Dock, während ein anderes Gerät eine Aktivität anbietet. Ziehen Sie diese Zeile, um sie neu zu positionieren; entfernen Sie sie, um sie an den Anfang des Docks zurückzusetzen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The Handoff tile appears at this position in the dock while another device advertises an activity. Drag this row to reposition it; remove it to send it back to the start of the dock."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El icono de Handoff aparece en esta posición del Dock mientras otro dispositivo anuncia una actividad. Arrastra esta fila para cambiar su posición; elimínala para devolverlo al principio del Dock."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The Handoff tile appears at this position in the dock while another device advertises an activity. Drag this row to reposition it; remove it to send it back to the start of the dock."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La vignette Handoff apparaît à cette position dans le dock lorsqu'un autre appareil propose une activité. Faites glisser cette ligne pour la repositionner ; supprimez-la pour la renvoyer au début du dock."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The Handoff tile appears at this position in the dock while another device advertises an activity. Drag this row to reposition it; remove it to send it back to the start of the dock."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Handoff-csempe ezen a helyen jelenik meg a Dockban, amíg egy másik eszköz tevékenységet hirdet. Húzza ezt a sort az áthelyezéséhez; ha eltávolítja, visszakerül a Dock elejére."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The Handoff tile appears at this position in the dock while another device advertises an activity. Drag this row to reposition it; remove it to send it back to the start of the dock."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "別のデバイスがアクティビティを通知している間、Dockのこの位置にHandoffタイルが表示されます。この行をドラッグすると位置を変更でき、削除するとDockの先頭に戻ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The Handoff tile appears at this position in the dock while another device advertises an activity. Drag this row to reposition it; remove it to send it back to the start of the dock."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The Handoff tile appears at this position in the dock while another device advertises an activity. Drag this row to reposition it; remove it to send it back to the start of the dock."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De Handoff-tegel verschijnt op deze plek in het Dock wanneer een ander apparaat een activiteit aangeeft. Sleep deze rij om hem te verplaatsen; verwijder hem om hem terug te zetten naar het begin van het Dock."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kafelek Handoff pojawia się w tym miejscu Docka, gdy inne urządzenie udostępnia aktywność. Przeciągnij ten wiersz, aby zmienić jego położenie; usuń go, aby odesłać go na początek Docka."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O mosaico do Handoff aparece nesta posição da Dock enquanto outro dispositivo anuncia uma atividade. Arraste esta linha para o reposicionar; remova-a para o enviar de volta para o início da Dock."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The Handoff tile appears at this position in the dock while another device advertises an activity. Drag this row to reposition it; remove it to send it back to the start of the dock."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The Handoff tile appears at this position in the dock while another device advertises an activity. Drag this row to reposition it; remove it to send it back to the start of the dock."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Плитка Handoff появляется в этом месте Dock, пока другое устройство предлагает продолжить действие. Перетащите эту строку, чтобы изменить положение; удалите ее, чтобы вернуть плитку в начало Dock."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The Handoff tile appears at this position in the dock while another device advertises an activity. Drag this row to reposition it; remove it to send it back to the start of the dock."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Handoff-rutan visas på den här platsen i dockan när en annan enhet erbjuder en aktivitet. Dra den här raden för att flytta den. Ta bort den för att skicka tillbaka den till början av dockan."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Handoff kutucuğu, başka bir cihaz bir etkinlik duyurduğu sürece dock'ta bu konumda görünür. Yeniden konumlandırmak için bu satırı sürükle; dock'un başına geri göndermek için kaldır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The Handoff tile appears at this position in the dock while another device advertises an activity. Drag this row to reposition it; remove it to send it back to the start of the dock."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ô Handoff xuất hiện ở vị trí này trên dock trong khi một thiết bị khác đang phát tín hiệu hoạt động. Kéo hàng này để thay đổi vị trí của nó; xóa nó để đưa nó trở lại vị trí bắt đầu của dock."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当其他设备提供接力活动时，“接力”图标会出现在 Dock 的此位置。拖拽此行可以重新定位；移除后，会回到 Dock 的开头。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "當其他裝置提供「接力」活動時，「接力」圖塊會出現在 Dock 的此位置。拖移此列可重新定位；移除後，會回到 Dock 的開頭。"
          }
        }
      }
    },
