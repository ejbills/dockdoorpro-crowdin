          "stringUnit" : {
            "state" : "translated",
            "value" : "Bật các ngăn xếp tiện ích để đặt các công cụ bên cạnh ứng dụng của bạn, sau đó thêm các tiện ích Thùng rác, đồng hồ, thời tiết và cửa hàng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
