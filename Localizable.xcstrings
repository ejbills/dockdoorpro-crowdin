    "Best quality captures window thumbnails at full Retina resolution. Sharper previews, but cached images use more memory." : {
      "comment" : "Settings control description",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Best quality captures window thumbnails at full Retina resolution. Sharper previews, but cached images use more memory."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تلتقط أفضل جودة الصور المصغرة للنوافذ بدقة Retina الكاملة. معاينات أوضح، لكن الصور المخزنة مؤقتًا تستهلك ذاكرة أكبر."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Best quality captures window thumbnails at full Retina resolution. Sharper previews, but cached images use more memory."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Best quality captures window thumbnails at full Retina resolution. Sharper previews, but cached images use more memory."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Best quality captures window thumbnails at full Retina resolution. Sharper previews, but cached images use more memory."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bei bester Qualität werden Fenster-Miniaturen in voller Retina-Auflösung aufgenommen. Schärfere Vorschauen, aber zwischengespeicherte Bilder belegen mehr Speicher."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Best quality captures window thumbnails at full Retina resolution. Sharper previews, but cached images use more memory."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La máxima calidad captura las miniaturas de ventana a resolución Retina completa. Previsualizaciones más nítidas, pero las imágenes en caché usan más memoria."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Best quality captures window thumbnails at full Retina resolution. Sharper previews, but cached images use more memory."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meilleure qualité capture les miniatures de fenêtre en pleine résolution Retina. Des aperçus plus nets, mais les images en cache utilisent plus de mémoire."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Best quality captures window thumbnails at full Retina resolution. Sharper previews, but cached images use more memory."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A legjobb minőség teljes Retina felbontásban rögzíti az ablak-miniatűröket. Élesebb előnézetek, de a gyorsítótárazott képek több memóriát használnak."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Best quality captures window thumbnails at full Retina resolution. Sharper previews, but cached images use more memory."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最高品質では、ウインドウのサムネールをフルRetina解像度でキャプチャします。プレビューはより鮮明になりますが、キャッシュ画像のメモリ使用量が増えます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Best quality captures window thumbnails at full Retina resolution. Sharper previews, but cached images use more memory."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Best quality captures window thumbnails at full Retina resolution. Sharper previews, but cached images use more memory."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bij de beste kwaliteit worden miniaturen van vensters vastgelegd in volledige Retina-resolutie. Dit levert scherpere voorbeelden op, maar de afbeeldingen in de cache nemen meer geheugen in beslag."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "W trybie najlepszej jakości miniatury okien są przechwytywane w pełnej rozdzielczości Retina. Podglądy są ostrzejsze, ale obrazy w pamięci podręcznej zajmują więcej pamięci."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A melhor qualidade captura miniaturas de janelas na resolução Retina total. Pré-visualizações mais nítidas, mas as imagens em cache usam mais memória."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Best quality captures window thumbnails at full Retina resolution. Sharper previews, but cached images use more memory."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Best quality captures window thumbnails at full Retina resolution. Sharper previews, but cached images use more memory."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Лучшее качество снимков для миниатюр окон при полном разрешении Retina, но кешированные изображения будут использовать больше памяти."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Best quality captures window thumbnails at full Retina resolution. Sharper previews, but cached images use more memory."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bästa kvalitet fångar fönsterminiatyrer i full Retina-upplösning. Skarpare förhandsvisningar, men cachade bilder använder mer minne."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En iyi kalite, pencere küçük resimlerini tam Retina çözünürlüğünde yakalar. Önizlemeler daha net olur, ancak önbelleğe alınan görüntüler daha fazla bellek kullanır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Best quality captures window thumbnails at full Retina resolution. Sharper previews, but cached images use more memory."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chất lượng tốt nhất sẽ ghi lại hình thu nhỏ cửa sổ ở độ phân giải Retina đầy đủ. Các bản xem trước sẽ sắc nét hơn, nhưng hình ảnh được lưu trong bộ nhớ đệm sẽ sử dụng nhiều bộ nhớ hơn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "以完整 Retina 分辨率捕获窗口缩略图。预览更清晰，但缓存图像会占用更多内存。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「最佳品質」會以完整 Retina 解析度擷取視窗縮圖。預覽畫面更清晰，但快取影像會佔用更多記憶體。"
          }
        }
      }
    },
