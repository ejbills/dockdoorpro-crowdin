    "Unpinned running apps appear right after your pinned items. After-apps widgets such as Trash stay at the end of the dock." : {
      "comment" : "Settings note explaining dock item order",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Unpinned running apps appear right after your pinned items. After-apps widgets such as Trash stay at the end of the dock."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تظهر التطبيقات قيد التشغيل غير المثبتة مباشرةً بعد عناصرك المثبتة. وتبقى الأدوات التي تلي التطبيقات، مثل المهملات، في نهاية Dock."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Unpinned running apps appear right after your pinned items. After-apps widgets such as Trash stay at the end of the dock."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Unpinned running apps appear right after your pinned items. After-apps widgets such as Trash stay at the end of the dock."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Unpinned running apps appear right after your pinned items. After-apps widgets such as Trash stay at the end of the dock."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laufende, nicht angeheftete Apps erscheinen direkt nach Ihren angehefteten Objekten. Widgets nach den Apps, z. B. Papierkorb, bleiben am Ende des Docks."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Unpinned running apps appear right after your pinned items. After-apps widgets such as Trash stay at the end of the dock."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las apps en ejecución no fijadas aparecen justo después de tus ítems fijados. Los widgets posteriores a las apps, como la Papelera, permanecen al final del Dock."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Unpinned running apps appear right after your pinned items. After-apps widgets such as Trash stay at the end of the dock."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les apps actives non épinglées apparaissent juste après vos éléments épinglés. Les widgets placés après les apps, comme la Corbeille, restent en fin de Dock."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Unpinned running apps appear right after your pinned items. After-apps widgets such as Trash stay at the end of the dock."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A nem kitűzött futó appok közvetlenül a kitűzött elemek után jelennek meg. Az appok utáni widgetek, például a Kuka, a Dock végén maradnak."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Unpinned running apps appear right after your pinned items. After-apps widgets such as Trash stay at the end of the dock."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ピン留めされていない実行中のアプリは、ピン留め項目のすぐ後に表示されます。ゴミ箱など「アプリの後」のウィジェットはDockの末尾に配置されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Unpinned running apps appear right after your pinned items. After-apps widgets such as Trash stay at the end of the dock."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Unpinned running apps appear right after your pinned items. After-apps widgets such as Trash stay at the end of the dock."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Niet-vastgezette actieve apps verschijnen direct na je vastgezette items. Widgets die achter de apps staan, zoals de prullenmand, blijven aan het einde van het Dock staan."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nieprzypięte uruchomione aplikacje pojawiają się zaraz po przypiętych elementach. Widżety po aplikacjach, takie jak Kosz, zostają na końcu Docka."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As apps em execução não afixadas aparecem logo a seguir aos itens afixados. Os widgets posteriores às apps, como o Lixo, permanecem no fim da Dock."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Unpinned running apps appear right after your pinned items. After-apps widgets such as Trash stay at the end of the dock."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Unpinned running apps appear right after your pinned items. After-apps widgets such as Trash stay at the end of the dock."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Запущенные незакрепленные приложения отображаются сразу после закрепленных объектов. Виджеты, расположенные после приложений, например Корзина, остаются в конце Dock."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Unpinned running apps appear right after your pinned items. After-apps widgets such as Trash stay at the end of the dock."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appar som körs men inte är fästa visas direkt efter dina fästa objekt. Widgetar efter apparna, som Papperskorgen, ligger kvar i slutet av dockan."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sabitlenmemiş çalışan uygulamalar sabitlenmiş öğelerinin hemen ardından görünür. Çöp Sepeti gibi uygulamalardan sonraki widget'lar dock'un sonunda kalır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Unpinned running apps appear right after your pinned items. After-apps widgets such as Trash stay at the end of the dock."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Các ứng dụng đang chạy không ghim sẽ xuất hiện ngay sau các mục được ghim của bạn. Các tiện ích sau ứng dụng như Thùng rác sẽ luôn nằm ở cuối cùng của dock."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "未固定的运行中的应用会紧接在固定项目之后显示。位于应用后的小组件（如废纸篓）始终显示在 Dock 的末尾。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "未釘選的執行中應用程式會顯示在釘選項目之後。垃圾桶等應用程式後小工具會固定在 Dock 最尾端。"
          }
        }
      }
    },
