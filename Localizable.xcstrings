            "value" : "Sleep bestanden naar het Dock om ze klaar te zetten, scroll vervolgens over het Dock om het bestandsvak te openen en kies wat er gebeurt als je erop klikt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Upuść pliki na Dock, aby umieścić je na Półce plików, a następnie przewiń nad Dockiem, aby ją otworzyć i wybrać czynność wykonywaną po kliknięciu."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Largue ficheiros na dock para os preparar, depois desloque sobre a dock para abrir o tabuleiro e escolha o que os cliques fazem."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Drop files onto the dock to stage them, then scroll over the dock to open the tray and choose what clicks do."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Drop files onto the dock to stage them, then scroll over the dock to open the tray and choose what clicks do."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перетаскивайте файлы на Dock, чтобы подготовить их, затем прокрутите над Dock, чтобы открыть лоток, и выберите действия при нажатии."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Drop files onto the dock to stage them, then scroll over the dock to open the tray and choose what clicks do."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Släpp filer på dockan för att mellanlagra dem, rulla sedan över dockan för att öppna brickan och välj vad klick ska göra."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dosyaları hazırlamak için dock'a bırak, ardından tepsiyi açmak için dock üzerinde kaydır ve tıklamaların ne yapacağını seç."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Drop files onto the dock to stage them, then scroll over the dock to open the tray and choose what clicks do."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thả các tệp vào dock để đưa vào khay tạm, sau đó cuộn qua dock để mở khay và chọn hành động khi nhấp chuột."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将文件拖放到 Dock 上即可暂存，然后在 Dock 上滚动以打开文件托盘，并设置点击操作。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "將檔案拖放到 Dock 上暫存，接著在 Dock 上捲動即可開啟檔案托盤，並設定按一下時要執行的動作。"
          }
        }
      }
    },
