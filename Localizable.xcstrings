    "Fix one end of the dock to a screen position so it stays put when switching dock profiles" : {
      "comment" : "Anchor position description",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تثبيت أحد طرفي Dock في موضع على الشاشة ليبقى ثابتًا عند التبديل بين ملفات تعريف Dock"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fixieren Sie ein Ende des Docks an einer Bildschirmposition, damit es beim Wechseln von Dock-Profilen an Ort und Stelle bleibt"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fija un extremo del Dock a una posición de la pantalla para que no se mueva al cambiar de perfil de Dock"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ancrer une extrémité du dock à une position fixe pour qu'il ne bouge pas lors des changements de profil"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Dock egyik végét a képernyő egy adott pozíciójához rögzíti, így az a Dock-profilok közötti váltáskor is a helyén marad"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dockの一端を画面上の位置に固定して、Dockプロファイルを切り替えても動かないようにします"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zet één uiteinde van het Dock vast op een bepaalde plek op het scherm, zodat het op zijn plaats blijft wanneer je van Dock-profiel wisselt"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przypnij jeden koniec Docka do położenia na wyświetlaczu, aby pozostał w miejscu podczas przełączania profili Docka"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fixar uma extremidade da dock numa posição do ecrã para que fique no mesmo sítio ao mudar de perfil da dock"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Привязать один конец Dock к положению на экране, чтобы он оставался на месте при переключении профилей Dock"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lås ena änden av dockan vid en skärmposition så att den ligger kvar när du växlar dockprofil"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dock’un bir ucunu ekrandaki bir konuma sabitleyerek dock profilleri arasında geçiş yaparken yerinde kalmasını sağlayın"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cố định một đầu của dock vào một vị trí màn hình để giữ nguyên vị trí khi chuyển đổi các hồ sơ dock"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将 Dock 的一端固定在屏幕上的指定位置，以便切换 Dock 配置文件时保持位置不变"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "將 Dock 的一端固定於螢幕上的指定位置，使其在切換 Dock 設定檔時維持原位"
          }
        }
      }
    },
