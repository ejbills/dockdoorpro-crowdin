    "Only reveal from the hidden dock's actual width or height. Turn this off to reveal from anywhere along that display edge." : {
      "comment" : "Settings control description",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Only reveal from the hidden dock's actual width or height. Turn this off to reveal from anywhere along that display edge."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الإظهار فقط من العرض أو الارتفاع الفعلي لـ Dock المخفي. أوقف هذا للإظهار من أي مكان على امتداد حافة تلك الشاشة."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "new",
