        "da" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Pin up to three folders as labeled sections beside the file tray. Each shows the folder's contents and accepts dropped files."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bis zu drei Ordner als beschriftete Bereiche neben der Datei-Ablage anheften. Jeder zeigt den Inhalt des Ordners und nimmt dort abgelegte Dateien auf."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Pin up to three folders as labeled sections beside the file tray. Each shows the folder's contents and accepts dropped files."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fija hasta tres carpetas como secciones etiquetadas junto a la bandeja de archivos. Cada una muestra el contenido de la carpeta y acepta archivos arrastrados."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Pin up to three folders as labeled sections beside the file tray. Each shows the folder's contents and accepts dropped files."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Épinglez jusqu'à trois dossiers comme sections étiquetées à côté du tiroir de fichiers. Chacune affiche le contenu du dossier et accepte les fichiers déposés."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Pin up to three folders as labeled sections beside the file tray. Each shows the folder's contents and accepts dropped files."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Legfeljebb három mappát tűzhet ki címkézett szakaszként a Fájltároló Tálca mellé. Mindegyik a mappa tartalmát mutatja, és fogadja az odahúzott fájlokat."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Pin up to three folders as labeled sections beside the file tray. Each shows the folder's contents and accepts dropped files."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ファイルトレイの横に、最大3つのフォルダをラベル付きセクションとしてピン留めできます。各セクションはフォルダの内容を表示し、ドロップされたファイルを受け取ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Pin up to three folders as labeled sections beside the file tray. Each shows the folder's contents and accepts dropped files."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Pin up to three folders as labeled sections beside the file tray. Each shows the folder's contents and accepts dropped files."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je kunt maximaal drie mappen als gelabelde secties naast het bestandsvak vastzetten. In elke sectie wordt de inhoud van de map weergegeven en kun je bestanden neerzetten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przypnij maksymalnie trzy foldery jako podpisane sekcje obok Półki plików. Każda sekcja pokazuje zawartość folderu i przyjmuje upuszczane pliki."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afixe até três pastas como secções identificadas ao lado do tabuleiro de ficheiros. Cada uma mostra o conteúdo da pasta e aceita ficheiros largados."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Pin up to three folders as labeled sections beside the file tray. Each shows the folder's contents and accepts dropped files."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Pin up to three folders as labeled sections beside the file tray. Each shows the folder's contents and accepts dropped files."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Закрепите до трёх папок как именованные разделы рядом с лотком файлов. Каждая показывает содержимое папки и принимает перетаскиваемые файлы."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Pin up to three folders as labeled sections beside the file tray. Each shows the folder's contents and accepts dropped files."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fäst upp till tre mappar som etiketterade sektioner bredvid filbrickan. Varje sektion visar mappens innehåll och tar emot släppta filer."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dosya tepsisinin yanında etiketli bölümler olarak en fazla üç klasör sabitle. Her biri klasörün içeriğini gösterir ve bırakılan dosyaları kabul eder."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Pin up to three folders as labeled sections beside the file tray. Each shows the folder's contents and accepts dropped files."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ghim tối đa ba thư mục dưới dạng các mục có nhãn bên cạnh khay tệp. Mỗi mục sẽ hiển thị nội dung của thư mục và chấp nhận các tệp được thả vào."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最多可将 3 个文件夹固定为文件托盘旁带标签的分区。每个分区都会显示对应文件夹的内容，并可接收拖放的文件。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最多可將三個檔案夾釘選為檔案托盤旁的標示區塊。每個區塊都會顯示檔案夾內容，並可接受拖放檔案。"
          }
        }
      }
    },
