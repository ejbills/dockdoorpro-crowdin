          "stringUnit" : {
            "state" : "translated",
            "value" : "Dat kan gebeuren wanneer je de prullenmand opent, de prullenmand leegmaakt, een item in Finder weergeeft of bestandsacties uitvoert die door Finder worden ondersteund. Het leegmaken van de prullenmand wordt door de gebruiker uitgevoerd en is na bevestiging niet meer ongedaan te maken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
