          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DockDoor Pro 不含任何遥测、分析或行为追踪功能。窗口和应用状态均保留在您的 Mac 本地。仅当您启用本地天气时，位置信息才会用于 WeatherKit。网络访问仅用于激活检查、更新以及您选择使用的功能，如 WeatherKit 和歌词查询。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DockDoor Pro 不會收集任何遙測資料、分析資料或使用行為追蹤資訊。所有視窗與應用程式狀態資料皆儲存在您的 Mac 上。位置資訊僅在您啟用本地天氣功能時提供給 WeatherKit 使用。網路存取僅用於授權驗證、更新檢查，以及您選擇使用的功能，例如 WeatherKit 與歌詞查詢。"
          }
        }
      }
