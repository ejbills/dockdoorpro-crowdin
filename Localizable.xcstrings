    "Hide only the focused window of the active app instead of hiding every window. The window comes back the next time you switch to that app." : {
      "comment" : "Settings control description",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Hide only the focused window of the active app instead of hiding every window. The window comes back the next time you switch to that app."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إخفاء النافذة الأمامية فقط في التطبيق النشط بدلًا من إخفاء كل النوافذ. تعود النافذة في المرة التالية التي تنتقل فيها إلى ذلك التطبيق."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Hide only the focused window of the active app instead of hiding every window. The window comes back the next time you switch to that app."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Hide only the focused window of the active app instead of hiding every window. The window comes back the next time you switch to that app."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Hide only the focused window of the active app instead of hiding every window. The window comes back the next time you switch to that app."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur das fokussierte Fenster der aktiven App ausblenden, statt alle Fenster auszublenden. Das Fenster erscheint wieder, wenn Sie das nächste Mal zu dieser App wechseln."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Hide only the focused window of the active app instead of hiding every window. The window comes back the next time you switch to that app."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oculta solo la ventana activa de la app en primer plano en lugar de ocultar todas sus ventanas. La ventana vuelve la próxima vez que cambies a esa app."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Hide only the focused window of the active app instead of hiding every window. The window comes back the next time you switch to that app."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Masquer uniquement la fenêtre au premier plan de l'app active au lieu de masquer toutes ses fenêtres. La fenêtre réapparaît la prochaine fois que vous basculez vers cette app."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Hide only the focused window of the active app instead of hiding every window. The window comes back the next time you switch to that app."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Csak az aktív app fókuszban lévő ablakának elrejtése, az összes ablak elrejtése helyett. Az ablak visszatér, amikor legközelebb erre az appra vált."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Hide only the focused window of the active app instead of hiding every window. The window comes back the next time you switch to that app."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アクティブなアプリのすべてのウインドウを隠す代わりに、フォーカスされているウインドウだけを隠します。次にそのアプリに切り替えたときに、ウインドウが元に戻ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Hide only the focused window of the active app instead of hiding every window. The window comes back the next time you switch to that app."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Hide only the focused window of the active app instead of hiding every window. The window comes back the next time you switch to that app."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verberg alleen het venster met focus van de actieve app in plaats van alle vensters. Het venster komt terug zodra je weer naar die app overschakelt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ukrywaj tylko aktywne okno zamiast wszystkich okien aktywnej aplikacji. Okno pojawi się ponownie przy następnym przełączeniu na tę aplikację."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ocultar apenas a janela em foco da app ativa em vez de ocultar todas as janelas. A janela volta a aparecer da próxima vez que mudar para essa app."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Hide only the focused window of the active app instead of hiding every window. The window comes back the next time you switch to that app."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Hide only the focused window of the active app instead of hiding every window. The window comes back the next time you switch to that app."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Скрывать только активное окно текущего приложения, а не все окна. Окно вернется, когда вы снова переключитесь на это приложение."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Hide only the focused window of the active app instead of hiding every window. The window comes back the next time you switch to that app."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Göm bara det fokuserade fönstret i den aktiva appen i stället för att gömma alla fönster. Fönstret kommer tillbaka nästa gång du byter till appen."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tüm pencereleri gizlemek yerine yalnızca etkin uygulamanın odaklanan penceresini gizle. Pencere, o uygulamaya bir sonraki geçişinde geri gelir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Hide only the focused window of the active app instead of hiding every window. The window comes back the next time you switch to that app."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chỉ ẩn cửa sổ đang được đặt tiêu điểm của ứng dụng hiện tại thay vì ẩn toàn bộ cửa sổ. Cửa sổ sẽ xuất hiện trở lại vào lần tiếp theo bạn chuyển sang ứng dụng đó."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅隐藏当前应用的焦点窗口，不隐藏全部窗口；切回该应用时窗口自动恢复。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "僅隱藏目前應用程式中聚焦的視窗，而非隱藏所有視窗。下次切換至該應用程式時，這個視窗會重新顯示。"
          }
        }
      }
    },
