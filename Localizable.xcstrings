    "Drag apps, files, or folders onto the dock to pin them. To combine apps into one icon, use Edit ▸ Add Item ▸ App Group." : {
      "comment" : "Pinned items help note",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Drag apps, files, or folders onto the dock to pin them. To combine apps into one icon, use Edit ▸ Add Item ▸ App Group."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اسحب تطبيقات أو ملفات أو مجلدات إلى Dock لتثبيتها. لدمج تطبيقات في أيقونة واحدة، استخدم تحرير ▸ إضافة عنصر ▸ مجموعة تطبيقات."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Drag apps, files, or folders onto the dock to pin them. To combine apps into one icon, use Edit ▸ Add Item ▸ App Group."
          }
        },
        "cs" : {
          "stringUnit" : {
