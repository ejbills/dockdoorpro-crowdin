            "value" : "A billentyűzetfókusz a keresőmezőbe kerül, amikor a váltó megnyílik. A váltó ezután a billentyűparancs felengedése után is nyitva marad."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Put the keyboard in the search field when the switcher opens. The switcher then stays open after the shortcut is released."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スイッチャーが開いたときに、キーボードの入力先を検索フィールドにします。その後、ショートカットを離してもスイッチャーは開いたままになります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Put the keyboard in the search field when the switcher opens. The switcher then stays open after the shortcut is released."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Put the keyboard in the search field when the switcher opens. The switcher then stays open after the shortcut is released."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zet het toetsenbord in het zoekveld zodra de wisselaar wordt geopend. De wisselaar blijft dan open staan nadat de sneltoets is losgelaten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktywuj pole wyszukiwania po otwarciu przełącznika. Przełącznik pozostanie otwarty po zwolnieniu skrótu."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Colocar o teclado no campo de pesquisa quando o alternador abre. O alternador fica então aberto depois de soltar o atalho."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Put the keyboard in the search field when the switcher opens. The switcher then stays open after the shortcut is released."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Put the keyboard in the search field when the switcher opens. The switcher then stays open after the shortcut is released."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Переводить фокус клавиатуры в поле поиска при открытии переключателя. После этого переключатель остается открытым, даже когда вы отпускаете сочетание клавиш."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Put the keyboard in the search field when the switcher opens. The switcher then stays open after the shortcut is released."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Placera tangentbordsfokus i sökfältet när växlaren öppnas. Växlaren förblir då öppen när kortkommandot släpps."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Değiştirici açıldığında klavyeyi arama alanına odakla. Değiştirici, kısayol bırakıldıktan sonra da açık kalır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Put the keyboard in the search field when the switcher opens. The switcher then stays open after the shortcut is released."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đặt tiêu điểm bàn phím vào trường tìm kiếm khi bộ chuyển đổi mở ra. Bộ chuyển đổi sau đó sẽ giữ nguyên trạng thái mở sau khi thả phím tắt."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "切换器开启时自动聚焦搜索栏位。放开快捷键后，切换器仍会保持开启。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "切換器開啟時自動聚焦搜尋欄位。放開快速鍵後，切換器仍會保持開啟。"
          }
        }
      }
    },
