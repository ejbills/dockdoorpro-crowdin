    "Hold %@ and press a letter to jump to matching dock apps. Press the same letter again to cycle matches." : {
      "comment" : "Keyboard onboarding description",
      "extractionState" : "stale",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Hold %@ and press a letter to jump to matching dock apps. Press the same letter again to cycle matches."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اضغط على %@ واضغط على رسالة للقفز إلى مطابقة تطبيقات الرصيف. اضغط على نفس الحرف مرة أخرى لمطابقات الدورة."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Hold %@ and press a letter to jump to matching dock apps. Press the same letter again to cycle matches."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Hold %@ and press a letter to jump to matching dock apps. Press the same letter again to cycle matches."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Hold %@ and press a letter to jump to matching dock apps. Press the same letter again to cycle matches."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halten Sie %@ gedrückt und drücken Sie einen Buchstaben, um zu passenden Dock-Apps zu springen. Drücken Sie denselben Buchstaben erneut, um zwischen Treffern zu wechseln."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Hold %@ and press a letter to jump to matching dock apps. Press the same letter again to cycle matches."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Hold %@ and press a letter to jump to matching dock apps. Press the same letter again to cycle matches."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Hold %@ and press a letter to jump to matching dock apps. Press the same letter again to cycle matches."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maintenez %@ et appuyez sur une lettre pour accéder aux apps du dock correspondantes. \nAppuyez à nouveau sur la même lettre pour basculer entre les correspondances."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Hold %@ and press a letter to jump to matching dock apps. Press the same letter again to cycle matches."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tartsd lenyomva a %@ billentyűt, és nyomj meg egy betűt a megfelelő Dock alkalmazásra ugráshoz. Nyomd meg újra ugyanazt a betűt a találatok közötti váltáshoz."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Hold %@ and press a letter to jump to matching dock apps. Press the same letter again to cycle matches."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Hold %@ and press a letter to jump to matching dock apps. Press the same letter again to cycle matches."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Hold %@ and press a letter to jump to matching dock apps. Press the same letter again to cycle matches."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Hold %@ and press a letter to jump to matching dock apps. Press the same letter again to cycle matches."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Houd %@ ingedrukt en druk op een letter om naar overeenkomende Dock-apps te springen. Druk nogmaals op dezelfde letter om door de overeenkomsten te bladeren."
          }
        },
        "pl" : {
