    "Pin up to three folders as labeled sections beside the file tray. Each shows the folder's contents and accepts dropped files." : {
      "comment" : "Pinned folders settings note",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Pin up to three folders as labeled sections beside the file tray. Each shows the folder's contents and accepts dropped files."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ثبّت حتى ثلاثة مجلدات كأقسام معنونة بجانب حاوية الملفات. يعرض كل قسم محتويات مجلده ويقبل الملفات المسحوبة إليه."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "new",
