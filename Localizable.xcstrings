    "Cap how wide this folder's zone gets on a bottom/top dock, or how tall on a side dock. Unlimited fills its share of the row and scrolls." : {
      "comment" : "Pinned folder zone size description",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Cap how wide this folder's zone gets on a bottom/top dock, or how tall on a side dock. Unlimited fills its share of the row and scrolls."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حدّد أقصى عرض لمنطقة هذا المجلد عندما يكون Dock في الأسفل أو الأعلى، أو أقصى ارتفاع لها عندما يكون على الجانب. يملأ «غير محدود» حصته من الصف مع إمكانية التمرير."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Cap how wide this folder's zone gets on a bottom/top dock, or how tall on a side dock. Unlimited fills its share of the row and scrolls."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Cap how wide this folder's zone gets on a bottom/top dock, or how tall on a side dock. Unlimited fills its share of the row and scrolls."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Cap how wide this folder's zone gets on a bottom/top dock, or how tall on a side dock. Unlimited fills its share of the row and scrolls."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Begrenzt, wie breit der Bereich dieses Ordners bei einem Dock unten/oben oder wie hoch er bei einem seitlichen Dock werden darf. Bei „Unbegrenzt“ füllt der Bereich seinen Anteil der Zeile und lässt sich scrollen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Cap how wide this folder's zone gets on a bottom/top dock, or how tall on a side dock. Unlimited fills its share of the row and scrolls."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Limita el ancho de la zona de esta carpeta en un Dock inferior o superior, o su altura en un Dock lateral. Ilimitado ocupa su parte de la fila y se desplaza."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Cap how wide this folder's zone gets on a bottom/top dock, or how tall on a side dock. Unlimited fills its share of the row and scrolls."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Limite la largeur de la zone de ce dossier sur un dock en bas ou en haut, ou sa hauteur sur un dock latéral. Illimité remplit sa part de la rangée et défile."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Cap how wide this folder's zone gets on a bottom/top dock, or how tall on a side dock. Unlimited fills its share of the row and scrolls."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Korlátozza, milyen széles lehet a mappa zónája alsó/felső Dockon, illetve milyen magas oldalsó Dockon. A Korlátlan kitölti a sorból rá eső részt, és görgethető."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Cap how wide this folder's zone gets on a bottom/top dock, or how tall on a side dock. Unlimited fills its share of the row and scrolls."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "下または上のDockではこのフォルダゾーンの幅の上限を、左右のDockでは高さの上限を設定します。「無制限」では行内の割り当て分いっぱいに広がり、スクロールします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Cap how wide this folder's zone gets on a bottom/top dock, or how tall on a side dock. Unlimited fills its share of the row and scrolls."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Cap how wide this folder's zone gets on a bottom/top dock, or how tall on a side dock. Unlimited fills its share of the row and scrolls."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stel in hoe breed de zone van deze map wordt in een Dock aan de onder- of bovenkant, of hoe hoog in een Dock aan de zijkant. Bij 'Onbeperkt' vult de map zijn deel van de rij en kun je erin scrollen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogranicz szerokość strefy tego folderu w Docku u dołu lub u góry albo jej wysokość w Docku z boku. Bez limitu strefa wypełnia swoją część rzędu i może być przewijana."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Limite a largura da zona desta pasta numa Dock inferior/superior, ou a altura numa Dock lateral. Ilimitado preenche a sua parte da fila e desloca-se."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Cap how wide this folder's zone gets on a bottom/top dock, or how tall on a side dock. Unlimited fills its share of the row and scrolls."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Cap how wide this folder's zone gets on a bottom/top dock, or how tall on a side dock. Unlimited fills its share of the row and scrolls."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ограничьте ширину области этой папки, когда Dock находится внизу или вверху экрана, или ее высоту, когда Dock сбоку. «Без ограничений» заполняет свою долю ряда с прокруткой."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Cap how wide this folder's zone gets on a bottom/top dock, or how tall on a side dock. Unlimited fills its share of the row and scrolls."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Begränsa hur bred den här mappens zon blir i en dock nedtill/upptill, eller hur hög i en dock på sidan. Obegränsat fyller sin del av raden och skrollar."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu klasörün alt/üst dock'ta ne kadar geniş, yan dock'ta ne kadar uzun olacağını sınırla. Sınırsız, satırdaki payını doldurur ve kaydırılır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Cap how wide this folder's zone gets on a bottom/top dock, or how tall on a side dock. Unlimited fills its share of the row and scrolls."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Giới hạn độ rộng vùng của thư mục này trên dock dưới/dock trên, hoặc giới hạn chiều cao trên dock bên. Không giới hạn sẽ chiếm toàn bộ phần của nó trong hàng và cho phép cuộn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "限制此文件夹区域在顶部或底部 Dock 中的最大宽度，以及在侧边 Dock 中的最大高度。设为“不限”时，它会占满所在行分配的空间，并通过滚动显示内容。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "設定此檔案夾區域的最大尺寸。在上方或下方 Dock 中限制其寬度，在側邊 Dock 中限制其高度。選擇「無限制」時，將填滿所分配的列空間，並可透過捲動瀏覽內容。"
          }
        }
      }
    },
