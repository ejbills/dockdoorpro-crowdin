    "Hover a dock item to trigger it, including window previews, folder fan-outs, and widgets. Applies dock-wide, with per-category exceptions." : {
      "comment" : "Settings search description",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Hover a dock item to trigger it, including window previews, folder fan-outs, and widgets. Applies dock-wide, with per-category exceptions."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مرّر المؤشر فوق عنصر في Dock لتشغيله، بما في ذلك معاينات النوافذ والعرض المروحي للمجلدات والأدوات. ينطبق على Dock بالكامل، مع استثناءات لكل فئة."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Hover a dock item to trigger it, including window previews, folder fan-outs, and widgets. Applies dock-wide, with per-category exceptions."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Hover a dock item to trigger it, including window previews, folder fan-outs, and widgets. Applies dock-wide, with per-category exceptions."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Hover a dock item to trigger it, including window previews, folder fan-outs, and widgets. Applies dock-wide, with per-category exceptions."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeigen Sie auf ein Dock-Objekt, um es auszulösen, einschließlich Fenstervorschauen, Ordner-Auffächerungen und Widgets. Gilt für das gesamte Dock, mit Ausnahmen pro Kategorie."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Hover a dock item to trigger it, including window previews, folder fan-outs, and widgets. Applies dock-wide, with per-category exceptions."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pasa el cursor sobre un ítem del Dock para activarlo, incluidas las previsualizaciones de ventanas, las carpetas en abanico y los widgets. Se aplica a todo el Dock, con excepciones por categoría."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Hover a dock item to trigger it, including window previews, folder fan-outs, and widgets. Applies dock-wide, with per-category exceptions."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Survolez un élément du dock pour le déclencher, y compris les aperçus de fenêtres, les dossiers en éventail et les widgets. S'applique à tout le dock, avec des exceptions par catégorie."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Hover a dock item to trigger it, including window previews, folder fan-outs, and widgets. Applies dock-wide, with per-category exceptions."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rámutatással aktiválhatók a Dock elemei, beleértve az ablak-előnézeteket, a mappalegyezőket és a widgeteket. Az egész Dockra vonatkozik, kategóriánkénti kivételekkel."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Hover a dock item to trigger it, including window previews, folder fan-outs, and widgets. Applies dock-wide, with per-category exceptions."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dockの項目にホバーして作動させます。ウインドウプレビュー、フォルダのファンアウト、ウィジェットも対象です。Dock全体に適用され、カテゴリごとに例外を設定できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Hover a dock item to trigger it, including window previews, folder fan-outs, and widgets. Applies dock-wide, with per-category exceptions."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Hover a dock item to trigger it, including window previews, folder fan-outs, and widgets. Applies dock-wide, with per-category exceptions."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beweeg de muisaanwijzer over een Dock-item om het te activeren, inclusief venstervoorbeelden, uitgeklapte mappen en widgets. Geldt voor het hele Dock, met uitzonderingen per categorie."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Umieść wskaźnik nad elementem Docka, aby go uaktywnić. Dotyczy to podglądów okien, rozwinięć folderów i widżetów. Ustawienie obejmuje cały Dock, z wyjątkami dla poszczególnych kategorii."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passe o cursor sobre um item da Dock para o ativar, incluindo pré-visualizações de janelas, leques de pastas e widgets. Aplica-se a toda a Dock, com exceções por categoria."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Hover a dock item to trigger it, including window previews, folder fan-outs, and widgets. Applies dock-wide, with per-category exceptions."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Hover a dock item to trigger it, including window previews, folder fan-outs, and widgets. Applies dock-wide, with per-category exceptions."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Наведение указателя на объект в Dock активирует его, включая предпросмотр окон, веер папок и виджеты. Действует для всего Dock с исключениями для отдельных категорий."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Hover a dock item to trigger it, including window previews, folder fan-outs, and widgets. Applies dock-wide, with per-category exceptions."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hovra över ett dockobjekt för att aktivera det, inklusive fönsterförhandsvisningar, mappsolfjädrar och widgetar. Gäller hela dockan, med undantag per kategori."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir dock öğesinin üzerine gelince tetiklenir, pencere önizlemeleri, klasör yelpazeleri ve widget'lar da dahil. Dock genelinde geçerlidir, kategori bazında istisnalarla."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Hover a dock item to trigger it, including window previews, folder fan-outs, and widgets. Applies dock-wide, with per-category exceptions."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Di chuột lên một mục trên dock để kích hoạt mục đó, bao gồm bản xem trước cửa sổ, xòe thư mục và tiện ích. Áp dụng cho toàn bộ dock, với các ngoại lệ theo từng danh mục."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "悬停在 Dock 项目上以触发窗口预览、文件夹展开或小组件等功能。适用于整个 Dock，可按类别设置例外。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "將指標停留在 Dock 項目上即可觸發對應功能，包括視窗預覽、檔案夾展開與小工具。此設定會套用至整個 Dock，但各類別可另行設定例外。"
          }
        }
      }
    },
