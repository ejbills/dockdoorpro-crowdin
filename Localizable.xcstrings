        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для показа быстрых действий в док: перейдите к стеку виджета, добавьте стек, а затем добавьте виджет быстрых действий к нему. Настройте какие действия закреплены ниже. Долгое нажатие на виджет, чтобы открыть полную панель управления."
          }
        },
        "sr" : {
