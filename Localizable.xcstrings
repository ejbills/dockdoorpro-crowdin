          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Only reveal from the hidden dock's actual width or height. Turn this off to reveal from anywhere along that display edge."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das ausgeblendete Dock nur innerhalb seiner tatsächlichen Breite oder Höhe einblenden. Deaktivieren Sie diese Option, um es überall entlang dieser Bildschirmkante einzublenden."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Only reveal from the hidden dock's actual width or height. Turn this off to reveal from anywhere along that display edge."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Revela el Dock oculto solo desde su ancho o alto real. Desactívalo para revelarlo desde cualquier punto de ese borde de la pantalla."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Only reveal from the hidden dock's actual width or height. Turn this off to reveal from anywhere along that display edge."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
