    "Start with a dock layout that matches how you want DockDoor Pro to feel. You can change every choice later in Settings." : {
      "comment" : "Onboarding setup style subtitle",
      "extractionState" : "manual",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Start with a dock layout that matches how you want DockDoor Pro to feel. You can change every choice later in Settings."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ابدأ بتخطيط لـ Dock يطابق الطابع الذي تريده لـ DockDoor Pro. يمكنك تغيير كل خيار لاحقًا في الإعدادات."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Start with a dock layout that matches how you want DockDoor Pro to feel. You can change every choice later in Settings."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Start with a dock layout that matches how you want DockDoor Pro to feel. You can change every choice later in Settings."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Start with a dock layout that matches how you want DockDoor Pro to feel. You can change every choice later in Settings."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beginnen Sie mit einem Dock-Layout, das zum gewünschten Erscheinungsbild von DockDoor Pro passt. Sie können jede Auswahl später in den Einstellungen ändern."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Start with a dock layout that matches how you want DockDoor Pro to feel. You can change every choice later in Settings."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Empieza con una disposición del Dock que refleje cómo quieres que se sienta DockDoor Pro. Puedes cambiar cualquier elección más tarde en Ajustes."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Start with a dock layout that matches how you want DockDoor Pro to feel. You can change every choice later in Settings."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Commencez avec une disposition de Dock qui correspond à l'expérience DockDoor Pro que vous souhaitez. Vous pourrez modifier chaque choix plus tard dans les Paramètres."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Start with a dock layout that matches how you want DockDoor Pro to feel. You can change every choice later in Settings."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kezdjen egy olyan Dock-elrendezéssel, amely megfelel annak, ahogyan a DockDoor Pro működését elképzeli. Minden választás később módosítható a Beállításokban."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Start with a dock layout that matches how you want DockDoor Pro to feel. You can change every choice later in Settings."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DockDoor Proの使い心地に合ったDockレイアウトから始めましょう。すべての選択は後で設定から変更できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Start with a dock layout that matches how you want DockDoor Pro to feel. You can change every choice later in Settings."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Start with a dock layout that matches how you want DockDoor Pro to feel. You can change every choice later in Settings."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Begin met een indeling die past bij de uitstraling die je voor DockDoor Pro in gedachten hebt. Je kunt alle instellingen later aanpassen via 'Instellingen'."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zacznij od układu Docka, który pasuje do tego, jak DockDoor Pro ma działać. Każdy wybór możesz później zmienić w Ustawieniach."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comece com uma disposição da dock que corresponda ao estilo que pretende para o DockDoor Pro. Pode alterar todas as escolhas mais tarde nas Definições."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Start with a dock layout that matches how you want DockDoor Pro to feel. You can change every choice later in Settings."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Start with a dock layout that matches how you want DockDoor Pro to feel. You can change every choice later in Settings."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Начните с макета Dock, который соответствует тому, каким вы хотите видеть DockDoor Pro. Любой выбор можно изменить позже в настройках."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Start with a dock layout that matches how you want DockDoor Pro to feel. You can change every choice later in Settings."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Börja med en docklayout som passar hur du vill att DockDoor Pro ska kännas. Du kan ändra varje val senare i Inställningar."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DockDoor Pro'nun nasıl hissettirmesini istediğine uyan bir dock düzeniyle başla. Her seçimi daha sonra Ayarlar'dan değiştirebilirsin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Start with a dock layout that matches how you want DockDoor Pro to feel. You can change every choice later in Settings."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bắt đầu với một bố cục dock phù hợp với trải nghiệm mong muốn của bạn với DockDoor Pro. Bạn có thể thay đổi mọi lựa chọn sau này trong phần Cài đặt."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "选择一个符合你使用习惯的 Dock 布局，打造属于你的 DockDoor Pro。所有设置稍后都可以在“设置”中修改。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "先選擇符合您理想使用體驗的 Dock 配置。之後可隨時在「設定」中變更所有選項。"
          }
        }
      }
    },
    "Start with floating or taskbar style, then continue through Appearance for size, indicators, and background." : {
