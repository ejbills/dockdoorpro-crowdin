    "Choose a dot, card, or no marker for open apps. With Enhanced Running Indicators on, apps with no open windows show a hollow dot or a card without dots." : {
      "comment" : "Settings search description",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Choose a dot, card, or no marker for open apps. With Enhanced Running Indicators on, apps with no open windows show a hollow dot or a card without dots."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اختر نقطة أو بطاقة أو بلا علامة للتطبيقات المفتوحة. عند تشغيل «مؤشرات التشغيل المحسّنة»، تُظهر التطبيقات التي ليس لها نوافذ مفتوحة نقطة مجوفة أو بطاقة بدون نقاط."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Choose a dot, card, or no marker for open apps. With Enhanced Running Indicators on, apps with no open windows show a hollow dot or a card without dots."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Choose a dot, card, or no marker for open apps. With Enhanced Running Indicators on, apps with no open windows show a hollow dot or a card without dots."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Choose a dot, card, or no marker for open apps. With Enhanced Running Indicators on, apps with no open windows show a hollow dot or a card without dots."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wählen Sie einen Punkt, eine Karte oder keine Markierung für geöffnete Apps. Mit „Erweiterte Aktivitätsanzeigen“ zeigen Apps ohne geöffnete Fenster einen hohlen Punkt oder eine Karte ohne Punkte."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Choose a dot, card, or no marker for open apps. With Enhanced Running Indicators on, apps with no open windows show a hollow dot or a card without dots."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige un punto, una tarjeta o ningún indicador para las apps abiertas. Con Indicadores mejorados de apps abiertas activado, las apps sin ventanas abiertas muestran un punto hueco o una tarjeta sin puntos."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Choose a dot, card, or no marker for open apps. With Enhanced Running Indicators on, apps with no open windows show a hollow dot or a card without dots."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez un point, une carte ou aucun repère pour les apps ouvertes. Avec les indicateurs d'apps actives améliorés, les apps sans fenêtre ouverte affichent un point creux ou une carte sans points."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Choose a dot, card, or no marker for open apps. With Enhanced Running Indicators on, apps with no open windows show a hollow dot or a card without dots."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Válasszon pontot, kártyát vagy jelölés nélküli megjelenítést a nyitott appokhoz. Ha a Továbbfejlesztett alkalmazásjelzők be vannak kapcsolva, a nyitott ablak nélküli appok üres pontot vagy pontok nélküli kártyát mutatnak."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Choose a dot, card, or no marker for open apps. With Enhanced Running Indicators on, apps with no open windows show a hollow dot or a card without dots."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "起動中のアプリのマーカーとして、ドット、カード、またはなしを選択します。「強化された実行中インジケータ」がオンの場合、開いているウインドウがないアプリには中抜きのドット、またはドットのないカードが表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Choose a dot, card, or no marker for open apps. With Enhanced Running Indicators on, apps with no open windows show a hollow dot or a card without dots."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Choose a dot, card, or no marker for open apps. With Enhanced Running Indicators on, apps with no open windows show a hollow dot or a card without dots."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kies een stip, een kaartje of geen aanduiding voor geopende apps. Als ‘Verbeterde aanduiding voor geopende apps’ is ingeschakeld, worden apps zonder geopende vensters weergegeven met een holle stip of een kaart zonder stippen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wybierz kropkę, kartę albo brak oznaczenia otwartych aplikacji. Po włączeniu opcji Ulepszone wskaźniki uruchomionych aplikacji aplikacje bez otwartych okien są oznaczane kropką z pustym środkiem albo kartą bez kropek."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolha um ponto, um cartão ou nenhum marcador para as apps abertas. Com os Indicadores de Execução Melhorados ativos, as apps sem janelas abertas mostram um ponto vazio ou um cartão sem pontos."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Choose a dot, card, or no marker for open apps. With Enhanced Running Indicators on, apps with no open windows show a hollow dot or a card without dots."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Choose a dot, card, or no marker for open apps. With Enhanced Running Indicators on, apps with no open windows show a hollow dot or a card without dots."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выберите точку, карточку или отсутствие метки для открытых приложений. Если включены «Улучшенные активные индикаторы», у приложений без открытых окон отображается полая точка или карточка без точек."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Choose a dot, card, or no marker for open apps. With Enhanced Running Indicators on, apps with no open windows show a hollow dot or a card without dots."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Välj en punkt, ett kort eller ingen markör för öppna appar. När Förbättrade indikatorer för appar som körs är på visar appar utan öppna fönster en ihålig punkt eller ett kort utan punkter."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Açık uygulamalar için nokta, kart veya işaretleyici yok seçeneklerinden birini seçin. Gelişmiş Çalışma Göstergeleri açıkken, açık penceresi olmayan uygulamalar içi boş bir nokta veya noktasız bir kart gösterir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Choose a dot, card, or no marker for open apps. With Enhanced Running Indicators on, apps with no open windows show a hollow dot or a card without dots."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chọn dấu chấm, thẻ hoặc không đánh dấu cho ứng dụng đang mở. Khi bật Chỉ báo ứng dụng đang chạy nâng cao, các ứng dụng không có cửa sổ mở sẽ hiển thị dấu chấm rỗng hoặc thẻ không có dấu chấm."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "为打开的应用选择圆点、卡片或不显示标记。启用“增强运行指示器”后，没有打开窗口的应用将显示空心圆点或不带圆点的卡片。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選擇以圓點、卡片或不顯示標記來表示已開啟的應用程式。啟用「增強型執行中指示器」後，沒有開啟視窗的應用程式會顯示空心圓點，或顯示不含圓點的卡片。"
          }
        }
      }
    },
