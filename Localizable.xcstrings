    "Profiles change the app row for a workflow. You decide whether they switch manually, per display, or with opt-in AppSense." : {
      "comment" : "Onboarding profile switching subtitle",
      "extractionState" : "manual",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Profiles change the app row for a workflow. You decide whether they switch manually, per display, or with opt-in AppSense."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تغيّر ملفات التعريف صف التطبيقات بحسب سير العمل. أنت من يقرر ما إذا كانت تتبدل يدويًا، أو حسب كل شاشة، أو عبر ميزة AppSense الاختيارية."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Profiles change the app row for a workflow. You decide whether they switch manually, per display, or with opt-in AppSense."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Profiles change the app row for a workflow. You decide whether they switch manually, per display, or with opt-in AppSense."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Profiles change the app row for a workflow. You decide whether they switch manually, per display, or with opt-in AppSense."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Profile ändern die App-Symbolreihe je nach Workflow. Sie entscheiden, ob sie manuell, pro Display oder mit optionalem AppSense wechseln."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Profiles change the app row for a workflow. You decide whether they switch manually, per display, or with opt-in AppSense."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los perfiles cambian la fila de apps según el flujo de trabajo. Tú decides si cambian manualmente, por pantalla o con AppSense opcional."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Profiles change the app row for a workflow. You decide whether they switch manually, per display, or with opt-in AppSense."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les profils changent la rangée d'apps selon le flux de travail. Vous décidez s'ils basculent manuellement, par écran ou avec AppSense en option."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Profiles change the app row for a workflow. You decide whether they switch manually, per display, or with opt-in AppSense."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A profilok a munkafolyamathoz igazítják az appsort. Ön dönti el, hogy kézzel, kijelzőnként vagy a bekapcsolható AppSense-szel váltsanak."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Profiles change the app row for a workflow. You decide whether they switch manually, per display, or with opt-in AppSense."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プロファイルはワークフローに合わせてアプリの並びを変更します。手動、ディスプレイごと、またはオプトインのAppSenseのどれで切り替えるかを選べます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Profiles change the app row for a workflow. You decide whether they switch manually, per display, or with opt-in AppSense."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Profiles change the app row for a workflow. You decide whether they switch manually, per display, or with opt-in AppSense."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Profielen wijzigen de app-rij voor een workflow. Je bepaalt zelf of dit handmatig gebeurt, per scherm of via de opt-in-functie van AppSense."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Profile zmieniają rząd aplikacji dla konkretnego sposobu pracy. Możesz przełączać je ręcznie, osobno dla wyświetlaczy lub automatycznie za pomocą AppSense."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os perfis mudam a fila de aplicações consoante o fluxo de trabalho. Decide se mudam manualmente, por ecrã ou com o AppSense opcional."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Profiles change the app row for a workflow. You decide whether they switch manually, per display, or with opt-in AppSense."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Profiles change the app row for a workflow. You decide whether they switch manually, per display, or with opt-in AppSense."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Профили меняют ряд приложений для рабочего процесса. Вы решаете, переключать ли их вручную, по дисплею или с помощью AppSense."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Profiles change the app row for a workflow. You decide whether they switch manually, per display, or with opt-in AppSense."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Profiler ändrar appraden för ett arbetsflöde. Du bestämmer om de växlar manuellt, per bildskärm eller med AppSense som tillval."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Profiller, bir iş akışı için uygulama satırını değiştirir. Elle mi, ekran başına mı yoksa isteğe bağlı AppSense ile mi geçeceklerine sen karar verirsin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Profiles change the app row for a workflow. You decide whether they switch manually, per display, or with opt-in AppSense."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Các hồ sơ giúp thay đổi hàng ứng dụng cho một quy trình làm việc. Bạn quyết định chuyển đổi chúng theo cách thủ công, theo từng màn hình hoặc tự động bằng cách kích hoạt AppSense."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "配置文件可为不同使用场景切换应用行。你可以选择手动切换、按显示器自动切换，或通过启用 AppSense 自动切换。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "設定檔可為不同工作流程使用不同的應用程式列配置。您可選擇手動切換、依顯示器套用，或啟用 AppSense 自動切換。"
          }
        }
      }
    },
    "Profiles own pinned items and linked apps. Widgets, Trash, previews, and keyboard switching are shared dock-wide settings." : {
      "comment" : "Onboarding profile switching footer hint",
      "extractionState" : "manual",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Profiles own pinned items and linked apps. Widgets, Trash, previews, and keyboard switching are shared dock-wide settings."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تمتلك ملفات التعريف العناصر المثبتة والتطبيقات المرتبطة. أما الأدوات والمهملات والمعاينات والتبديل عبر لوحة المفاتيح فهي إعدادات مشتركة على مستوى Dock كله."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Profiles own pinned items and linked apps. Widgets, Trash, previews, and keyboard switching are shared dock-wide settings."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Profiles own pinned items and linked apps. Widgets, Trash, previews, and keyboard switching are shared dock-wide settings."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Profiles own pinned items and linked apps. Widgets, Trash, previews, and keyboard switching are shared dock-wide settings."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Profile haben eigene angeheftete Elemente und verknüpfte Apps. Widgets, Papierkorb, Vorschauen und das Umschalten per Tastatur sind gemeinsame Einstellungen für das gesamte Dock."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Profiles own pinned items and linked apps. Widgets, Trash, previews, and keyboard switching are shared dock-wide settings."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los perfiles gestionan los elementos fijados y las apps vinculadas. Los widgets, la Papelera, las previsualizaciones y el cambio con teclado son ajustes compartidos de todo el Dock."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Profiles own pinned items and linked apps. Widgets, Trash, previews, and keyboard switching are shared dock-wide settings."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les profils possèdent les éléments épinglés et les apps liées. Les widgets, la Corbeille, les aperçus et le changement au clavier sont des réglages communs à tout le dock."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Profiles own pinned items and linked apps. Widgets, Trash, previews, and keyboard switching are shared dock-wide settings."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A profilokhoz tartoznak a kitűzött elemek és a csatolt appok. A widgetek, a Kuka, az előnézetek és a billentyűzetes váltás a teljes Dockra közös beállítások."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Profiles own pinned items and linked apps. Widgets, Trash, previews, and keyboard switching are shared dock-wide settings."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プロファイルはピン留め項目とリンクされたアプリを保持します。ウィジェット、ゴミ箱、プレビュー、キーボード切り替えはDock全体で共有される設定です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Profiles own pinned items and linked apps. Widgets, Trash, previews, and keyboard switching are shared dock-wide settings."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Profiles own pinned items and linked apps. Widgets, Trash, previews, and keyboard switching are shared dock-wide settings."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Profielen bevatten vastgezette items en gekoppelde apps. Widgets, prullenmand, voorbeelden en wisselen met het toetsenbord zijn instellingen die voor het hele Dock gelden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Profile zarządzają przypiętymi elementami i powiązanymi aplikacjami. Widżety, Kosz, podglądy i przełączanie klawiaturą są ustawieniami wspólnymi dla całego Docka."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os perfis detêm os itens afixados e as aplicações associadas. Widgets, Lixo, pré-visualizações e alternância por teclado são definições partilhadas de toda a dock."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Profiles own pinned items and linked apps. Widgets, Trash, previews, and keyboard switching are shared dock-wide settings."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Profiles own pinned items and linked apps. Widgets, Trash, previews, and keyboard switching are shared dock-wide settings."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Профилям принадлежат закрепленные объекты и связанные приложения. Виджеты, Корзина, предпросмотр и переключение с клавиатуры являются общими настройками для всего Dock."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Profiles own pinned items and linked apps. Widgets, Trash, previews, and keyboard switching are shared dock-wide settings."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Profiler äger fästa objekt och länkade appar. Widgetar, papperskorgen, förhandsvisningar och tangentbordsväxling är delade inställningar för hela docken."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Profiller sabitlenmiş öğelere ve bağlı uygulamalara sahiptir. Widget'lar, Çöp Sepeti, önizlemeler ve klavye geçişi dock genelinde paylaşılan ayarlardır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Profiles own pinned items and linked apps. Widgets, Trash, previews, and keyboard switching are shared dock-wide settings."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mỗi hồ sơ sở hữu riêng các mục được ghim và ứng dụng được liên kết. Tiện ích, Thùng rác, bản xem trước và chuyển đổi bằng bàn phím là các cài đặt chia sẻ trên toàn bộ dock."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "配置文件包含固定项目和关联应用。小组件、废纸篓、预览以及键盘切换属于 Dock 全局设置。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每個設定檔都有自己的釘選項目與已連結應用程式；小工具、垃圾桶、預覽及鍵盤切換則會在整個 Dock 間共用。"
          }
        }
      }
    },
