          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "実行中のすべてのアプリと、そのウインドウおよびアクションを一覧表示する列です。オフにするとパネルの幅が狭くなります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
