    "Wrap window previews into up to this many rows to keep the panel on screen. The panel scrolls sideways only when windows still do not fit." : {
      "comment" : "Settings control description",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Wrap window previews into up to this many rows to keep the panel on screen. The panel scrolls sideways only when windows still do not fit."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "توزيع معاينات النوافذ على هذا العدد من الصفوف كحد أقصى لإبقاء اللوحة على الشاشة. لا تُمرَّر اللوحة أفقيًا إلا عندما لا تتسع النوافذ رغم ذلك."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Wrap window previews into up to this many rows to keep the panel on screen. The panel scrolls sideways only when windows still do not fit."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Wrap window previews into up to this many rows to keep the panel on screen. The panel scrolls sideways only when windows still do not fit."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Wrap window previews into up to this many rows to keep the panel on screen. The panel scrolls sideways only when windows still do not fit."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fenstervorschauen auf bis zu so viele Zeilen umbrechen, damit das Panel auf dem Bildschirm bleibt. Das Panel scrollt nur dann seitlich, wenn die Fenster trotzdem nicht passen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Wrap window previews into up to this many rows to keep the panel on screen. The panel scrolls sideways only when windows still do not fit."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Distribuye las previsualizaciones de ventanas en hasta este número de filas para mantener el panel en pantalla. El panel solo se desplaza lateralmente cuando las ventanas siguen sin caber."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Wrap window previews into up to this many rows to keep the panel on screen. The panel scrolls sideways only when windows still do not fit."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Répartir les aperçus de fenêtres sur ce nombre maximal de rangées pour garder le panneau à l'écran. Le panneau ne défile horizontalement que si les fenêtres ne tiennent toujours pas."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Wrap window previews into up to this many rows to keep the panel on screen. The panel scrolls sideways only when windows still do not fit."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az ablak-előnézetek tördelése legfeljebb ennyi sorba, hogy a panel a képernyőn maradjon. A panel csak akkor görgethető oldalra, ha az ablakok így sem férnek el."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Wrap window previews into up to this many rows to keep the panel on screen. The panel scrolls sideways only when windows still do not fit."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "パネルが画面内に収まるように、ウインドウプレビューをこの行数まで折り返します。それでもウインドウが収まらない場合にのみ、パネルが横にスクロールします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Wrap window previews into up to this many rows to keep the panel on screen. The panel scrolls sideways only when windows still do not fit."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Wrap window previews into up to this many rows to keep the panel on screen. The panel scrolls sideways only when windows still do not fit."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verdeel venstervoorbeelden over maximaal dit aantal rijen, zodat het paneel op het scherm blijft. Het paneel scrolt alleen zijwaarts als de vensters dan nog steeds niet passen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Układaj podglądy okien w maksymalnie tylu wierszach, aby panel mieścił się na wyświetlaczu. Panel przewija się w poziomie tylko wtedy, gdy okna nadal się nie mieszczą."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Distribuir as pré-visualizações de janelas por um máximo deste número de linhas para manter o painel no ecrã. O painel só se desloca na horizontal quando as janelas continuam a não caber."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Wrap window previews into up to this many rows to keep the panel on screen. The panel scrolls sideways only when windows still do not fit."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Wrap window previews into up to this many rows to keep the panel on screen. The panel scrolls sideways only when windows still do not fit."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Переносить предпросмотр окон не более чем на указанное число рядов, чтобы панель помещалась на экране. Панель прокручивается вбок, только если окна все равно не помещаются."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Wrap window previews into up to this many rows to keep the panel on screen. The panel scrolls sideways only when windows still do not fit."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Radbryt fönsterförhandsvisningar till upp till så här många rader så att panelen stannar på skärmen. Panelen rullar bara i sidled när fönstren ändå inte får plats."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paneli ekranda tutmak için pencere önizlemelerini en fazla bu kadar satıra sar. Panel yalnızca pencereler hâlâ sığmadığında yana kayar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Wrap window previews into up to this many rows to keep the panel on screen. The panel scrolls sideways only when windows still do not fit."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xếp bản xem trước cửa sổ thành tối đa số hàng này để giữ bảng trong màn hình. Bảng chỉ cuộn ngang khi các cửa sổ vẫn không vừa."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将窗口预览分为不超过此数量的行，以确保面板保持在屏幕内。只有窗口仍无法容纳时，面板才会横向滚动。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "將視窗預覽自動換行，最多顯示此設定的列數，以避免面板超出螢幕範圍。只有在所有視窗仍無法容納時，面板才會啟用橫向捲動。"
          }
        }
      }
    },
