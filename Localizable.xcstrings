        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تطبيق الإنهاء عند إغلاق آخر نافذة على كل التطبيقات، أو التطبيقات المحددة فقط، أو كل التطبيقات باستثناء المحددة"
          }
        },
