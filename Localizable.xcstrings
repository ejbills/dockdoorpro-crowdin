          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Telepíts közösségi widgeteket közvetlenül a piactérről. A widgetek natívan futnak a Dockban. A widgetfrissítések teljes érvénybe lépéséhez előfordulhat, hogy újra kell indítani az alkalmazást."
          }
        },
