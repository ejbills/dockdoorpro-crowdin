          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Liquid Glass uses the macOS 26 glass effect. Frosted uses a blur material. Solid uses a full opacity color. Clear removes the background entirely."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liquid Glass использует стеклянный эффект macOS 26. В мазке используется размытый материал. Тщательный цвет с полной непрозрачностью. Степень очистки полностью убирает фон."
          }
        },
        "sr" : {
          "stringUnit" : {
