    "Open the Control Center from the profile button at the start of your dock, by long-pressing a Quick Actions widget, or with a keyboard shortcut. Type as soon as it opens to search your apps, windows and actions." : {
      "comment" : "Control Center overview note",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Open the Control Center from the profile button at the start of your dock, by long-pressing a Quick Actions widget, or with a keyboard shortcut. Type as soon as it opens to search your apps, windows and actions."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "افتح مركز التحكم من زر ملف التعريف في بداية Dock، أو بالضغط المطول على أداة «الإجراءات السريعة»، أو باختصار لوحة المفاتيح. ابدأ الكتابة فور فتحه للبحث في تطبيقاتك ونوافذك وإجراءاتك."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Open the Control Center from the profile button at the start of your dock, by long-pressing a Quick Actions widget, or with a keyboard shortcut. Type as soon as it opens to search your apps, windows and actions."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Open the Control Center from the profile button at the start of your dock, by long-pressing a Quick Actions widget, or with a keyboard shortcut. Type as soon as it opens to search your apps, windows and actions."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Open the Control Center from the profile button at the start of your dock, by long-pressing a Quick Actions widget, or with a keyboard shortcut. Type as soon as it opens to search your apps, windows and actions."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öffnen Sie das Kontrollzentrum über die Profilschaltfläche am Anfang Ihres Docks, durch langes Drücken auf ein Schnellaktionen-Widget oder mit einem Tastaturkurzbefehl. Beginnen Sie direkt nach dem Öffnen zu tippen, um Ihre Apps, Fenster und Aktionen zu durchsuchen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Open the Control Center from the profile button at the start of your dock, by long-pressing a Quick Actions widget, or with a keyboard shortcut. Type as soon as it opens to search your apps, windows and actions."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abre el Centro de control desde el botón de perfil al principio del Dock, manteniendo pulsado un widget Acciones rápidas o con un atajo de teclado. Escribe en cuanto se abra para buscar tus apps, ventanas y acciones."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Open the Control Center from the profile button at the start of your dock, by long-pressing a Quick Actions widget, or with a keyboard shortcut. Type as soon as it opens to search your apps, windows and actions."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ouvrez le Centre de contrôle depuis le bouton de profil au début de votre dock, par un appui long sur un widget Actions rapides, ou avec un raccourci clavier. Tapez dès son ouverture pour rechercher vos apps, fenêtres et actions."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Open the Control Center from the profile button at the start of your dock, by long-pressing a Quick Actions widget, or with a keyboard shortcut. Type as soon as it opens to search your apps, windows and actions."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nyissa meg a Vezérlőközpontot a Dock elején lévő profilgombbal, egy Gyorsműveletek widget hosszan nyomásával vagy billentyűparanccsal. A megnyitás után azonnal gépelhet az appok, ablakok és műveletek kereséséhez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Open the Control Center from the profile button at the start of your dock, by long-pressing a Quick Actions widget, or with a keyboard shortcut. Type as soon as it opens to search your apps, windows and actions."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コントロールセンターは、Dockの先頭にあるプロファイルボタン、「クイックアクション」ウィジェットの長押し、またはキーボードショートカットで開きます。開いたらすぐに入力して、アプリ、ウインドウ、アクションを検索できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Open the Control Center from the profile button at the start of your dock, by long-pressing a Quick Actions widget, or with a keyboard shortcut. Type as soon as it opens to search your apps, windows and actions."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Open the Control Center from the profile button at the start of your dock, by long-pressing a Quick Actions widget, or with a keyboard shortcut. Type as soon as it opens to search your apps, windows and actions."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open het Control Center met de profielknop aan het begin van je Dock, door lang op een widget 'Snelle acties' te drukken of met een sneltoets. Begin te typen zodra het opent om je apps, vensters en acties te doorzoeken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otwórz Centrum sterowania przyciskiem profilu na początku Docka, klikając i przytrzymując widżet Szybkie akcje lub używając skrótu klawiszowego. Zacznij pisać od razu po otwarciu, aby wyszukać aplikacje, okna i czynności."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abra a Central de controlo a partir do botão de perfil no início da Dock, mantendo premido um widget Ações Rápidas ou com um atalho de teclado. Comece a escrever assim que abrir para pesquisar apps, janelas e ações."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Open the Control Center from the profile button at the start of your dock, by long-pressing a Quick Actions widget, or with a keyboard shortcut. Type as soon as it opens to search your apps, windows and actions."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Open the Control Center from the profile button at the start of your dock, by long-pressing a Quick Actions widget, or with a keyboard shortcut. Type as soon as it opens to search your apps, windows and actions."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пункт управления открывается кнопкой профиля в начале Dock, долгим нажатием на виджет «Быстрые действия» или сочетанием клавиш. Начните вводить текст сразу после открытия, чтобы искать приложения, окна и действия."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Open the Control Center from the profile button at the start of your dock, by long-pressing a Quick Actions widget, or with a keyboard shortcut. Type as soon as it opens to search your apps, windows and actions."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öppna Kontrollcenter med profilknappen i början av dockan, genom att trycka länge på en Snabbåtgärder-widget eller med ett kortkommando. Börja skriva så fort det öppnas för att söka bland appar, fönster och åtgärder."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denetim Merkezi'ni dock'unun başındaki profil düğmesinden, bir Hızlı Eylemler widget'ına uzun basarak veya bir klavye kısayoluyla aç. Uygulamalarını, pencerelerini ve eylemlerini aramak için açılır açılmaz yaz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Open the Control Center from the profile button at the start of your dock, by long-pressing a Quick Actions widget, or with a keyboard shortcut. Type as soon as it opens to search your apps, windows and actions."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mở Trung tâm điều khiển từ nút hồ sơ ở đầu dock, bằng cách nhấn giữ tiện ích Tác vụ nhanh hoặc bằng phím tắt. Gõ ngay khi bảng mở ra để tìm kiếm ứng dụng, cửa sổ và tác vụ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通过 Dock 起始处的配置文件按钮、长按“快捷操作”小组件或使用键盘快捷键打开控制中心。打开后即可键入文字，搜索应用、窗口和操作。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你可以從 Dock 開頭的設定檔按鈕、長按「快速動作」小工具，或使用快速鍵開啟「控制中心」。開啟後直接輸入文字，即可搜尋應用程式、視窗和動作。"
          }
        }
      }
    },
