        },
        "nb" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Liquid Glass uses the macOS 26 glass effect. Frosted uses a blur material. Solid uses a full opacity color. Clear removes the background entirely."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liquid Glass gebruikt het glaseffect van macOS 26. Mat gebruikt een vervagingseffect. Effen gebruikt een volledig dekkende kleur. Transparant verwijdert de achtergrond volledig."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Styl Liquid Glass używa efektu szkła z macOS 26. Styl Matowy używa rozmycia. Styl Jednolity używa koloru o pełnym kryciu. Styl Przezroczysty całkowicie usuwa tło."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Liquid Glass uses the macOS 26 glass effect. Frosted uses a blur material. Solid uses a full opacity color. Clear removes the background entirely."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Liquid Glass uses the macOS 26 glass effect. Frosted uses a blur material. Solid uses a full opacity color. Clear removes the background entirely."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Liquid Glass uses the macOS 26 glass effect. Frosted uses a blur material. Solid uses a full opacity color. Clear removes the background entirely."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liquid Glass использует стеклянный эффект macOS 26. В мазке используется размытый материал. Тщательный цвет с полной непрозрачностью. Степень очистки полностью убирает фон."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Liquid Glass uses the macOS 26 glass effect. Frosted uses a blur material. Solid uses a full opacity color. Clear removes the background entirely."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Liquid Glass uses the macOS 26 glass effect. Frosted uses a blur material. Solid uses a full opacity color. Clear removes the background entirely."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Liquid Glass uses the macOS 26 glass effect. Frosted uses a blur material. Solid uses a full opacity color. Clear removes the background entirely."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Liquid Glass uses the macOS 26 glass effect. Frosted uses a blur material. Solid uses a full opacity color. Clear removes the background entirely."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liquid Glass sử dụng hiệu ứng kính của macOS 26. Chế độ Mờ sử dụng chất liệu làm mờ. Chế độ Màu đặc sử dụng một màu đục hoàn toàn. Chế độ Trong suốt sẽ loại bỏ hoàn toàn phần nền."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liquid Glass 使用 macOS 26 的液态玻璃效果。“磨砂” 使用磨砂模糊背景。“纯色” 使用完全不透明的纯色背景。“透明” 则完全移除背景。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liquid Glass 使用 macOS 26 的玻璃效果；霧面使用模糊材質；實心使用完全不透明顏色；透明則完全移除背景。"
          }
        }
      }
    },
