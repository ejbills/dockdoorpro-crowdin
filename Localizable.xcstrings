        "da" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Card mode shows a background behind running apps. Focused apps are highlighted, while hidden or minimized apps appear dimmed."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kartenmodus zeigt einen Hintergrund hinter laufenden Apps. Fokussierte Apps werden hervorgehoben, während versteckte oder minimierte Apps verdunkelt werden."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Card mode shows a background behind running apps. Focused apps are highlighted, while hidden or minimized apps appear dimmed."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Card mode shows a background behind running apps. Focused apps are highlighted, while hidden or minimized apps appear dimmed."
