          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ez nem jelent általános fájlkeresést vagy üzenetolvasást. Minden appot csak az Ön által választott widgethez vagy művelethez vezérel, és csak addig, amíg az a widget a Dockban van."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "This is not broad file scanning or message reading. Each app is controlled only for the widget or action you chose, and only while that widget is in your dock."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これはファイルの広範なスキャンやメッセージの読み取りではありません。各アプリは、選択したウィジェットまたはアクションのためだけに、そのウィジェットがDockにある間だけ制御されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "This is not broad file scanning or message reading. Each app is controlled only for the widget or action you chose, and only while that widget is in your dock."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "This is not broad file scanning or message reading. Each app is controlled only for the widget or action you chose, and only while that widget is in your dock."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dit is geen algemeen scannen van bestanden of lezen van berichten. Elke app wordt alleen bediend voor de widget of actie die je hebt gekozen, en alleen zolang die widget in je Dock staat."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie oznacza to ogólnego skanowania plików ani odczytywania wiadomości. Każda aplikacja jest sterowana wyłącznie na potrzeby wybranego widżetu lub czynności i tylko wtedy, gdy ten widżet znajduje się w Docku."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não se trata de uma análise geral de ficheiros nem de leitura de mensagens. Cada app só é controlada para o widget ou a ação que escolheu, e apenas enquanto esse widget estiver na Dock."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "This is not broad file scanning or message reading. Each app is controlled only for the widget or action you chose, and only while that widget is in your dock."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "This is not broad file scanning or message reading. Each app is controlled only for the widget or action you chose, and only while that widget is in your dock."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Это не сканирование всех файлов и не чтение сообщений. Каждое приложение управляется только для выбранного вами виджета или действия и только пока этот виджет находится в Dock."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "This is not broad file scanning or message reading. Each app is controlled only for the widget or action you chose, and only while that widget is in your dock."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det här innebär ingen bred filskanning eller läsning av meddelanden. Varje app styrs bara för den widget eller åtgärd du valt, och bara medan widgeten finns i dockan."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu, geniş kapsamlı dosya taraması veya mesaj okuma değildir. Her uygulama yalnızca seçtiğin widget veya eylem için ve yalnızca o widget dock'unda olduğu sürece denetlenir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "This is not broad file scanning or message reading. Each app is controlled only for the widget or action you chose, and only while that widget is in your dock."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đây không phải là quét tệp hay đọc tin nhắn trên diện rộng. Mỗi ứng dụng chỉ được điều khiển cho tiện ích hoặc tác vụ bạn đã chọn, và chỉ khi tiện ích đó nằm trong dock của bạn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此权限不会用于广泛扫描文件或读取信息。仅为您选择的小组件或操作控制相应应用，且仅在该小组件位于 Dock 中时生效。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這不會大範圍掃描檔案或讀取訊息。只有你所選擇的小工具或動作需要時，才會控制對應的應用程式，而且僅限該小工具位於 Dock 中時。"
          }
        }
      }
    },
