    "Want ⌘-Tab instead of %@-Tab? Change the Initializer Key above; these fields hold the trailing key (for example Tab), and the initializer modifier is added automatically." : {
      "comment" : "Window switcher initializer key guidance",
      "extractionState" : "manual",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Want ⌘-Tab instead of %@-Tab? Change the Initializer Key above; these fields hold the trailing key (for example Tab), and the initializer modifier is added automatically."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هل تريد ⌘-Tab بدلًا من %@-Tab؟ غيّر مفتاح التهيئة أعلاه؛ تحتفظ هذه الحقول بالمفتاح اللاحق (مثل Tab)، ويُضاف مفتاح التعديل الخاص بالتهيئة تلقائيًا."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Want ⌘-Tab instead of %@-Tab? Change the Initializer Key above; these fields hold the trailing key (for example Tab), and the initializer modifier is added automatically."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Want ⌘-Tab instead of %@-Tab? Change the Initializer Key above; these fields hold the trailing key (for example Tab), and the initializer modifier is added automatically."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Want ⌘-Tab instead of %@-Tab? Change the Initializer Key above; these fields hold the trailing key (for example Tab), and the initializer modifier is added automatically."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Möchten Sie ⌘-Tab statt %@-Tab verwenden? Ändern Sie oben die Auslösertaste; diese Felder enthalten die Folgetaste (z. B. Tab), und die Auslöser-Sondertaste wird automatisch hinzugefügt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Want ⌘-Tab instead of %@-Tab? Change the Initializer Key above; these fields hold the trailing key (for example Tab), and the initializer modifier is added automatically."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Quieres ⌘-Tab en lugar de %@-Tab? Cambia la Tecla inicializadora de arriba; estos campos contienen la tecla final (por ejemplo, Tab) y el modificador inicializador se añade automáticamente."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Want ⌘-Tab instead of %@-Tab? Change the Initializer Key above; these fields hold the trailing key (for example Tab), and the initializer modifier is added automatically."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envie de ⌘-Tab plutôt que %@-Tab ? Modifiez la Touche d'Initialisation ci-dessus ; ces champs contiennent la touche finale (par exemple Tab), et le modificateur d'initialisation est ajouté automatiquement."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Want ⌘-Tab instead of %@-Tab? Change the Initializer Key above; these fields hold the trailing key (for example Tab), and the initializer modifier is added automatically."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@-Tab helyett ⌘-Tab kombinációt szeretne? Módosítsa fent az Indítóbillentyűt; ezek a mezők a záró billentyűt tárolják (például Tab), az indító módosítóbillentyű pedig automatikusan hozzáadódik."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Want ⌘-Tab instead of %@-Tab? Change the Initializer Key above; these fields hold the trailing key (for example Tab), and the initializer modifier is added automatically."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@-Tabの代わりに⌘-Tabを使いますか？上の「イニシャライザーキー」を変更してください。これらのフィールドには後続のキー（たとえばTab）を設定し、イニシャライザーの修飾キーは自動的に追加されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Want ⌘-Tab instead of %@-Tab? Change the Initializer Key above; these fields hold the trailing key (for example Tab), and the initializer modifier is added automatically."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Want ⌘-Tab instead of %@-Tab? Change the Initializer Key above; these fields hold the trailing key (for example Tab), and the initializer modifier is added automatically."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wil je ⌘-Tab in plaats van %@-Tab? Pas dan de initialisatietoets hierboven aan; in deze velden staat de afsluitende toets (bijvoorbeeld Tab), en de initialisatie-modificatietoets wordt automatisch toegevoegd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wolisz ⌘-Tab zamiast %@-Tab? Zmień powyżej Klawisz inicjujący; te pola przechowują klawisz końcowy (na przykład Tab), a modyfikator inicjujący jest dodawany automatycznie."
          }
        },
        "pt" : {
