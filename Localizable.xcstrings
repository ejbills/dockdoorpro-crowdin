          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Электронная почта %@ для помощи с настройкой, активацией или проблемами DockDoor Pro. Включите ваш ключ активации в электронном письме; поддержка не может быть гарантирована без него."
          }
