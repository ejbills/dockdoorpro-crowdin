          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kortstorlek, opacitet, kontur, glans och appfärgston bakom symboler för appar som körs."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kart boyutu, opaklık, çerçeve kalınlığı, parıltı ve çalışan uygulama simgelerinin arkasındaki uygulama rengi tonu."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Card size, opacity, outline, glimmer, and app-color tint behind running app icons."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kích cỡ, độ mờ, viền, ánh lấp lánh và tông màu ứng dụng của thẻ phía sau biểu tượng ứng dụng đang chạy."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "运行中应用图标背景卡片的大小、不透明度、轮廓、微光效果和应用颜色着色。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "調整卡片大小、不透明度、外框、微光效果，以及執行中應用程式圖示後方的應用程式色彩色調。"
          }
        }
      }
    },
